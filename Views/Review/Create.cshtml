@model MoneyTransfer.ViewModels.ReviewViewModel
@{
    ViewData["Title"] = "Write a Review";
    ViewBag.PageClass = "page-reviews";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="page-header">
            <div>
                <h2>Write a Review</h2>
                <p>Share your experience with CedarPay</p>
            </div>
            <a asp-action="MyReviews" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> My Reviews
            </a>
        </div>

        @if (ViewBag.LastReviewDate != null)
        {
            <div class="review-last-alert">
                <i class="bi bi-info-circle-fill"></i>
                Your last review from
                <strong>@ViewBag.LastReviewDate</strong>
                is shown below. Submit to add a new one.
            </div>
        }

        <!-- Display what the user is reviewing -->
        <div class="tp-card mb-3" style="background: var(--surface-2);">
            <div class="reviewing-info">
                <i class="bi bi-info-circle-fill" style="color: var(--teal);"></i>
                You are reviewing:
                <strong>
                    @if (Model.Target == "Agent" && ViewBag.AgentInfo != null)
                    {
                        @($"{ViewBag.AgentInfo.StoreName} (Agent)")
                    }
                    else if (Model.Target == "Transaction" && ViewBag.TransactionInfo != null)
                    {
                        @($"Transaction #{ViewBag.TransactionInfo.SerialNumber}")
                    }
                    else
                    {
                        @("CedarPay App")
                    }
                </strong>
            </div>
        </div>

        <div class="tp-card">
            <form asp-controller="Review" asp-action="Store" method="post" class="tp-form">
                @Html.AntiForgeryToken()

                <!-- Hidden fields for IDs -->
                <input type="hidden" name="AgentId" value="@Model.AgentId" />
                <input type="hidden" name="TransactionId" value="@Model.TransactionId" />
                <input type="hidden" name="Target" value="@Model.Target" />
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="form-group">
                    <label class="form-label">Your Rating</label>
                    <div class="review-star-rating" id="starRating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span data-val="@i" onclick="setRating(@i)" class="review-star @(i <= Model.Rating ? "filled" : "empty")">★</span>
                        }
                    </div>
                    <input type="hidden" name="Rating" id="ratingInput" value="@Model.Rating" />
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Rating"]?.Errors.Any() == true)
                    {
                        <span class="review-rating-error">Please select a rating.</span>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">Comment (Optional)</label>
                    <textarea name="Comment" class="form-control review-textarea" rows="4" placeholder="Tell us what you think...">@Model.Comment</textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-tp-primary">
                        <i class="bi bi-star-fill"></i> Submit Review
                    </button>
                    <a asp-action="MyReviews" class="btn-tp-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setRating(val) {
            document.getElementById('ratingInput').value = val;
            document.querySelectorAll('#starRating .review-star').forEach((s, i) => {
                s.classList.toggle('filled', i < val);
                s.classList.toggle('empty', i >= val);
            });
        }
    </script>
}