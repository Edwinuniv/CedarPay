@model List<MoneyTransfer.ViewModels.ReviewViewModel>
@{
    ViewData["Title"] = "Reviews";
    ViewBag.PageClass = "page-reviews";
    var avg = ViewBag.AverageRating as double? ?? 0;
}

<div class="page-header">
    <div>
        <h2>Reviews</h2>
        <p>What users say about CedarPay</p>
    </div>
    <a asp-action="Create" class="btn-tp-primary">
        <i class="bi bi-star"></i> Write a Review
    </a>
</div>

<div class="tp-card mb-3">
    <div class="reviews-average-container">
        <div class="reviews-average-score">@avg.ToString("F1")</div>
        <div class="reviews-average-stars">
            @for (int i = 1; i <= 5; i++)
            {
                <span>@(i <= avg ? "★" : "☆")</span>
            }
        </div>
        <div class="reviews-average-count">
            Based on @Model.Count review@(Model.Count != 1 ? "s" : "")
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-star"></i>
            <p>Be the first to review CedarPay!</p>
            <a asp-action="Create" class="btn-tp-primary">Write a Review</a>
        </div>
    </div>
}
else
{
    <div class="reviews-container">
        @foreach (var r in Model)
        {
            <div class="tp-card review-card">
                <div class="review-header">
                    <div class="ben-avatar review-avatar">
                        @r.UserName.Substring(0, 1).ToUpper()
                    </div>
                    <div class="review-content">
                        <div class="review-header-row">
                            <div class="review-user-name">@r.UserName</div>
                            <div class="review-date">@r.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="review-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span>@(i <= r.Rating ? "★" : "☆")</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(r.Comment))
                        {
                            <div class="review-comment">@r.Comment</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}