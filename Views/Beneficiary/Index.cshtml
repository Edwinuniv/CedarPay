@model List<MoneyTransfer.ViewModels.BeneficiaryViewModel>
@{
    ViewData["Title"] = "Beneficiaries";
    ViewBag.PageClass = "page-beneficiary";
}

<div class="page-header">
    <div>
        <h2>Beneficiaries</h2>
        <p>Your saved recipients</p>
    </div>
    <a asp-action="Create" class="btn-tp-primary">
        <i class="bi bi-person-plus"></i> Add Beneficiary
    </a>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <p>No beneficiaries yet. Add someone to send money faster!</p>
            <a asp-action="Create" class="btn-tp-primary">
                <i class="bi bi-person-plus"></i> Add Beneficiary
            </a>
        </div>
    </div>
}
else
{
    <div class="tp-card">
        <table class="tp-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Wallet / Phone</th>
                    <th>Country</th>
                    <th>Added</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>
                            <div class="beneficiary-user-info">
                                <div class="ben-avatar beneficiary-avatar-small">
                                    @b.Nickname.Substring(0, 1).ToUpper()
                                </div>
                                <div class="beneficiary-details">
                                    <div class="beneficiary-nickname">@b.Nickname</div>
                                    <div class="beneficiary-name">@b.ReceiverName</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge-tp @(b.TransferType == "WalletTransfer" ? "info" : "default")">
                                @b.TransferType
                            </span>
                        </td>
                        <td class="beneficiary-identifier">
                            @(b.ReceiverWalletSerial ?? b.ReceiverPhoneNumber ?? "—")
                        </td>
                        <td class="beneficiary-country">
                            @(b.ReceiverCountry ?? "—")
                        </td>
                        <td class="beneficiary-date">
                            @b.CreatedAt.ToString("MMM dd, yyyy")
                        </td>
                        <td>
                            <div class="beneficiary-actions">
                                <a asp-controller="Transfer" asp-action="Create" class="ben-action">Send</a>
                                <a asp-action="Edit" asp-route-id="@b.Id" class="btn-tp-secondary beneficiary-edit-btn">
                                    Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@b.Id" method="post" style="display:inline">
                                    <button type="submit" class="btn-tp-danger beneficiary-delete-btn"
                                            onclick="return confirm('Remove this beneficiary?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}