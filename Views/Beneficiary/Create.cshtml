@model MoneyTransfer.ViewModels.BeneficiaryViewModel
@{
    ViewData["Title"] = "Add Beneficiary";
    ViewBag.PageClass = "page-beneficiary";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="page-header">
            <div>
                <h2>Add Beneficiary</h2>
                <p>Save a contact for quick transfers</p>
            </div>
        </div>

        <div class="tp-card mb-3">
            <div class="method-selector-header">
                How would you like to add?
            </div>
            <div class="method-selector-grid">
                <div onclick="switchMethod('username')" id="btnUsername" class="method-option active">
                    <i class="bi bi-at method-icon active"></i>
                    <div class="method-title">Search by Username</div>
                    <div class="method-desc">@@userName</div>
                </div>
                <div onclick="switchMethod('wallet')" id="btnWallet" class="method-option">
                    <i class="bi bi-wallet2 method-icon inactive"></i>
                    <div class="method-title">Enter Wallet Serial</div>
                    <div class="method-desc">WAL-2026-XXXXX</div>
                </div>
            </div>
        </div>

        <div id="usernameMethod">
            <div class="tp-card mb-3">
                <div class="form-group">
                    <label class="form-label">Search by Username</label>
                    <div class="username-search-wrapper">
                        <span class="username-search-prefix">@@</span>
                        <input type="text"
                               id="usernameInput"
                               placeholder="username"
                               oninput="searchUsername(this.value)"
                               class="username-search-input" />
                    </div>
                </div>

                <div id="userSearchResults" class="search-results-container"></div>
            </div>
        </div>

        <div id="walletMethod" style="display:none">
            <div class="tp-card">
                <form asp-action="Store" method="post" class="tp-form">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="form-label">Nickname</label>
                        <input asp-for="Nickname" class="form-control" placeholder="e.g. Mom, John" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Full Name</label>
                        <input asp-for="ReceiverName" class="form-control" placeholder="Receiver's full name" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Transfer Type</label>
                        <select asp-for="TransferType" class="form-select">
                            <option value="WalletTransfer">Wallet Transfer</option>
                            <option value="MobileTransfer">Mobile Transfer</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Wallet Serial</label>
                        <input asp-for="ReceiverWalletSerial" class="form-control" placeholder="WAL-2026-XXXXX" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Phone (for Mobile Transfer)</label>
                        <input asp-for="ReceiverPhoneNumber" class="form-control" placeholder="+961 XX XXX XXX" />
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="form-label">Country</label>
                                <input asp-for="ReceiverCountry" class="form-control" placeholder="Lebanon" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="form-label">City</label>
                                <input asp-for="ReceiverCity" class="form-control" placeholder="Beirut" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-tp-primary">
                            <i class="bi bi-person-plus"></i> Add Beneficiary
                        </button>
                        <a asp-action="Index" class="btn-tp-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function switchMethod(method) {
            const uM = document.getElementById('usernameMethod');
            const wM = document.getElementById('walletMethod');
            const bU = document.getElementById('btnUsername');
            const bW = document.getElementById('btnWallet');

            if (method === 'username') {
                uM.style.display = 'block';
                wM.style.display = 'none';
                bU.classList.add('active');
                bW.classList.remove('active');
            } else {
                uM.style.display = 'none';
                wM.style.display = 'block';
                bW.classList.add('active');
                bU.classList.remove('active');
            }
        }

        let searchTimer;
        function searchUsername(q) {
            clearTimeout(searchTimer);
            const results = document.getElementById('userSearchResults');

            if (q.length < 2) {
                results.style.display = 'none';
                return;
            }

            searchTimer = setTimeout(() => {
                fetch('/Beneficiary/SearchUsers?username=' + encodeURIComponent(q))
                    .then(r => r.json())
                    .then(users => {
                        if (!users.length) {
                            results.innerHTML = '<div class="search-error-message">' +
                                'No user found with @@' + q + '</div>';
                        } else {
                            results.innerHTML = users.map(u =>
                                `<div onclick='selectUser(${JSON.stringify(u)})' class="search-result-item">
                                    <div class="search-result-avatar">${u.initials}</div>
                                    <div class="search-result-info">
                                        <div class="search-result-name">${u.name}</div>
                                        <div class="search-result-username">@@${u.userName}</div>
                                    </div>
                                </div>`
                            ).join('');
                        }
                        results.style.display = 'block';
                    })
                    .catch(() => {
                        results.innerHTML = '<div class="search-error-message error">' +
                            'Search error. Try again.</div>';
                        results.style.display = 'block';
                    });
            }, 300);
        }

        function selectUser(user) {
            switchMethod('wallet');
            const nickInput = document.querySelector('[name="Nickname"]');
            const nameInput = document.querySelector('[name="ReceiverName"]');
            const walletInput = document.querySelector('[name="ReceiverWalletSerial"]');

            if (nickInput) nickInput.value = user.userName;
            if (nameInput) nameInput.value = user.name;
            if (walletInput && user.walletSerial) walletInput.value = user.walletSerial;
        }
    </script>
}