@model MoneyTransfer.Models.ReferralCode
@{
    ViewData["Title"] = "Referral Program";
    ViewBag.PageClass = "page-settings";
    var shareUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Identity/Account/Register?ref={Model.Code}";
}

<div class="page-header">
    <div>
        <h2>Referral Program</h2>
        <p>Invite friends, grow together</p>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon beneficiaries"><i class="bi bi-people-fill"></i></div>
            <div class="stat-value">@Model.UsageCount</div>
            <div class="stat-label">Friends Referred</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon received"><i class="bi bi-check-circle-fill"></i></div>
            <div class="stat-value">@Model.Uses.Count</div>
            <div class="stat-label">Joined via Your Link</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon beneficiaries"><i class="bi bi-calendar"></i></div>
            <div class="stat-value" style="font-size:16px">@Model.CreatedAt.ToString("MMM yyyy")</div>
            <div class="stat-label">Code Created</div>
        </div>
    </div>
</div>

<div class="tp-card mb-3">
    <div class="tp-card-header">
        <span class="tp-card-title"><i class="bi bi-gift"></i> Your Referral Code</span>
    </div>
    <div style="padding:28px;text-align:center">
        <div style="font-size:36px;font-weight:800;letter-spacing:8px;color:var(--teal);font-family:monospace;margin-bottom:16px">
            @Model.Code
        </div>
        <p style="color:var(--text-2);margin-bottom:20px">Share this code or link — when a friend registers using it, they get a welcome bonus and so do you.</p>

        <div style="background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:12px 16px;display:flex;align-items:center;gap:10px;margin-bottom:20px;max-width:480px;margin-left:auto;margin-right:auto">
            <span id="shareUrlText" style="flex:1;font-size:12px;color:var(--text-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:left">@shareUrl</span>
            <button onclick="copyLink()" id="copyBtn" class="btn-tp-secondary" style="font-size:12px;padding:5px 12px;flex-shrink:0">
                <i class="bi bi-clipboard"></i> Copy
            </button>
        </div>

        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
            <button onclick="shareLink()" class="btn-tp-primary">
                <i class="bi bi-share"></i> Share Link
            </button>
            <form asp-action="Regenerate" method="post" style="margin:0"
                  onsubmit="return confirm('Generate a new code? Your current code will stop working.')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-tp-secondary">
                    <i class="bi bi-arrow-clockwise"></i> New Code
                </button>
            </form>
        </div>
    </div>
</div>

@if (Model.Uses.Any())
{
    <div class="tp-card">
        <div class="tp-card-header">
            <span class="tp-card-title"><i class="bi bi-people"></i> Friends Who Joined</span>
            <span class="badge-tp success">@Model.Uses.Count</span>
        </div>
        <div style="padding:0 4px 4px">
            @foreach (var use in Model.Uses.OrderByDescending(u => u.UsedAt))
            {
                <div style="display:flex;align-items:center;gap:12px;padding:12px 20px;border-bottom:1px solid var(--border)">
                    <div style="width:36px;height:36px;border-radius:50%;background:var(--teal-light);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--teal-dark);font-size:14px">
                        @(use.ReferredUser?.FirstName?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <div style="flex:1">
                        <div style="font-weight:600;font-size:14px">@use.ReferredUser?.FirstName @use.ReferredUser?.LastName</div>
                        <div style="font-size:11px;color:var(--text-3)">Joined @use.UsedAt.ToString("MMM dd, yyyy")</div>
                    </div>
                    <span class="badge-tp success" style="font-size:10px">Joined ✓</span>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        var shareUrl = '@shareUrl';
        var code = '@Model.Code';

        function copyLink() {
            navigator.clipboard.writeText(shareUrl).then(function() {
                var btn = document.getElementById('copyBtn');
                btn.innerHTML = '<i class="bi bi-check-lg"></i> Copied!';
                setTimeout(function() { btn.innerHTML = '<i class="bi bi-clipboard"></i> Copy'; }, 2000);
            });
        }

        function shareLink() {
            if (navigator.share) {
                navigator.share({
                    title: 'Join CedarPay!',
                    text: 'Use my referral code ' + code + ' when signing up on CedarPay!',
                    url: shareUrl
                }).catch(function() {});
            } else {
                copyLink();
            }
        }
    </script>
}
