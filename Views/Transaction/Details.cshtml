@model MoneyTransfer.ViewModels.TransactionViewModel
@{
    ViewData["Title"] = "Transaction Details";
    ViewBag.PageClass = "page-transactions";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="page-header">
            <div>
                <h2>Transaction Details</h2>
                <p class="tx-details-serial">
                    @Model.SerialNumber
                </p>
            </div>
            <a asp-action="Index" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <div class="tp-card">
            <div class="tx-details-amount-section">
                <div class="tx-avatar @(Model.IsSent ? "sent" : "received") tx-details-avatar @(!string.IsNullOrEmpty(Model.OtherPartyPictureUrl) ? "tx-avatar-with-img" : "")">
                    @if (!string.IsNullOrEmpty(Model.OtherPartyPictureUrl))
                    {
                        <img src="@Model.OtherPartyPictureUrl" class="tx-details-avatar-img" />
                    }
                    else
                    {
                        @Model.OtherPartyInitials
                    }
                </div>
                <div class="tx-details-party-name">
                    @(Model.IsSent ? "Sent to" : "Received from")
                    @Model.OtherPartyName
                </div>
                <div class="tx-details-amount-large tx-amount @(Model.IsSent ? "sent" : "received")">
                    @(Model.IsSent ? "−" : "+")@Model.CurrencySymbol@Model.Amount.ToString("N2")
                </div>
                <div class="tx-details-status-wrapper">
                    <span class="tx-status @Model.Status.ToLower() tx-details-status-badge">
                        @Model.Status
                    </span>
                    @if (Model.FeeWaived)
                    {
                        <span class="badge-tp success">
                            Fee Waived 🎉
                        </span>
                    }
                </div>
            </div>

            <div class="tx-details-grid">
                <div class="tx-details-info-section">
                    <div class="tx-details-label">From</div>
                    <div class="tx-details-value">@Model.SenderName</div>
                    <div class="tx-details-sub">@Model.SenderWalletSerial</div>
                </div>
                <div class="tx-details-info-section">
                    <div class="tx-details-label">To</div>
                    <div class="tx-details-value">@Model.ReceiverName</div>
                    <div class="tx-details-sub">@Model.ReceiverWalletSerial</div>
                </div>
                <div class="tx-details-info-section">
                    <div class="tx-details-label">Amount Sent</div>
                    <div class="tx-details-value">$@Model.Amount.ToString("N2") @Model.SenderCurrency</div>
                </div>
                <div class="tx-details-info-section">
                    <div class="tx-details-label">Amount Received</div>
                    <div class="tx-details-value">
                        @(Model.ConvertedAmount > 0 ? Model.ConvertedAmount.ToString("N2") : Model.Amount.ToString("N2"))
                        @Model.ReceiverCurrency
                    </div>
                </div>
                <div class="tx-details-info-section">
                    <div class="tx-details-label">Fee</div>
                    <div class="tx-details-value">
                        @if (Model.FeeWaived)
                        {
                            <span class="tx-details-free-fee">Free 🎉</span>
                        }
                        else
                        {
                            <span>$@Model.FeeAmount.ToString("N2")</span>
                        }
                    </div>
                </div>
                <div class="tx-details-info-section">
                    <div class="tx-details-label">Exchange Rate</div>
                    <div class="tx-details-value">@Model.ExchangeRateUsed.ToString("N4")</div>
                </div>
                <div class="tx-details-info-section">
                    <div class="tx-details-label">Type</div>
                    <div class="tx-details-value-normal">
                        <span class="badge-tp default">@Model.Type</span>
                    </div>
                </div>
                <div class="tx-details-info-section">
                    <div class="tx-details-label">Date</div>
                    <div class="tx-details-value">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="tx-details-note">
                    <strong>Note:</strong> @Model.Description
                </div>
            }
        </div>

        @if (Model.Status == "Completed" && Model.IsSent)
        {
            <div class="tp-card mt-3 tx-details-review-box">
                <div class="tx-details-review-content">
                    <span class="tx-details-review-icon">⭐</span>
                    <div class="tx-details-review-text">
                        <div class="tx-details-review-title">How was this transfer?</div>
                        <div class="tx-details-review-subtitle">Rate your experience</div>
                    </div>
                    <a asp-controller="Review"
                       asp-action="Create"
                       asp-route-transactionId="@Model.Id"
                       class="btn-tp-primary tx-details-review-btn">
                        Rate This Transfer
                    </a>
                </div>
            </div>
        }
    </div>
</div>