@model MoneyTransfer.ViewModels.TransactionViewModel
@{
    ViewData["Title"] = "Transaction Receipt";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>CedarPay Receipt — @Model.SerialNumber</title>
    <link rel="stylesheet" href="~/css/transferpay.css" asp-append-version="true" />
</head>
<body class="receipt-body">
    <div class="receipt-header">
        <div class="receipt-brand">Cedar<span>Pay</span></div>
        <div class="receipt-subtitle">Official Transaction Receipt</div>
    </div>

    <div class="receipt-amount @(Model.IsSent ? "receipt-amount-sent" : "receipt-amount-received")">
        @(Model.IsSent ? "−" : "+")@Model.CurrencySymbol@Model.Amount.ToString("N2")
    </div>

    <div class="receipt-status">
        <span class="receipt-status-badge">@Model.Status</span>
        @if (Model.FeeWaived)
        {
            <span class="receipt-status-badge receipt-fee-waived-badge">
                Fee Waived 🎉
            </span>
        }
    </div>

    <div class="receipt-row">
        <span class="receipt-label">Transaction ID</span>
        <span class="receipt-value receipt-mono">@Model.SerialNumber</span>
    </div>
    <div class="receipt-row">
        <span class="receipt-label">Date</span>
        <span class="receipt-value">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
    </div>
    <div class="receipt-row">
        <span class="receipt-label">Type</span>
        <span class="receipt-value">@Model.Type</span>
    </div>
    <div class="receipt-row">
        <span class="receipt-label">From</span>
        <span class="receipt-value">@Model.SenderName</span>
    </div>
    <div class="receipt-row">
        <span class="receipt-label">From Wallet</span>
        <span class="receipt-value receipt-mono">@Model.SenderWalletSerial</span>
    </div>
    <div class="receipt-row">
        <span class="receipt-label">To</span>
        <span class="receipt-value">@Model.ReceiverName</span>
    </div>
    <div class="receipt-row">
        <span class="receipt-label">To Wallet</span>
        <span class="receipt-value receipt-mono">@Model.ReceiverWalletSerial</span>
    </div>
    <div class="receipt-row">
        <span class="receipt-label">Amount Sent</span>
        <span class="receipt-value">@Model.CurrencySymbol@Model.Amount.ToString("N2") @Model.SenderCurrency</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.ReceiverCurrency) && Model.SenderCurrency != Model.ReceiverCurrency)
    {
        <div class="receipt-row">
            <span class="receipt-label">Amount Received</span>
            <span class="receipt-value">@Model.ConvertedAmount.ToString("N2") @Model.ReceiverCurrency</span>
        </div>
        <div class="receipt-row">
            <span class="receipt-label">Exchange Rate</span>
            <span class="receipt-value">1 @Model.SenderCurrency = @Model.ExchangeRateUsed.ToString("N4") @Model.ReceiverCurrency</span>
        </div>
    }

    <div class="receipt-row">
        <span class="receipt-label">Transaction Fee</span>
        <span class="receipt-value">@(Model.FeeWaived ? "Free 🎉" : "$" + Model.FeeAmount.ToString("N2"))</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div class="receipt-row">
            <span class="receipt-label">Note</span>
            <span class="receipt-value">@Model.Description</span>
        </div>
    }

    <div class="receipt-footer">
        <p>CedarPay — Licensed by Banque du Liban</p>
        <p>This is an official receipt for your records.</p>
        <p>For support: support@cedarpay.lb</p>
    </div>

    <div class="receipt-print-buttons">
        <button class="receipt-btn" onclick="window.print()">🖨️ Print Receipt</button>
        <a href="/Transaction/Details/@Model.Id" class="receipt-btn receipt-btn-secondary">← Back</a>
    </div>
</body>
</html>