@{
    ViewData["Title"] = "Cash Out";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="page-header">
            <div>
                <h2>Cash Out</h2>
                <p>Process a cash withdrawal for a user</p>
            </div>
        </div>

        <div class="tp-card">
            <form asp-action="CashOut" method="post"
                  class="tp-form">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">
                        User's Wallet Serial
                    </label>
                    <input type="text" name="walletSerial"
                           class="form-control"
                           placeholder="WAL-2026-XXXXX"
                           required />
                </div>

                <div class="form-group">
                    <label class="form-label">Amount</label>
                    <input type="number" name="amount"
                           class="form-control"
                           step="0.01" min="0.01"
                           placeholder="0.00" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Note (Optional)</label>
                    <input type="text" name="note"
                           class="form-control"
                           placeholder="Withdrawal note" />
                </div>

                <div style="background:var(--red-light);
                            border-radius:var(--r-sm);
                            padding:12px 16px;
                            font-size:13px;color:var(--red)">
                    <i class="bi bi-exclamation-triangle"></i>
                    Verify the user's identity before
                    processing a cash withdrawal.
                    This action cannot be undone.
                </div>

                <button type="submit" class="btn-tp-danger"
                        style="padding:13px 24px;
                               font-size:14px;font-weight:600">
                    <i class="bi bi-cash-stack"></i>
                    Process Cash Withdrawal
                </button>
            </form>
        </div>
    </div>
</div>