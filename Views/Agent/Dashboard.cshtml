@{
    ViewData["Title"] = "Agent Dashboard";
    ViewBag.PageClass = "page-agent";
    var agent = ViewBag.Agent as MoneyTransfer.Models.Agent;
    var agents = ViewBag.Agents as List<MoneyTransfer.Models.Agent> ?? new List<MoneyTransfer.Models.Agent>();
    var recentCashIn = ViewBag.RecentCashIn as List<MoneyTransfer.Models.TopUp> ?? new List<MoneyTransfer.Models.TopUp>();
}

<style>
    .agent-dashboard-header {
        margin-bottom: 24px;
    }

    .agent-dashboard-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .agent-dashboard-store-name {
        font-size: 16px;
        background: var(--bg-2);
        padding: 4px 12px;
        border-radius: 20px;
        color: var(--teal);
        font-weight: normal;
    }

    .agent-dashboard-subtitle {
        color: var(--text-3);
        font-size: 14px;
    }

    .stat-card {
        background: var(--bg-1);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            border-color: var(--cedar-gold);
            transform: translateY(-2px);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

        .stat-icon.received {
            background: rgba(0, 184, 148, 0.1);
            color: #00b894;
        }

        .stat-icon.sent {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

        .stat-icon.beneficiaries {
            background: rgba(108, 99, 255, 0.1);
            color: #6c63ff;
        }

    .stat-info {
        flex: 1;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-1);
    }

    .stat-label {
        font-size: 13px;
        color: var(--text-3);
        margin-top: 4px;
    }

    .agent-action-card {
        text-decoration: none;
        display: block;
        transition: all 0.3s ease;
    }

        .agent-action-card:hover {
            transform: translateY(-2px);
            border-color: var(--cedar-gold);
        }

    .agent-action-content {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .agent-action-icon {
        margin-bottom: 0;
    }

    .agent-action-title {
        font-weight: 600;
        color: var(--text-1);
    }

    .agent-action-desc {
        font-size: 12px;
        color: var(--text-3);
        margin-top: 2px;
    }

    .agent-action-chevron {
        margin-left: auto;
        color: var(--text-3);
    }

    .store-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
        margin: 20px 0;
    }

    .store-info-label {
        font-size: 12px;
        color: var(--text-3);
        display: block;
        margin-bottom: 4px;
    }

    .store-info-value {
        font-size: 14px;
        color: var(--text-1);
    }

    .store-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
    }

    .recent-transactions {
        margin-top: 20px;
    }

    .recent-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        border-bottom: 1px solid var(--border);
    }

        .recent-item:last-child {
            border-bottom: none;
        }

    .recent-amount {
        font-weight: 600;
        color: #00b894;
    }

    .recent-date {
        font-size: 12px;
        color: var(--text-3);
    }

    .store-selector-card {
        padding: 16px;
        background: var(--bg-2);
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .store-selector-content {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .store-selector-label {
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .store-selector-form {
        display: flex;
        gap: 8px;
        flex: 1;
    }

    .store-selector-select {
        flex: 1;
    }

    .dashboard-chart {
        margin-top: 20px;
    }
</style>

<div class="agent-dashboard-header">
    <h2 class="agent-dashboard-title">
        Agent Dashboard
        @if (agent != null)
        {
            <span class="agent-dashboard-store-name">@agent.StoreName</span>
        }
    </h2>
    <p class="agent-dashboard-subtitle">
        Manage your store and track performance
    </p>
</div>

@if (agents.Count > 1)
{
    <div class="store-selector-card">
        <div class="store-selector-content">
            <div class="store-selector-label">
                <i class="bi bi-shop"></i> Active Store
            </div>
            <form asp-action="SelectStore" method="post" class="store-selector-form">
                @Html.AntiForgeryToken()
                <select name="agentId" class="form-select store-selector-select">
                    @foreach (var a in agents)
                    {
                        if (agent?.Id == a.Id)
                        {
                            <option value="@a.Id" selected>@a.StoreName (@a.City)</option>
                        }
                        else
                        {
                            <option value="@a.Id">@a.StoreName (@a.City)</option>
                        }
                    }
                </select>
                <button type="submit" class="btn-tp-primary store-selector-btn">Switch</button>
            </form>
        </div>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon received"><i class="bi bi-cash-coin"></i></div>
            <div class="stat-info">
                <div class="stat-value">$@((ViewBag.TotalCashIn as decimal? ?? 0).ToString("N2"))</div>
                <div class="stat-label">Total Cash In (All Time)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon beneficiaries"><i class="bi bi-percent"></i></div>
            <div class="stat-info">
                <div class="stat-value">$@((ViewBag.TotalCommissions as decimal? ?? 0).ToString("N2"))</div>
                <div class="stat-label">Total Commissions</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon received"><i class="bi bi-geo-alt-fill"></i></div>
            <div class="stat-info">
                <div class="stat-value">@(agent != null && agent.Latitude != 0 ? "📍 Set" : "❌ Not Set")</div>
                <div class="stat-label">Map Location</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon beneficiaries"><i class="bi bi-shop"></i></div>
            <div class="stat-info">
                <div class="stat-value">@agents.Count</div>
                <div class="stat-label">Active Stores</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-action="CashIn" class="tp-card agent-action-card">
            <div class="agent-action-content">
                <div class="stat-icon received agent-action-icon"><i class="bi bi-cash-coin"></i></div>
                <div><div class="agent-action-title">Cash In</div><div class="agent-action-desc">Add cash to wallet</div></div>
                <i class="bi bi-chevron-right agent-action-chevron"></i>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="CashOut" class="tp-card agent-action-card">
            <div class="agent-action-content">
                <div class="stat-icon sent agent-action-icon"><i class="bi bi-cash-stack"></i></div>
                <div><div class="agent-action-title">Cash Out</div><div class="agent-action-desc">Process withdrawal</div></div>
                <i class="bi bi-chevron-right agent-action-chevron"></i>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="Commissions" class="tp-card agent-action-card">
            <div class="agent-action-content">
                <div class="stat-icon beneficiaries agent-action-icon"><i class="bi bi-percent"></i></div>
                <div><div class="agent-action-title">Commissions</div><div class="agent-action-desc">View earnings</div></div>
                <i class="bi bi-chevron-right agent-action-chevron"></i>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="CashHistory" class="tp-card agent-action-card">
            <div class="agent-action-content">
                <div class="stat-icon received agent-action-icon"><i class="bi bi-clock-history"></i></div>
                <div><div class="agent-action-title">Cash History</div><div class="agent-action-desc">View all transactions</div></div>
                <i class="bi bi-chevron-right agent-action-chevron"></i>
            </div>
        </a>
    </div>
</div>

@if (agent != null)
{
    <div class="tp-card mb-3">
        <div class="tp-card-header">
            <span class="tp-card-title"><i class="bi bi-shop" style="color:var(--teal); margin-right:6px"></i>Store Information</span>
            @{
                string statusClass = agent.Status == AgentStatus.Approved ? "success" : agent.Status == AgentStatus.Pending ? "warning" : "danger";
            }
            <span class="badge-tp @statusClass">@agent.Status</span>
        </div>
        <div class="store-info-grid">
            <div><span class="store-info-label">Store:</span><strong class="store-info-value">@agent.StoreName</strong></div>
            <div><span class="store-info-label">Agent:</span><strong class="store-info-value">@agent.AgentName</strong></div>
            <div><span class="store-info-label">Phone:</span><strong class="store-info-value">@agent.PhoneNumber</strong></div>
            <div><span class="store-info-label">Location:</span><strong class="store-info-value">@agent.City, @agent.Country</strong></div>
            <div><span class="store-info-label">Hours:</span><strong class="store-info-value">@(agent.WorkingHours ?? "Not set")</strong></div>
            <div><span class="store-info-label">Commission:</span><strong class="store-info-value">@((agent.CommissionRate * 100).ToString("F1"))%</strong></div>
        </div>
        <div class="store-actions">
            <a asp-action="SetLocation" asp-route-id="@agent.Id" class="btn-tp-primary"><i class="bi bi-geo-alt-fill"></i> Set Location</a>
            <a asp-action="EditStore" asp-route-id="@agent.Id" class="btn-tp-secondary"><i class="bi bi-pencil-fill"></i> Edit Store</a>
            <a asp-action="Register" class="btn-tp-secondary"><i class="bi bi-plus-lg"></i> New Store</a>
        </div>
    </div>
}

@if (recentCashIn.Any())
{
    <div class="tp-card">
        <div class="tp-card-header">
            <span class="tp-card-title"><i class="bi bi-clock-history"></i> Recent Cash Transactions</span>
            <a asp-action="CashHistory" class="tp-card-link">View All →</a>
        </div>
        <div class="recent-transactions">
            @foreach (var tx in recentCashIn.Take(5))
            {
                <div class="recent-item">
                    <div>
                        <div class="fw-bold">@tx.Wallet?.User?.FirstName @tx.Wallet?.User?.LastName</div>
                        <div class="recent-date">@tx.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                    <div class="recent-amount">+ @tx.Wallet?.Currency?.Symbol@tx.Amount.ToString("N2")</div>
                </div>
            }
        </div>
    </div>
}


<div class="row g-3 mt-1">
    <div class="col-md-6">
        <a asp-controller="ActivityLog" asp-action="Index" class="tp-card d-block dash-feature-card" style="text-decoration:none;transition:var(--transition)">
            <div class="dash-feature-icon" style="background:rgba(108,99,255,0.1);color:#6c63ff">
                <i class="bi bi-shield-check"></i>
            </div>
            <div class="dash-feature-body">
                <div class="dash-feature-title">Activity Log</div>
                <div class="dash-feature-desc">Review your recent account and agent actions</div>
            </div>
            <i class="bi bi-arrow-right dash-feature-arrow"></i>
        </a>
    </div>
    <div class="col-md-6">
        <a asp-controller="Referral" asp-action="Index" class="tp-card d-block dash-feature-card" style="text-decoration:none;transition:var(--transition)">
            <div class="dash-feature-icon" style="background:rgba(244,168,32,0.1);color:#f4a820">
                <i class="bi bi-gift-fill"></i>
            </div>
            <div class="dash-feature-body">
                <div class="dash-feature-title">Referral Program</div>
                <div class="dash-feature-desc">Share your code and earn rewards for every referral</div>
            </div>
            <i class="bi bi-arrow-right dash-feature-arrow"></i>
        </a>
    </div>
</div>

<style>
    .dash-feature-card {
        display: flex !important;
        align-items: center;
        gap: 14px;
        padding: 16px 20px;
        color: var(--text-1);
    }

        .dash-feature-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .dash-feature-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .dash-feature-body {
        flex: 1;
        min-width: 0;
    }

    .dash-feature-title {
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 3px;
    }

    .dash-feature-desc {
        font-size: 12px;
        color: var(--text-3);
        line-height: 1.4;
    }

    .dash-feature-arrow {
        color: var(--text-3);
        font-size: 16px;
        flex-shrink: 0;
    }

    .dash-feature-card:hover .dash-feature-arrow {
        color: var(--teal);
    }
</style>
