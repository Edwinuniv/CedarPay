@{
    ViewData["Title"] = "Agent Dashboard";
    ViewBag.PageClass = "page-agent";
    var agent = ViewBag.Agent as MoneyTransfer.Models.Agent;
    var agents = ViewBag.Agents as
        List<MoneyTransfer.Models.Agent>
        ?? new List<MoneyTransfer.Models.Agent>();
}

<div class="agent-dashboard-header">
    <h2 class="agent-dashboard-title">
        Agent Dashboard
        @if (agent != null)
        {
            <span class="agent-dashboard-store-name">@agent.StoreName</span>
        }
    </h2>
    <p class="agent-dashboard-subtitle">
        Manage your store and personal account
    </p>
</div>

<!-- Store Selector (multiple stores) -->
@if (agents.Count > 1)
{
    <div class="tp-card mb-3 store-selector-card">
        <div class="store-selector-content">
            <div class="store-selector-label">
                <i class="bi bi-shop"></i>
                Active Store
            </div>
            <form asp-action="SelectStore" method="post" class="store-selector-form">
                @Html.AntiForgeryToken()
                <select name="agentId" class="form-select store-selector-select">
                    @foreach (var a in agents)
                    {
                        if (agent?.Id == a.Id)
                        {
                            <option value="@a.Id" selected>@a.StoreName (@a.City)</option>
                        }
                        else
                        {
                            <option value="@a.Id">@a.StoreName (@a.City)</option>
                        }
                    }
                </select>
                <button type="submit" class="btn-tp-primary store-selector-btn">
                    Switch
                </button>
            </form>
        </div>
    </div>
}

<!-- Agent Stats -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon received">
                <i class="bi bi-cash-coin"></i>
            </div>
            <div class="stat-value">
                $@((ViewBag.TotalCashIn as decimal? ?? 0).ToString("N2"))
            </div>
            <div class="stat-label">Total Cash In</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon beneficiaries">
                <i class="bi bi-percent"></i>
            </div>
            <div class="stat-value">
                $@((ViewBag.TotalCommissions as decimal? ?? 0).ToString("N2"))
            </div>
            <div class="stat-label">Commissions</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon received">
                <i class="bi bi-geo-alt-fill"></i>
            </div>
            <div class="stat-value">
                @(agent != null && agent.Latitude != 0 ? "Set ✓" : "Not Set")
            </div>
            <div class="stat-label">Map Location</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon beneficiaries">
                <i class="bi bi-shop"></i>
            </div>
            <div class="stat-value">@agents.Count</div>
            <div class="stat-label">Active Stores</div>
        </div>
    </div>
</div>

<!-- Agent Actions -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-action="CashIn" class="tp-card agent-action-card">
            <div class="agent-action-content">
                <div class="stat-icon received agent-action-icon">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <div>
                    <div class="agent-action-title">Cash In</div>
                    <div class="agent-action-desc">Add cash to wallet</div>
                </div>
                <i class="bi bi-chevron-right agent-action-chevron"></i>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="CashOut" class="tp-card agent-action-card">
            <div class="agent-action-content">
                <div class="stat-icon sent agent-action-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <div class="agent-action-title">Cash Out</div>
                    <div class="agent-action-desc">Process withdrawal</div>
                </div>
                <i class="bi bi-chevron-right agent-action-chevron"></i>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="Commissions" class="tp-card agent-action-card">
            <div class="agent-action-content">
                <div class="stat-icon beneficiaries agent-action-icon">
                    <i class="bi bi-percent"></i>
                </div>
                <div>
                    <div class="agent-action-title">Commissions</div>
                    <div class="agent-action-desc">View earnings</div>
                </div>
                <i class="bi bi-chevron-right agent-action-chevron"></i>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="SetLocation" class="tp-card agent-action-card">
            <div class="agent-action-content">
                <div class="stat-icon received agent-action-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div>
                    <div class="agent-action-title">Set Location</div>
                    <div class="agent-action-desc">
                        @(agent != null && agent.Latitude != 0 ? agent.Latitude.ToString("F4") + ", " + agent.Longitude.ToString("F4") : "Appear on the map")
                    </div>
                </div>
                <i class="bi bi-chevron-right agent-action-chevron"></i>
            </div>
        </a>
    </div>
</div>

@if (agent != null)
{
    <div class="tp-card mb-3">
        <div class="tp-card-header">
            <span class="tp-card-title">
                <i class="bi bi-shop" style="color:var(--teal); margin-right:6px"></i>
                Store Information
            </span>
            @{
                string statusClass = "default";
                if (agent.Status == MoneyTransfer.Models.AgentStatus.Approved)
                {
                    statusClass = "success";
                }
                else if (agent.Status == MoneyTransfer.Models.AgentStatus.Pending)
                {
                    statusClass = "warning";
                }
                else if (agent.Status == MoneyTransfer.Models.AgentStatus.Rejected)
                {
                    statusClass = "danger";
                }
            }
            <span class="badge-tp @statusClass">
                @agent.Status
            </span>
        </div>
        <div class="store-info-grid">
            <div>
                <span class="store-info-label">Store:</span>
                <strong class="store-info-value">@agent.StoreName</strong>
            </div>
            <div>
                <span class="store-info-label">Agent:</span>
                <strong class="store-info-value">@agent.AgentName</strong>
            </div>
            <div>
                <span class="store-info-label">Phone:</span>
                <strong class="store-info-value">@agent.PhoneNumber</strong>
            </div>
            <div>
                <span class="store-info-label">Location:</span>
                <strong class="store-info-value">@agent.City, @agent.Country</strong>
            </div>
            <div>
                <span class="store-info-label">Hours:</span>
                <strong class="store-info-value">@(agent.WorkingHours ?? "Not set")</strong>
            </div>
            <div>
                <span class="store-info-label">Commission:</span>
                <strong class="store-info-value">@((agent.CommissionRate * 100).ToString("F1"))%</strong>
            </div>
        </div>

        <div class="store-actions">
            <a asp-action="EditStore" asp-route-id="@agent.Id" class="btn-tp-secondary store-action-btn">
                <i class="bi bi-pencil"></i> Edit Store
            </a>
            <a asp-action="SetLocation" asp-route-id="@agent.Id" class="btn-tp-primary store-action-btn">
                <i class="bi bi-geo-alt-fill"></i> Set Location
            </a>
            <form asp-action="DeleteStore" asp-route-id="@agent.Id" method="post" onsubmit="return confirm('Delete this store?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-tp-danger store-delete-btn">
                    <i class="bi bi-trash"></i>
                </button>
            </form>
            <a asp-action="Register" class="btn-tp-secondary store-new-btn">
                <i class="bi bi-plus-lg"></i> New Store
            </a>
        </div>
    </div>
}