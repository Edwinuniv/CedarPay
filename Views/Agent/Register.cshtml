@model MoneyTransfer.Models.Agent
@{
    ViewData["Title"] = "Register New Store";
    ViewBag.PageClass = "page-agent";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="page-header">
            <div>
                <h2>Register New Store</h2>
                <p>Add another agent store location</p>
            </div>
            <a asp-action="Dashboard" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
        <div class="tp-card">
            <form asp-action="Register" method="post" class="tp-form">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Store Name *</label>
                            <input asp-for="StoreName" class="form-control" placeholder="My Store" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Agent Name *</label>
                            <input asp-for="AgentName" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Phone *</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+961..." />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" type="email" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">City *</label>
                            <input asp-for="City" class="form-control" placeholder="Beirut" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Country *</label>
                            <input asp-for="Country" class="form-control" placeholder="Lebanon" />
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="form-group">
                            <label class="form-label">Street</label>
                            <input asp-for="Street" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Working Hours</label>
                            <input asp-for="WorkingHours" class="form-control" placeholder="Mon-Fri 9-6" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn-tp-primary">
                        <i class="bi bi-shop"></i> Register Store
                    </button>
                    <a asp-action="Dashboard" class="btn-tp-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>