@{
    ViewData["Title"] = "Cash In";
    ViewBag.PageClass = "page-agent";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="page-header">
            <div>
                <h2>Cash In</h2>
                <p>Add cash funds to a user's wallet</p>
            </div>
            <a asp-action="Dashboard" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <div class="tp-card">
            <form asp-action="CashIn" method="post" class="tp-form">
                @Html.AntiForgeryToken()

                <div class="cash-info-alert">
                    <i class="bi bi-info-circle"></i>
                    You are <strong>adding</strong> cash
                    to the user's wallet.
                    Make sure you have received the physical
                    cash from the user first.
                </div>

                <div class="form-group">
                    <label class="form-label">User's Wallet Serial *</label>
                    <input type="text" name="walletSerial"
                           class="form-control"
                           placeholder="WAL-2026-XXXXX"
                           required />
                </div>

                <div class="form-group">
                    <label class="form-label">Amount to Deposit *</label>
                    <input type="number" name="amount"
                           class="form-control"
                           step="0.01" min="0.01"
                           placeholder="0.00" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Note (Optional)</label>
                    <input type="text" name="note"
                           class="form-control"
                           placeholder="Cash deposit note" />
                </div>

                <button type="submit" class="btn-tp-primary cash-submit-btn">
                    <i class="bi bi-cash-coin"></i>
                    Confirm Cash Deposit
                </button>
            </form>
        </div>
    </div>
</div>