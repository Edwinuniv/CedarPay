@model List<MoneyTransfer.Models.AgentApplication>
@{
    ViewData["Title"] = "My Agent Application";
    ViewBag.PageClass = "page-dashboard";
}

<div class="page-header">
    <div>
        <h2>My Agent Application</h2>
        <p>Track the status of your application</p>
    </div>
    @if (!Model.Any())
    {
        <a asp-action="Apply" class="btn-tp-primary">
            <i class="bi bi-shop"></i> Apply Now
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-shop"></i>
            <p>You haven't applied to become an agent yet.</p>
            <a asp-action="Apply" class="btn-tp-primary">
                <i class="bi bi-shop"></i> Apply to Become an Agent
            </a>
        </div>
    </div>
}
else
{
    <div class="applications-container">
        @foreach (var app in Model)
        {
            <div class="tp-card application-card">
                <div class="application-header">
                    <div class="application-content">
                        <div class="application-store-row">
                            <div class="application-store-name">
                                @app.StoreName
                            </div>
                            @{
                                var badgeClass = app.Status switch
                                {
                                    MoneyTransfer.Models.ApplicationStatus.Pending
                                    => "warning",
                                    MoneyTransfer.Models.ApplicationStatus.Approved
                                    => "success",
                                    MoneyTransfer.Models.ApplicationStatus.Rejected
                                    => "danger",
                                    _ => "default"
                                };
                            }
                            <span class="badge-tp @badgeClass">
                                @app.Status
                            </span>
                        </div>

                        <div class="application-details-grid">
                            <div class="application-detail-item">
                                <i class="bi bi-person"></i>
                                @app.AgentName
                            </div>
                            <div class="application-detail-item">
                                <i class="bi bi-telephone"></i>
                                @app.PhoneNumber
                            </div>
                            <div class="application-detail-item">
                                <i class="bi bi-geo-alt"></i>
                                @app.City, @app.Country
                            </div>
                            <div class="application-detail-item">
                                <i class="bi bi-clock"></i>
                                @app.WorkingHours
                            </div>
                        </div>

                        @if (app.Status == MoneyTransfer.Models.ApplicationStatus.Rejected && !string.IsNullOrEmpty(app.RejectionReason))
                        {
                            <div class="rejection-reason-box">
                                <i class="bi bi-exclamation-circle"></i>
                                <strong>Rejection reason:</strong>
                                @app.RejectionReason
                            </div>
                        }

                        @if (app.Status == MoneyTransfer.Models.ApplicationStatus.Approved)
                        {
                            <div class="approved-box">
                                <i class="bi bi-check-circle-fill"></i>
                                Approved on @app.ReviewedAt?.ToString("MMM dd, yyyy")
                            </div>
                        }
                    </div>

                    <div class="application-date">
                        Submitted<br />
                        <strong>@app.SubmittedAt.ToString("MMM dd, yyyy")</strong>
                    </div>
                </div>
            </div>
        }
    </div>
}