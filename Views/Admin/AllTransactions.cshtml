@model List<MoneyTransfer.Models.Transaction>
@{
    ViewData["Title"] = "All Transactions";
    ViewBag.PageClass = "page-admin";
}

<div class="page-header">
    <div>
        <h2>All Transactions</h2>
        <p>Platform-wide transaction log (last 100)</p>
    </div>
    <div style="display: flex; gap: 8px;">
        <button onclick="exportTransactions()" class="btn-tp-primary">
            <i class="bi bi-file-earmark-excel"></i> Export All Transactions
        </button>
        <a asp-action="Index" class="btn-tp-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="tp-card search-container">
    <input type="text"
           id="txSearch"
           class="form-control"
           placeholder="Search by serial, name..."
           oninput="filterTransactions(this.value)" />
</div>

<div class="tp-card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-receipt"></i>
            <p>No transactions yet.</p>
        </div>
    }
    else
    {
        <table class="tp-table" id="txTable">
            <thead>
                <tr>
                    <th>Serial</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Amount</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr class="tx-row"
                        data-search="@t.SerialNumber?.ToLower() @t.SenderWallet?.User?.FirstName?.ToLower() @t.ReceiverWallet?.User?.FirstName?.ToLower()">
                        <td class="tx-serial-cell">
                            @t.SerialNumber
                        </td>
                        <td>
                            <div class="tx-user-cell">
                                @t.SenderWallet?.User?.FirstName
                                @t.SenderWallet?.User?.LastName
                            </div>
                            <div class="tx-user-sub">
                                @t.SenderCurrency?.Code
                            </div>
                        </td>
                        <td>
                            <div class="tx-user-cell">
                                @(t.ReceiverWallet?.User != null
                                                        ? $"{t.ReceiverWallet.User.FirstName} {t.ReceiverWallet.User.LastName}"
                                                        : t.ReceiverName ?? "Mobile")
                    </div>
                    <div class="tx-user-sub">
                        @t.ReceiverCurrency?.Code
                    </div>
                </td>
                <td class="tx-amount-cell">
                    @t.SenderCurrency?.Symbol@t.Amount.ToString("N2")
                </td>
                <td class="tx-fee-cell">
                    @if (t.FeeWaived)
                            {
                                <span class="badge-tp success">Free</span>
                            }
                            else
                            {
                                @t.FeeAmount.ToString("N2")
                            }
                        </td>
                        <td>
                            <span class="tx-status @t.Status.ToString().ToLower()">
                                @t.Status
                            </span>
                        </td>
                        <td class="tx-date-cell">
                            @t.CreatedAt.ToString("MMM dd, HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        function filterTransactions(q) {
            const lower = q.toLowerCase();
            document.querySelectorAll('.tx-row').forEach(row => {
                const data = row.dataset.search || '';
                row.style.display = (!q || data.includes(lower)) ? '' : 'none';
            });
        }

        function exportTransactions() {
            window.location.href = '/Admin/ExportTransactions';
        }
    </script>
}