@model List<MoneyTransfer.Models.AgentApplication>
@{
    ViewData["Title"] = "Agent Applications";
}

<div class="page-header">
    <div>
        <h2>Agent Applications</h2>
        <p>Review and approve agent registration requests</p>
    </div>
    <a asp-action="Index" class="btn-tp-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-person-check"></i>
            <p>No pending agent applications.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var app in Model)
        {
            <div class="tp-card">
                <div style="display:flex;align-items:flex-start;gap:16px">
                    <div class="ben-avatar"
                         style="width:44px;height:44px;font-size:14px;flex-shrink:0">
                        @app.AgentName.Substring(0, 1).ToUpper()
                    </div>

                    <div style="flex:1">
                        <div style="font-size:15px;font-weight:700;color:var(--text-1)">
                            @app.StoreName
                        </div>
                        <div style="font-size:13px;color:var(--text-2);margin-top:2px">
                            @app.AgentName · @app.Email · @app.PhoneNumber
                        </div>
                        <div style="font-size:12px;color:var(--text-3);margin-top:3px">
                            <i class="bi bi-geo-alt"></i>
                            @app.City, @app.Country ·
                            <i class="bi bi-clock"></i>
                            @app.WorkingHours
                        </div>
                        @if (!string.IsNullOrEmpty(app.Description))
                        {
                            <div style="font-size:13px;color:var(--text-2);
                                                    margin-top:6px;font-style:italic">
                                "@app.Description"
                            </div>
                        }
                    </div>

                    <div style="font-size:11px;color:var(--text-3);
                                        text-align:right;flex-shrink:0">
                        @app.SubmittedAt.ToString("MMM dd, yyyy")
                    </div>
                </div>

                <div style="display:flex;gap:10px;margin-top:14px;
                                    padding-top:14px;border-top:1px solid var(--border)">
                    <form asp-action="ApproveApplication"
                          asp-route-id="@app.Id" method="post">
                        <button type="submit" class="btn-tp-success"
                                style="padding:8px 18px;font-size:13px">
                            <i class="bi bi-check-lg"></i> Approve
                        </button>
                    </form>

                    <form asp-action="RejectApplication"
                          asp-route-id="@app.Id" method="post"
                          style="display:flex;gap:8px;flex:1"
                          onsubmit="return validateReject(this)">
                        <input type="text" name="reason"
                               class="form-control"
                               placeholder="Rejection reason (optional)"
                               style="flex:1;font-size:13px" />
                        <button type="submit" class="btn-tp-danger"
                                style="padding:8px 16px;font-size:13px;flex-shrink:0">
                            <i class="bi bi-x-lg"></i> Reject
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function validateReject(form) {
            return confirm('Reject this application?');
        }
    </script>
}