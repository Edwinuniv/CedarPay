@model List<MoneyTransfer.Models.AgentApplication>
@{
    ViewData["Title"] = "Agent Applications";
    ViewBag.PageClass = "page-admin";
}

<div class="page-header">
    <div>
        <h2>Agent Applications</h2>
        <p>Review and approve agent registration requests</p>
    </div>
    <a asp-action="Index" class="btn-tp-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-person-check"></i>
            <p>No pending agent applications.</p>
        </div>
    </div>
}
else
{
    <div class="applications-container">
        @foreach (var app in Model)
        {
            <div class="tp-card application-card">
                <div class="application-header">
                    <div class="ben-avatar application-avatar">
                        @app.AgentName.Substring(0, 1).ToUpper()
                    </div>

                    <div class="application-info">
                        <div class="application-store-name">
                            @app.StoreName
                        </div>
                        <div class="application-details">
                            @app.AgentName · @app.Email · @app.PhoneNumber
                        </div>
                        <div class="application-location">
                            <i class="bi bi-geo-alt"></i>
                            @app.City, @app.Country ·
                            <i class="bi bi-clock"></i>
                            @app.WorkingHours
                        </div>
                        @if (!string.IsNullOrEmpty(app.Description))
                        {
                            <div class="application-description">
                                "@app.Description"
                            </div>
                        }
                    </div>

                    <div class="application-date">
                        @app.SubmittedAt.ToString("MMM dd, yyyy")
                    </div>
                </div>

                <div class="application-actions">
                    <form asp-action="ApproveApplication" asp-route-id="@app.Id" method="post">
                        <button type="submit" class="btn-tp-success application-btn-approve">
                            <i class="bi bi-check-lg"></i> Approve
                        </button>
                    </form>

                    <form asp-action="RejectApplication" asp-route-id="@app.Id" method="post"
                          class="application-reject-form" onsubmit="return validateReject(this)">
                        <input type="text" name="reason" class="form-control application-reject-input"
                               placeholder="Rejection reason (optional)" />
                        <button type="submit" class="btn-tp-danger application-btn-reject">
                            <i class="bi bi-x-lg"></i> Reject
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function validateReject(form) {
            return confirm('Reject this application?');
        }
    </script>
}