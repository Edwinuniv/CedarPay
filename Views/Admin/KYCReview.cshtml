@model List<MoneyTransfer.Models.KYCDocument>
@{
    ViewData["Title"] = "KYC Review";
    ViewBag.PageClass = "page-admin";
}

<div class="page-header">
    <div>
        <h2>KYC Review</h2>
        <p>Verify user identity documents</p>
    </div>
    <a asp-action="Index" class="btn-tp-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-shield-check"></i>
            <p>No pending KYC submissions.</p>
        </div>
    </div>
}
else
{
    <div class="kyc-container-list">
        @foreach (var kyc in Model)
        {
            <div class="tp-card">
                <div class="kyc-card-header">
                    <div class="ben-avatar kyc-user-avatar">
                        @kyc.User?.FirstName?.Substring(0, 1)
                    </div>
                    <div class="kyc-user-info">
                        <div class="kyc-user-name">
                            @kyc.User?.FirstName @kyc.User?.LastName
                        </div>
                        <div class="kyc-user-document">
                            @kyc.DocumentType · @kyc.DocumentNumber
                        </div>
                        <div class="kyc-user-date">
                            Submitted @kyc.SubmittedAt.ToString("MMM dd, yyyy HH:mm")
                        </div>
                    </div>
                </div>

                <div class="kyc-images">
                    @if (!string.IsNullOrEmpty(kyc.FrontImageUrl))
                    {
                        <div>
                            <div class="kyc-image-label">Front</div>
                            <img src="@kyc.FrontImageUrl"
                                 class="kyc-image"
                                 onclick="window.open('@kyc.FrontImageUrl')" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(kyc.BackImageUrl))
                    {
                        <div>
                            <div class="kyc-image-label">Back</div>
                            <img src="@kyc.BackImageUrl"
                                 class="kyc-image"
                                 onclick="window.open('@kyc.BackImageUrl')" />
                        </div>
                    }
                </div>

                <div class="kyc-actions">
                    <form asp-action="ApproveKYC" asp-route-id="@kyc.Id" method="post">
                        <button type="submit" class="btn-tp-success kyc-approve-btn">
                            <i class="bi bi-check-lg"></i> Approve
                        </button>
                    </form>

                    <form asp-action="RejectKYC"
                          asp-route-id="@kyc.Id"
                          method="post"
                          class="kyc-reject-form"
                          onsubmit="return confirm('Reject this KYC?')">
                        <input type="text" name="reason"
                               class="form-control kyc-reject-input"
                               placeholder="Rejection reason" />
                        <button type="submit" class="btn-tp-danger kyc-reject-btn">
                            <i class="bi bi-x-lg"></i> Reject
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}