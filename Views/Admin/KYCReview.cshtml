@model List<MoneyTransfer.Models.KYCDocument>
@{
    ViewData["Title"] = "KYC Review";
}

<div class="page-header">
    <div>
        <h2>KYC Review</h2>
        <p>Verify user identity documents</p>
    </div>
    <a asp-action="Index" class="btn-tp-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-shield-check"></i>
            <p>No pending KYC submissions.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var kyc in Model)
        {
            <div class="tp-card">
                <div style="display:flex;align-items:flex-start;
                                    gap:16px;margin-bottom:14px">
                    <div class="ben-avatar"
                         style="width:44px;height:44px;font-size:14px">
                        @kyc.User?.FirstName?.Substring(0, 1)
                    </div>
                    <div style="flex:1">
                        <div style="font-weight:700;font-size:15px">
                            @kyc.User?.FirstName @kyc.User?.LastName
                        </div>
                        <div style="font-size:13px;color:var(--text-2)">
                            @kyc.DocumentType · @kyc.DocumentNumber
                        </div>
                        <div style="font-size:11px;color:var(--text-3)">
                            Submitted @kyc.SubmittedAt.ToString("MMM dd, yyyy HH:mm")
                        </div>
                    </div>
                </div>

                <!-- Document Images -->
                <div style="display:flex;gap:12px;margin-bottom:14px">
                    @if (!string.IsNullOrEmpty(kyc.FrontImageUrl))
                    {
                        <div>
                            <div style="font-size:11px;color:var(--text-3);
                                                    margin-bottom:4px">
                                Front
                            </div>
                            <img src="@kyc.FrontImageUrl"
                                 style="height:100px;
                                                    border-radius:var(--r-sm);
                                                    object-fit:cover;
                                                    border:1px solid var(--border);
                                                    cursor:pointer"
                                 onclick="window.open('@kyc.FrontImageUrl')" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(kyc.BackImageUrl))
                    {
                        <div>
                            <div style="font-size:11px;color:var(--text-3);
                                                    margin-bottom:4px">
                                Back
                            </div>
                            <img src="@kyc.BackImageUrl"
                                 style="height:100px;
                                                    border-radius:var(--r-sm);
                                                    object-fit:cover;
                                                    border:1px solid var(--border);
                                                    cursor:pointer"
                                 onclick="window.open('@kyc.BackImageUrl')" />
                        </div>
                    }
                </div>

                <!-- Actions -->
                <div style="display:flex;gap:10px;
                                    padding-top:14px;
                                    border-top:1px solid var(--border)">
                    <form asp-action="ApproveKYC"
                          asp-route-id="@kyc.Id" method="post">
                        <button type="submit" class="btn-tp-success"
                                style="padding:8px 18px;font-size:13px">
                            <i class="bi bi-check-lg"></i> Approve
                        </button>
                    </form>

                    <form asp-action="RejectKYC"
                          asp-route-id="@kyc.Id"
                          method="post"
                          style="display:flex;gap:8px;flex:1"
                          onsubmit="return confirm('Reject this KYC?')">
                        <input type="text" name="reason"
                               class="form-control"
                               placeholder="Rejection reason"
                               style="flex:1;font-size:13px" />
                        <button type="submit" class="btn-tp-danger"
                                style="padding:8px 16px;font-size:13px">
                            <i class="bi bi-x-lg"></i> Reject
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}