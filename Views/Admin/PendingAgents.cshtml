@model IEnumerable<MoneyTransfer.Models.Agent>
@{
    ViewData["Title"] = "Pending Agents";
    ViewBag.PageClass = "page-admin";
}

<div class="page-header">
    <div>
        <h2>Pending Agents</h2>
        <p>Review and approve agent registrations</p>
    </div>
    <a asp-action="Index" class="btn-tp-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-person-check"></i>
            <p>No pending agent approvals.</p>
        </div>
    </div>
}
else
{
    <div class="tp-card">
        <table class="tp-table">
            <thead>
                <tr>
                    <th>Agent</th>
                    <th>Store</th>
                    <th>Location</th>
                    <th>Registered</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            <div class="agent-name-cell">@a.AgentName</div>
                            <div class="agent-email-cell">@a.Email</div>
                        </td>
                        <td>@a.StoreName</td>
                        <td class="agent-location-cell">@a.City, @a.Country</td>
                        <td class="agent-registered-cell">
                            @a.RegisteredAt.ToString("MMM dd, yyyy")
                        </td>
                        <td>
                            <div class="agent-actions">
                                <form asp-action="ApproveAgent" asp-route-id="@a.Id" method="post">
                                    <button type="submit" class="btn-tp-success agent-approve-btn">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                </form>
                                <form asp-action="RejectAgent" asp-route-id="@a.Id" method="post">
                                    <button type="submit" class="btn-tp-danger agent-reject-btn"
                                            onclick="return confirm('Reject this agent?')">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}