@model IEnumerable<MoneyTransfer.Models.Review>
@{
    ViewData["Title"] = "All Reviews";
    ViewBag.PageClass = "page-admin";
    double avg = ViewBag.AverageRating is double d ? d : 0;
}

<div class="page-header">
    <div>
        <h2>All Reviews</h2>
        <p>
            Average rating:
            <strong class="text-teal">@avg.ToString("F1") / 5</strong>
        </p>
    </div>
    <a asp-action="Index" class="btn-tp-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-star"></i>
            <p>No reviews yet.</p>
        </div>
    </div>
}
else
{
    <div class="reviews-container">
        @foreach (var r in Model)
        {
            <div class="tp-card">
                <div class="reviews-header">
                    <div>
                        <div class="review-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span>@(i <= r.Rating ? "★" : "☆")</span>
                            }
                        </div>
                        <div class="review-comment">@r.Comment</div>
                        <div class="review-meta">
                            By @r.User?.FirstName @r.User?.LastName
                            · @r.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                    <form asp-action="DeleteReview"
                          asp-route-id="@r.Id"
                          method="post"
                          onsubmit="return confirm('Delete this review?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-tp-danger review-delete-btn">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}