@model IEnumerable<MoneyTransfer.Models.User>
@{
    ViewData["Title"] = "User Management";
}

<div class="page-header">
    <div>
        <h2>User Management</h2>
        <p>@Model.Count() total users</p>
    </div>
    <a asp-action="Index" class="btn-tp-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="tp-card mb-3">
    <div style="display:flex;gap:12px;flex-wrap:wrap">
        <input type="text"
               id="userSearch"
               class="form-control"
               placeholder="Search by name, email, phone..."
               oninput="filterUsers(this.value)"
               style="flex:1;min-width:200px" />
        <select id="sortSelect"
                class="form-select"
                style="width:auto"
                onchange="sortUsers(this.value)">
            <option value="name">Sort by Name</option>
            <option value="email">Sort by Email</option>
            <option value="date">Sort by Date</option>
            <option value="verified">Sort by Verified</option>
        </select>
        <select id="filterRole"
                class="form-select"
                style="width:auto"
                onchange="filterUsers(document.getElementById('userSearch').value)">
            <option value="">All Roles</option>
            <option value="admin">Admin</option>
            <option value="agent">Agent</option>
            <option value="user">User</option>
        </select>
    </div>
</div>

<div class="tp-card" style="overflow-x:auto">
    <table class="tp-table" id="usersTable">
        <thead>
            <tr>
                <th>User</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Nationality</th>
                <th>Account Type</th>
                <th>KYC</th>
                <th>Status</th>
                <th>Joined</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr class="user-row"
                    data-name="@(u.FirstName?.ToLower()) @(u.LastName?.ToLower())"
                    data-email="@u.Email?.ToLower()"
                    data-phone="@u.PhoneNumber?.ToLower()"
                    data-roles="@(ViewBag.UserRoles != null && ((Dictionary<string, List<string>>)ViewBag.UserRoles).ContainsKey(u.Id) ? string.Join(",", ((Dictionary<string, List<string>>)ViewBag.UserRoles)[u.Id]).ToLower() : "user")">
                    <td>
                        <div style="display:flex;
                                        align-items:center;gap:10px">
                            @if (!string.IsNullOrEmpty(
                                                    u.ProfilePictureUrl))
                            {
                                <img src="@u.ProfilePictureUrl"
                                     style="width:36px;height:36px;
                                                    border-radius:50%;
                                                    object-fit:cover" />
                            }
                            else
                            {
                                <div class="ben-avatar"
                                     style="width:36px;height:36px;
                                                    font-size:12px">
                                    @u.FirstName?.Substring(0, 1)@u.LastName?.Substring(0, 1)
                                </div>
                            }
                            <div>
                                <div style="font-weight:600;
                                                font-size:13px">
                                    @u.FirstName @u.LastName
                                </div>
                                @{
                                    var roles = ViewBag.UserRoles != null
                                    && ((Dictionary<string, List<string>>)ViewBag.UserRoles)
                                    .ContainsKey(u.Id)
                                    ? ((Dictionary<string, List<string>>)ViewBag.UserRoles)[u.Id]
                                    : new List<string>();
                                }
                                @foreach (var role in roles)
                                {
                                    <span class="badge-tp @(role == "admin" ? "info" : role == "agent" ? "success" : "default")"
                                          style="font-size:9px;padding:1px 6px;margin-right:2px">
                                        @role
                                    </span>
                                }
                            </div>
                        </div>
                    </td>
                    <td style="font-size:13px;color:var(--text-2)">
                        @u.Email
                    </td>
                    <td style="font-size:13px;color:var(--text-2)">
                        @(u.PhoneNumber ?? "—")
                    </td>
                    <td style="font-size:13px;color:var(--text-2)">
                        @(u.Nationality ?? "—")
                    </td>
                    <td>
                        <span class="badge-tp default">
                            @(u.AccountType ?? "Individual")
                        </span>
                    </td>
                    <td>
                        <span class="badge-tp @(u.IsVerified ? "success" : "warning")">
                            @(u.IsVerified ? "Verified" : "Pending")
                        </span>
                    </td>
                    <td>
                        <span class="badge-tp @(u.IsActive ? "success" : "danger")">
                            @(u.IsActive ? "Active" : "Disabled")
                        </span>
                    </td>
                    <td style="font-size:12px;color:var(--text-3)">
                        @u.CreatedAt.ToString("MMM dd, yyyy")
                    </td>
                    <td>
                        <div style="display:flex;gap:4px;
                                        flex-wrap:wrap">
                            @if (!roles.Contains("admin"))
                            {
                                <form asp-action="PromoteToAdmin"
                                      asp-route-userId="@u.Id"
                                      method="post"
                                      onsubmit="return confirm('Make this user an Admin?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn-tp-secondary"
                                            style="padding:4px 8px;
                                                           font-size:11px"
                                            title="Make Admin">
                                        <i class="bi bi-shield-fill"></i>
                                    </button>
                                </form>
                            }
                            <form asp-action="ToggleAccount"
                                  asp-route-userId="@u.Id"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn-tp-@(u.IsActive ? "danger" : "success")"
                                        style="padding:4px 8px;
                                                   font-size:11px"
                                        title="@(u.IsActive ? "Disable" : "Enable")">
                                    <i class="bi bi-@(u.IsActive ? "person-x" : "person-check")"></i>
                                </button>
                            </form>
                            <a asp-action="UserDetails"
                               asp-route-userId="@u.Id"
                               class="btn-tp-secondary"
                               style="padding:4px 8px;font-size:11px"
                               title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function filterUsers(q) {
            const lower = q.toLowerCase();
            const role = document.getElementById(
                'filterRole').value.toLowerCase();
            document.querySelectorAll('.user-row')
                .forEach(row => {
                    const name = row.dataset.name || '';
                    const email = row.dataset.email || '';
                    const phone = row.dataset.phone || '';
                    const roles = row.dataset.roles || '';

                    const matchQ = !q ||
                        name.includes(lower) ||
                        email.includes(lower) ||
                        phone.includes(lower);
                    const matchRole = !role ||
                        roles.includes(role);

                    row.style.display =
                        matchQ && matchRole ? '' : 'none';
                });
        }

        function sortUsers(field) {
            const tbody = document.querySelector(
                '#usersTable tbody');
            const rows = [...document.querySelectorAll(
                '.user-row')];

            rows.sort((a, b) => {
                let av = '', bv = '';
                if (field === 'name') {
                    av = a.dataset.name || '';
                    bv = b.dataset.name || '';
                } else if (field === 'email') {
                    av = a.dataset.email || '';
                    bv = b.dataset.email || '';
                }
                return av.localeCompare(bv);
            });

            rows.forEach(r => tbody.appendChild(r));
        }
    </script>
}