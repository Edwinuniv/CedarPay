@model IEnumerable<MoneyTransfer.Models.User>
@{
    ViewData["Title"] = "User Management";
    ViewBag.PageClass = "page-admin";
}

<div class="page-header">
    <div>
        <h2>User Management</h2>
        <p>@Model.Count() total users</p>
    </div>
    <div class="user-management-actions">
        <button onclick="exportUsers()" class="btn-tp-primary">
            <i class="bi bi-file-earmark-excel"></i> Export Users
        </button>
        <form asp-action="CreateGuestUser" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-tp-secondary" onclick="return confirm('Create a guest account?')">
                <i class="bi bi-person-plus"></i> + Guest User
            </button>
        </form>
        <a asp-action="Index" class="btn-tp-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="tp-card mb-3">
    <div class="user-filters-container">
        <input type="text"
               id="userSearch"
               class="form-control user-search-input"
               placeholder="Search by name, email, phone..."
               oninput="filterUsers(this.value)" />
        <select id="sortSelect" class="form-select user-sort-select" onchange="sortUsers(this.value)">
            <option value="name">Sort by Name</option>
            <option value="email">Sort by Email</option>
            <option value="date">Sort by Date</option>
            <option value="verified">Sort by Verified</option>
        </select>
        <select id="filterRole" class="form-select user-role-filter" onchange="filterUsers(document.getElementById('userSearch').value)">
            <option value="">All Roles</option>
            <option value="admin">Admin</option>
            <option value="agent">Agent</option>
            <option value="user">User</option>
        </select>
    </div>
</div>

<div class="tp-card users-table-container">
    <table class="tp-table" id="usersTable">
        <thead>
            <tr>
                <th>User</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Nationality</th>
                <th>Account Type</th>
                <th>KYC</th>
                <th>Status</th>
                <th>Joined</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr class="user-row"
                    data-name="@(u.FirstName?.ToLower()) @(u.LastName?.ToLower())"
                    data-email="@u.Email?.ToLower()"
                    data-phone="@u.PhoneNumber?.ToLower()"
                    data-date="@u.CreatedAt.ToString("yyyy-MM-dd")"
                    data-verified="@u.IsVerified.ToString().ToLower()"
                    data-roles="@(ViewBag.UserRoles != null && ((Dictionary<string, List<string>>)ViewBag.UserRoles).ContainsKey(u.Id) ? string.Join(",", ((Dictionary<string, List<string>>)ViewBag.UserRoles)[u.Id]).ToLower() : "user")">

                    <td class="user-cell">
                        <div class="user-avatar-row">
                            @if (!string.IsNullOrEmpty(u.ProfilePictureUrl))
                            {
                                <img src="@u.ProfilePictureUrl" class="user-avatar-img" />
                            }
                            else
                            {
                                <div class="ben-avatar user-avatar-initials">
                                    @u.FirstName?.Substring(0, 1)@u.LastName?.Substring(0, 1)
                                </div>
                            }
                            <div class="user-info">
                                <div class="user-name">@u.FirstName @u.LastName</div>
                                @{
                                    var roles = ViewBag.UserRoles != null
                                    && ((Dictionary<string, List<string>>)ViewBag.UserRoles)
                                    .ContainsKey(u.Id)
                                    ? ((Dictionary<string, List<string>>)ViewBag.UserRoles)[u.Id]
                                    : new List<string>();
                                }
                                <div class="user-roles-container">
                                    @foreach (var role in roles)
                                    {
                                        <span class="badge-tp @(role == "admin" ? "info" : role == "agent" ? "success" : "default") user-role-badge">
                                            @role
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="user-email-cell">@u.Email</td>
                    <td class="user-phone-cell">@(u.PhoneNumber ?? "—")</td>
                    <td class="user-nationality-cell">@(u.Nationality ?? "—")</td>
                    <td class="user-account-type-cell">
                        <span class="badge-tp default">@(u.AccountType ?? "Individual")</span>
                    </td>
                    <td class="user-kyc-cell">
                        <span class="badge-tp @(u.IsVerified ? "success" : "warning")">
                            @(u.IsVerified ? "Verified" : "Pending")
                        </span>
                    </td>
                    <td class="user-status-cell">
                        <span class="badge-tp @(u.IsActive ? "success" : "danger")">
                            @(u.IsActive ? "Active" : "Disabled")
                        </span>
                    </td>
                    <td class="user-joined-cell">@u.CreatedAt.ToString("MMM dd, yyyy")</td>
                    <td class="user-actions-cell">
                        <div class="user-actions">
                            @if (!roles.Contains("admin"))
                            {
                                <form asp-action="PromoteToAdmin" asp-route-userId="@u.Id" method="post" onsubmit="return confirm('Make this user an Admin?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-tp-secondary user-action-btn" title="Make Admin">
                                        <i class="bi bi-shield-fill"></i>
                                    </button>
                                </form>
                            }
                            <form asp-action="ToggleAccount" asp-route-userId="@u.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-tp-@(u.IsActive ? "danger" : "success") user-action-btn" title="@(u.IsActive ? "Disable" : "Enable")">
                                    <i class="bi bi-@(u.IsActive ? "person-x" : "person-check")"></i>
                                </button>
                            </form>
                            <a asp-action="UserDetails" asp-route-userId="@u.Id" class="btn-tp-secondary user-action-btn" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function filterUsers(q) {
            const lower = q.toLowerCase();
            const role = document.getElementById('filterRole').value.toLowerCase();
            document.querySelectorAll('.user-row').forEach(row => {
                const name = row.dataset.name || '';
                const email = row.dataset.email || '';
                const phone = row.dataset.phone || '';
                const roles = row.dataset.roles || '';

                const matchQ = !q || name.includes(lower) || email.includes(lower) || phone.includes(lower);
                const matchRole = !role || roles.includes(role);

                row.style.display = matchQ && matchRole ? '' : 'none';
            });
        }

        function sortUsers(field) {
            const tbody = document.querySelector('#usersTable tbody');
            const rows = [...document.querySelectorAll('.user-row')];

            rows.sort((a, b) => {
                let av = '', bv = '';

                switch(field) {
                    case 'name':
                        av = a.dataset.name || '';
                        bv = b.dataset.name || '';
                        return av.localeCompare(bv);

                    case 'email':
                        av = a.dataset.email || '';
                        bv = b.dataset.email || '';
                        return av.localeCompare(bv);

                    case 'date':
                        av = a.dataset.date || '';
                        bv = b.dataset.date || '';
                        return av.localeCompare(bv);

                    case 'verified':
                        av = a.dataset.verified === 'true' ? 1 : 0;
                        bv = b.dataset.verified === 'true' ? 1 : 0;
                        return bv - av;

                    default:
                        return 0;
                }
            });

            rows.forEach(r => tbody.appendChild(r));
        }

        function exportUsers() {
            const role = document.getElementById('filterRole').value;
            window.location.href = `/Admin/ExportUsers?role=${role}`;
        }
    </script>
}