@{
    ViewData["Title"] = "Admin Control Center";
}

<div style="margin-bottom:24px">
    <h2 style="font-size:22px;font-weight:800;
                color:var(--text-1);letter-spacing:-0.4px">
        Admin Control Center
    </h2>
    <p style="color:var(--text-3);font-size:13px;
              margin-top:4px">
        Full platform access — manage users, agents,
        transactions, and settings
    </p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon beneficiaries">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-value">
                @(ViewBag.TotalUsers ?? 0)
            </div>
            <div class="stat-label">Total Users</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon received">
                <i class="bi bi-shop"></i>
            </div>
            <div class="stat-value">
                @(ViewBag.TotalAgents ?? 0)
            </div>
            <div class="stat-label">Active Agents</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon sent">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-value">
                @(ViewBag.PendingAgents ?? 0)
            </div>
            <div class="stat-label">Pending Apps</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon beneficiaries">
                <i class="bi bi-currency-exchange"></i>
            </div>
            <div class="stat-value">
                @(ViewBag.TotalTransactions ?? 0)
            </div>
            <div class="stat-label">Transactions</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    @{
        var adminCards = new[]
        {
        (
        "Users",
        "Manage Users",
        "View, sort, disable accounts",
        "bi-people-fill",
        "beneficiaries",
        (int)(ViewBag.TotalUsers ?? 0),
        "info"
        ),
        (
        "AgentApplications",
        "Agent Applications",
        "Approve or reject requests",
        "bi-person-check-fill",
        "sent",
        (int)(ViewBag.PendingAgents ?? 0),
        "warning"
        ),
        (
        "KYCReview",
        "KYC Review",
        "Verify identity documents",
        "bi-shield-check",
        "received",
        0,
        ""
        ),
        (
        "WalletRequests",
        "Wallet Approvals",
        "Approve wallet creation",
        "bi-wallet2",
        "sent",
        (int)(ViewBag.PendingWallets ?? 0),
        "warning"
        ),
        (
        "AllTransactions",
        "All Transactions",
        "Platform-wide log",
        "bi-list-check",
        "beneficiaries",
        0,
        ""
        ),
        (
        "EarningsReport",
        "Earnings Report",
        "Fees collected & agent commissions",
        "bi-graph-up-arrow",
        "received",
        0,
        ""
        ),
        (
        "FeeSettings",
        "Fee Settings",
        "Configure transfer fees",
        "bi-percent",
        "received",
        0,
        ""
        ),
        (
        "ExchangeRates",
        "Exchange Rates",
        "View live currency rates",
        "bi-currency-exchange",
        "received",
        0,
        ""
        ),
        };
    }

    @foreach (var card in adminCards)
    {
        <div class="col-md-4">
            <a asp-controller="Admin"
               asp-action="@card.Item1"
               class="tp-card d-block text-decoration-none"
               style="transition:var(--transition)">
                <div style="display:flex;
                                    align-items:center;gap:12px">
                    <div class="stat-icon @card.Item5"
                         style="margin-bottom:0;
                                        flex-shrink:0">
                        <i class="bi @card.Item4"></i>
                    </div>
                    <div style="flex:1">
                        <div class="tp-card-title">
                            @card.Item2
                        </div>
                        <div style="font-size:12px;
                                            color:var(--text-3);
                                            margin-top:2px">
                            @card.Item3
                        </div>
                    </div>
                    @if (card.Item6 > 0)
                    {
                        <span class="badge-tp @card.Item7">
                            @card.Item6
                        </span>
                    }
                    else
                    {
                        <i class="bi bi-chevron-right"
                           style="color:var(--text-3)"></i>
                    }
                </div>
            </a>
        </div>
    }
</div>