@model MoneyTransfer.Models.User
@{
    ViewData["Title"] = "User Details";
    ViewBag.PageClass = "page-admin";
    var wallets = ViewBag.Wallets as
        List<MoneyTransfer.Models.Wallet>
        ?? new List<MoneyTransfer.Models.Wallet>();
    var kyc = ViewBag.KYC as MoneyTransfer.Models.KYCDocument;
    var roles = ViewBag.Roles as
        IList<string> ?? new List<string>();
}

<div class="page-header">
    <div>
        <h2>User Details</h2>
        <p>@Model.FirstName @Model.LastName</p>
    </div>
    <div class="user-details-actions">
        <a asp-controller="Admin" asp-action="UserReport"
           asp-route-userId="@Model.Id"
           target="_blank"
           class="btn-tp-secondary">
            <i class="bi bi-file-earmark-text"></i>
            Generate Report
        </a>
        <a asp-action="Users" class="btn-tp-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="tp-card">
            <div class="tp-card-header">
                <span class="tp-card-title">Personal Information</span>
            </div>
            <div class="user-info-container">
                @foreach (var item in new[]
                                {
                                ("Name", $"{Model.FirstName} {Model.LastName}"),
                                ("Email", Model.Email ?? "—"),
                                ("Phone", Model.PhoneNumber ?? "—"),
                                ("Gender", Model.Gender ?? "—"),
                                ("DOB", Model.DateOfBirth.Year > 1 ? Model.DateOfBirth.ToString("MMM dd, yyyy") : "—"),
                                ("Nationality", Model.Nationality ?? "—"),
                                ("Country", Model.Country ?? "—"),
                                ("City", Model.City ?? "—"),
                                ("Account Type", Model.AccountType ?? "—"),
                                ("Occupation", Model.Occupation ?? "—"),
                                ("Annual Income", Model.AnnualIncomeUSD ?? "—"),
                                })
                {
                    <div class="user-info-row">
                        <span class="user-info-label">@item.Item1</span>
                        <span class="user-info-value">@item.Item2</span>
                    </div>
                }
                <div class="user-roles-row">
                    <span class="user-info-label">Roles</span>
                    <span>
                        @foreach (var r in roles)
                        {
                            <span class="badge-tp @(r == "admin" ? "info" : r == "agent" ? "success" : "default") user-roles-badge">
                                @r
                            </span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="tp-card mb-3">
            <div class="tp-card-header">
                <span class="tp-card-title">KYC Documents</span>
                @if (kyc != null)
                {
                    <span class="badge-tp @(kyc.Status == MoneyTransfer.Models.KYCStatus.Approved ? "success" : kyc.Status == MoneyTransfer.Models.KYCStatus.Pending ? "warning" : "danger") kyc-status-badge">
                        @kyc.Status
                    </span>
                }
            </div>
            @if (kyc != null)
            {
                <div class="kyc-document-type">
                    <strong>@kyc.DocumentType</strong>
                    — @kyc.DocumentNumber
                </div>
                <div class="kyc-documents-container">
                    @if (!string.IsNullOrEmpty(kyc.FrontImageUrl))
                    {
                        <a href="@kyc.FrontImageUrl" target="_blank">
                            <img src="@kyc.FrontImageUrl" class="kyc-document-image" />
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(kyc.BackImageUrl))
                    {
                        <a href="@kyc.BackImageUrl" target="_blank">
                            <img src="@kyc.BackImageUrl" class="kyc-document-image" />
                        </a>
                    }
                </div>
                @if (kyc.Status == MoneyTransfer.Models.KYCStatus.Pending)
                {
                    <div class="kyc-actions">
                        <form asp-controller="Admin" asp-action="ApproveKYC" asp-route-id="@kyc.Id" method="post">
                            <button type="submit" class="btn-tp-success kyc-approve-btn">
                                Approve
                            </button>
                        </form>
                        <form asp-controller="Admin" asp-action="RejectKYC" asp-route-id="@kyc.Id" method="post" class="kyc-reject-form">
                            <input type="text" name="reason" class="form-control kyc-reject-input" placeholder="Rejection reason" />
                            <button type="submit" class="btn-tp-danger kyc-reject-btn">Reject</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <p class="kyc-empty">No KYC submitted yet.</p>
            }
        </div>

        <div class="tp-card">
            <div class="tp-card-header">
                <span class="tp-card-title">Wallets</span>
            </div>
            @if (wallets.Any())
            {
                @foreach (var w in wallets)
                {
                    <div class="wallet-card @(w.IsDefault ? "default" : "") user-wallet-card">
                        <div class="user-wallet-header">
                            <div class="wallet-currency">@w.Currency?.Code</div>
                            @if (w.IsDefault)
                            {
                                <span class="badge-tp success user-wallet-default-badge">Default</span>
                            }
                        </div>
                        <div class="wallet-balance">@w.Currency?.Symbol@w.Balance.ToString("N2")</div>
                        <div class="wallet-serial">@w.SerialNumber</div>
                    </div>
                }
            }
            else
            {
                <p class="user-wallet-empty">No wallets yet.</p>
            }
        </div>
    </div>
</div>