@model List<MoneyTransfer.Models.Agent>
@{
    ViewData["Title"] = "Manage Agent Commissions";
    ViewBag.PageClass = "page-admin";
    var defaultRate = ViewBag.DefaultCommissionRate as decimal? ?? 0.02m;
}

<style>
    .stat-card {
        background: var(--bg-1);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            border-color: var(--cedar-gold);
            transform: translateY(-2px);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

        .stat-icon.earnings {
            background: rgba(0,184,148,0.1);
            color: #00b894;
        }

    .stat-info {
        flex: 1;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-1);
    }

    .stat-label {
        font-size: 13px;
        color: var(--text-3);
        margin-top: 4px;
    }

    .filter-bar {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
        flex-wrap: wrap;
        align-items: center;
    }

        .filter-bar input {
            flex: 1;
            min-width: 200px;
        }

    .commission-rate-cell {
        font-weight: 600;
    }

    .edit-form {
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .edit-form input {
            width: 80px;
            padding: 6px 8px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--bg-2);
            color: var(--text-1);
        }

    .save-rate-btn {
        padding: 6px 12px;
        background: var(--teal);
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .save-rate-btn:hover {
            background: #00a884;
            transform: translateY(-1px);
        }

    .edit-rate-btn {
        padding: 6px 12px;
        background: var(--bg-2);
        border: 1px solid var(--border);
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .edit-rate-btn:hover {
            border-color: var(--teal);
            color: var(--teal);
        }

    .current-rate {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .rate-badge {
        background: var(--teal);
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    .default-rate-card {
        margin-bottom: 24px;
    }

    .default-rate-form {
        display: flex;
        gap: 12px;
        align-items: flex-end;
    }

        .default-rate-form .form-group {
            flex: 1;
        }
</style>

<div class="page-header">
    <div>
        <h2><i class="bi bi-percent"></i> Manage Agent Commissions</h2>
        <p>Set commission rates for each agent store</p>
    </div>
    <a asp-action="EarningsReport" class="btn-tp-secondary">
        <i class="bi bi-arrow-left"></i> Back to Earnings
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon earnings"><i class="bi bi-shop"></i></div>
            <div class="stat-info">
                <div class="stat-value">@Model.Count</div>
                <div class="stat-label">Active Agents</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon earnings"><i class="bi bi-percent"></i></div>
            <div class="stat-info">
                <div class="stat-value">@((defaultRate * 100).ToString("F1"))%</div>
                <div class="stat-label">Default Rate</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon earnings"><i class="bi bi-cash-stack"></i></div>
            <div class="stat-info">
                <div class="stat-value">
                    $@{
                    var totalCommissions = Model.Sum(a => a.Commissions?.Sum(c => c.Amount) ?? 0);
                    @totalCommissions.ToString("N2")
                                        }
                </div>
                <div class="stat-label">Total Commissions Paid</div>
            </div>
        </div>
    </div>
</div>

<div class="tp-card default-rate-card">
    <div class="tp-card-header">
        <span class="tp-card-title">
            <i class="bi bi-gear"></i> Default Commission Rate
        </span>
        <span class="text-muted">New agents will automatically receive this rate</span>
    </div>
    <div class="card-body">
        <form asp-action="UpdateDefaultCommissionRate" method="post" class="default-rate-form">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Default Rate (%)</label>
                <input type="number" name="defaultRate" class="form-control" step="0.01" min="0" max="1" value="@defaultRate" required />
                <small class="text-muted">Enter as decimal (e.g., 0.02 = 2%)</small>
            </div>
            <button type="submit" class="btn-tp-primary">
                <i class="bi bi-save"></i> Update Default Rate
            </button>
        </form>
    </div>
</div>

<div class="tp-card">
    <div class="tp-card-header">
        <span class="tp-card-title">
            <i class="bi bi-people"></i> Agent Commission Rates
        </span>
        <div class="filter-bar" style="margin-bottom: 0;">
            <input type="text" id="searchAgents" class="form-control" placeholder="Search by store name..." onkeyup="filterAgents()">
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p>No approved agents found.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="tp-table" id="agentsTable">
                <thead>
                    <tr>
                        <th>Store Name</th>
                        <th>Agent Name</th>
                        <th>City</th>
                        <th>Current Rate</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agent in Model)
                    {
                        <tr data-store="@agent.StoreName.ToLower()" data-agent="@agent.AgentName.ToLower()" data-city="@agent.City?.ToLower()">
                            <td class="fw-bold">@agent.StoreName</td>
                            <td>@agent.AgentName</td>
                            <td>@(string.IsNullOrEmpty(agent.City) ? "—" : agent.City)</td>
                            <td class="commission-rate-cell">
                                <div id="display-@agent.Id" class="current-rate">
                                    <span class="rate-badge">@((agent.CommissionRate * 100).ToString("F1"))%</span>
                                    <button type="button" class="edit-rate-btn" onclick="showEditForm(@agent.Id, @(agent.CommissionRate.ToString(System.Globalization.CultureInfo.InvariantCulture)))">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                </div>
                                <div id="edit-@agent.Id" style="display: none;">
                                    <form asp-action="UpdateCommissionRate" method="post" class="edit-form" onsubmit="return validateRate(this)">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="agentId" value="@agent.Id" />
                                        <input type="number" name="commissionRate" class="form-control" step="0.01" min="0" max="1" value="@agent.CommissionRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                                        <button type="submit" class="save-rate-btn">
                                            <i class="bi bi-check-lg"></i> Save
                                        </button>
                                        <button type="button" class="edit-rate-btn" onclick="cancelEdit(@agent.Id)">
                                            <i class="bi bi-x-lg"></i> Cancel
                                        </button>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <a asp-controller="Admin" asp-action="UserDetails" asp-route-userId="@agent.UserId" class="btn-tp-secondary btn-sm" title="View User">
                                    <i class="bi bi-person"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
    function showEditForm(agentId, currentRate) {
        document.getElementById('display-' + agentId).style.display = 'none';
        document.getElementById('edit-' + agentId).style.display = 'block';
    }

    function cancelEdit(agentId) {
        document.getElementById('display-' + agentId).style.display = 'flex';
        document.getElementById('edit-' + agentId).style.display = 'none';
    }

    function validateRate(form) {
        var rateInput = form.querySelector('input[name="commissionRate"]');
        var rate = parseFloat(rateInput.value);
        if (isNaN(rate) || rate < 0 || rate > 1) {
            alert('Commission rate must be between 0% and 100% (0 to 1 as decimal)');
            return false;
        }
        return confirm('Are you sure you want to change this agent\'s commission rate to ' + (rate * 100).toFixed(1) + '%?');
    }

    function filterAgents() {
        var searchTerm = document.getElementById('searchAgents').value.toLowerCase();
        var rows = document.querySelectorAll('#agentsTable tbody tr');

        rows.forEach(row => {
            var store = row.getAttribute('data-store') || '';
            var agent = row.getAttribute('data-agent') || '';
            var city = row.getAttribute('data-city') || '';

            if (store.includes(searchTerm) || agent.includes(searchTerm) || city.includes(searchTerm)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>