@model List<MoneyTransfer.Models.Conversation>
@{
    ViewData["Title"] = "Messages";
    ViewBag.PageClass = "page-chat";
    string currentUserId = ViewBag.CurrentUserId ?? "";
}

<div class="page-header">
    <div>
        <h2>Messages</h2>
        <p>Your conversations</p>
    </div>
    <a asp-action="New" class="btn-tp-primary">
        <i class="bi bi-pencil-square"></i> New Chat
    </a>
</div>

<!-- Bot Assistant Card -->
<div class="tp-card chat-bot-card">
    <div class="chat-bot-content">
        <div class="chat-bot-info">
            <div class="chat-bot-avatar">🤖</div>
            <div>
                <div class="chat-bot-name">CedarPay Assistant</div>
                <div class="chat-bot-desc">Ask me anything about CedarPay</div>
            </div>
        </div>
        <a asp-controller="Bot" asp-action="Chat" class="btn-tp-primary">
            <i class="bi bi-chat-dots"></i> Chat with Bot
        </a>
    </div>
</div>

<!-- Search conversations -->
<div class="tp-card mb-3">
    <div class="chat-search-bar">
        <i class="bi bi-search chat-search-icon"></i>
        <input type="text"
               id="chatSearch"
               class="form-control chat-search-input"
               placeholder="Search chats by name..."
               oninput="filterChats(this.value)" />
        <button onclick="document.getElementById('chatSearch').value='';filterChats('')"
                id="clearSearch"
                class="chat-search-clear">
            <i class="bi bi-x"></i>
        </button>
    </div>
</div>

@{
    var benefsNotInChat =
        ViewBag.BeneficiariesNotInChat
        as List<MoneyTransfer.Models.Beneficiary>
        ?? new List<MoneyTransfer.Models.Beneficiary>();
}

@if (benefsNotInChat.Any())
{
    <div class="tp-card mb-3">
        <div class="chat-beneficiaries-header">
            <i class="bi bi-people-fill"></i>
            Start a chat with a beneficiary
        </div>
        <div class="chat-beneficiaries-list">
            @foreach (var b in benefsNotInChat)
            {
                <form asp-action="FindAndStart" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="phoneNumber" value="@b.ReceiverPhoneNumber" />
                    <button type="submit" class="chat-beneficiary-btn">
                        <div class="chat-beneficiary-avatar">
                            @(b.Nickname?.Substring(0, 1).ToUpper() ?? "?")
                        </div>
                        @b.Nickname
                    </button>
                </form>
            }
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-chat-dots"></i>
            <p>No conversations yet.</p>
            <a asp-action="New" class="btn-tp-primary">
                <i class="bi bi-plus"></i> Start a Chat
            </a>
        </div>
    </div>
}
else
{
    <div class="tp-card" style="padding:0;overflow:hidden">
        @foreach (var c in Model)
        {
            var other = c.Participants.FirstOrDefault(p => p.UserId != currentUserId);
            var lastMsg = c.Messages.OrderByDescending(m => m.SentAt).FirstOrDefault();
            var unread = c.Messages.Count(m => !m.IsRead && m.SenderId != currentUserId);
            var otherName = $"{other?.User?.FirstName} {other?.User?.LastName}";

            <div class="chat-list-item" data-name="@otherName">

                <a asp-action="Open" asp-route-id="@c.Id"
                   class="chat-link @(unread > 0 ? "unread" : "")"
                   onmouseover="this.style.background='var(--surface-2)'"
                   onmouseout="this.style.background='@(unread > 0 ? "rgba(0,184,148,0.04)" : "transparent")'">

                    <div class="chat-avatar-wrapper">
                        @if (!string.IsNullOrEmpty(other?.User?.ProfilePictureUrl))
                        {
                            <img src="@other.User.ProfilePictureUrl" class="chat-avatar-img" />
                        }
                        else
                        {
                            <div class="chat-avatar-initials">
                                @(other?.User?.FirstName?.Substring(0, 1) ?? "?")
                            </div>
                        }
                        @if (unread > 0)
                        {
                            <div class="chat-unread-badge">
                                @(unread > 9 ? "9+" : unread.ToString())
                            </div>
                        }
                    </div>

                    <div class="chat-info">
                        <div class="chat-header-row">
                            <div class="chat-name @(unread > 0 ? "unread" : "read")">
                                @(other?.User?.FirstName) @(other?.User?.LastName)
                            </div>
                            <div class="chat-time">@(lastMsg?.SentAt.ToString("HH:mm") ?? "")</div>
                        </div>
                        <div class="chat-last-message @(unread > 0 ? "unread" : "read")">
                            @if (lastMsg != null)
                            {
                                if (lastMsg.SenderId == currentUserId)
                                {
                                    <text>You: </text>
                                }
                                @(lastMsg.MessageType != MoneyTransfer.Models.MessageType.Text ? "📎 " + lastMsg.MediaFileName : lastMsg.Content)
                            }
                            else
                            {
                                <text>No messages yet</text>
                            }
                        </div>
                    </div>
                </a>

                <!-- Delete button -->
                <button onclick="confirmDelete(@c.Id, '@Html.Raw(otherName.Replace("'", "\\'"))', event)"
                        class="delete-conv-btn"
                        title="Delete conversation">
                    <i class="bi bi-trash"></i>
                </button>

                <!-- Hidden delete form -->
                <form id="delForm-@c.Id" asp-action="DeleteConversation" method="post" style="display:none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@c.Id" />
                </form>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function filterChats(q) {
            const lower = q.toLowerCase().trim();
            const clearBtn = document.getElementById('clearSearch');
            if (clearBtn) clearBtn.style.display = lower ? 'block' : 'none';

            let anyVisible = false;
            document.querySelectorAll('.chat-list-item').forEach(item => {
                const name = (item.dataset.name || '').toLowerCase();
                const show = !lower || name.includes(lower);
                item.style.display = show ? '' : 'none';
                if (show) anyVisible = true;
            });

            // Show/hide empty state for search
            let noResult = document.getElementById('noSearchResult');
            if (!noResult) {
                noResult = document.createElement('div');
                noResult.id = 'noSearchResult';
                noResult.className = 'chat-no-result';
                noResult.innerHTML = '<i class="bi bi-search"></i>No chats found';
                const list = document.querySelector('.tp-card:last-of-type');
                if (list) list.appendChild(noResult);
            }
            noResult.style.display = lower && !anyVisible ? 'block' : 'none';
        }

        function confirmDelete(convId, name, e) {
            e.preventDefault();
            e.stopPropagation();
            if (confirm(`Delete your conversation with ${name}?\n\nThis will delete all messages for both users.`)) {
                document.getElementById(`delForm-${convId}`).submit();
            }
        }
    </script>
}