@model List<MoneyTransfer.Models.Conversation>
@{
    ViewData["Title"] = "Messages";
    string currentUserId = ViewBag.CurrentUserId ?? "";
}

<style>
    .chat-list-item:hover .delete-conv-btn {
        opacity: 1 !important;
    }
</style>

<div class="page-header">
    <div>
        <h2>Messages</h2>
        <p>Your conversations</p>
    </div>
    <a asp-action="New" class="btn-tp-primary">
        <i class="bi bi-pencil-square"></i> New Chat
    </a>
</div>

<!-- Bot Assistant Card -->
<div class="tp-card mb-3">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px">
        <div style="display:flex;align-items:center;gap:14px">
            <div style="width:48px;height:48px;border-radius:50%;
                        background:linear-gradient(135deg,var(--teal),var(--teal-mid));
                        display:flex;align-items:center;justify-content:center;
                        font-size:24px;color:#fff">
                🤖
            </div>
            <div>
                <div style="font-size:15px;font-weight:700;color:var(--text-1)">
                    CedarPay Assistant
                </div>
                <div style="font-size:12px;color:var(--text-3)">
                    Ask me anything about CedarPay
                </div>
            </div>
        </div>
        <a asp-controller="Bot" asp-action="Chat" class="btn-tp-primary">
            <i class="bi bi-chat-dots"></i> Chat with Bot
        </a>
    </div>
</div>

<!-- Search conversations - UPDATED -->
<div class="tp-card mb-3">
    <div style="display:flex;gap:10px;align-items:center">
        <i class="bi bi-search" style="color:var(--text-3);flex-shrink:0"></i>
        <input type="text"
               id="chatSearch"
               class="form-control"
               placeholder="Search chats by name..."
               style="border:none;box-shadow:none;padding:0;background:transparent"
               oninput="filterChats(this.value)" />
        <button onclick="document.getElementById('chatSearch').value='';filterChats('')"
                id="clearSearch"
                style="display:none;background:none;border:none;
                       cursor:pointer;color:var(--text-3);
                       font-size:16px;padding:0;flex-shrink:0">
            <i class="bi bi-x"></i>
        </button>
    </div>
</div>

@{
    var benefsNotInChat =
        ViewBag.BeneficiariesNotInChat
        as List<MoneyTransfer.Models.Beneficiary>
        ?? new List<MoneyTransfer.Models.Beneficiary>();
}

@if (benefsNotInChat.Any())
{
    <div class="tp-card mb-3">
        <div style="font-size:13px;font-weight:700;
                            color:var(--text-1);margin-bottom:12px">
            <i class="bi bi-people-fill"
               style="color:var(--teal);margin-right:6px"></i>
            Start a chat with a beneficiary
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
            @foreach (var b in benefsNotInChat)
            {
                <form asp-action="FindAndStart"
                      method="post"
                      style="display:inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           name="phoneNumber"
                           value="@b.ReceiverPhoneNumber" />
                    <button type="submit"
                            style="display:flex;
                                                   align-items:center;
                                                   gap:8px;
                                                   padding:8px 14px;
                                                   border-radius:20px;
                                                   border:1px solid var(--border);
                                                   background:var(--surface-2);
                                                   cursor:pointer;
                                                   transition:var(--transition);
                                                   font-size:13px;
                                                   color:var(--text-1)"
                            onmouseover="this.style.background='var(--teal-light)';this.style.borderColor='var(--teal)'"
                            onmouseout="this.style.background='var(--surface-2)';this.style.borderColor='var(--border)'">
                        <div style="width:28px;height:28px;
                                                    border-radius:50%;
                                                    background:var(--teal-light);
                                                    display:flex;
                                                    align-items:center;
                                                    justify-content:center;
                                                    font-size:11px;
                                                    font-weight:700;
                                                    color:var(--teal)">
                            @(b.Nickname?.Substring(0, 1).ToUpper() ?? "?")
                        </div>
                        @b.Nickname
                    </button>
                </form>
            }
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-chat-dots"
               style="font-size:48px;opacity:.3;
                              display:block;margin-bottom:12px"></i>
            <p>No conversations yet.</p>
            <a asp-action="New" class="btn-tp-primary">
                <i class="bi bi-plus"></i> Start a Chat
            </a>
        </div>
    </div>
}
else
{
    <div class="tp-card" style="padding:0;overflow:hidden">
        @foreach (var c in Model)
        {
            var other = c.Participants
            .FirstOrDefault(p => p.UserId != currentUserId);
            var lastMsg = c.Messages
            .OrderByDescending(m => m.SentAt).FirstOrDefault();
            var unread = c.Messages
            .Count(m => !m.IsRead && m.SenderId != currentUserId);
            var otherName =
            $"{other?.User?.FirstName} {other?.User?.LastName}";

            <div style="position:relative;
                                border-bottom:1px solid var(--border)"
                 class="chat-list-item"
                 data-name="@otherName">

                <a asp-action="Open" asp-route-id="@c.Id"
                   style="display:flex;align-items:center;
                                  gap:14px;padding:14px 20px;
                                  padding-right:52px;
                                  text-decoration:none;
                                  transition:all .15s;
                                  background:@(unread > 0 ? "rgba(0,184,148,0.04)" : "transparent")"
                   onmouseover="this.style.background='var(--surface-2)'"
                   onmouseout="this.style.background='@(unread > 0 ? "rgba(0,184,148,0.04)" : "transparent")'">

                    <div style="flex-shrink:0;position:relative">
                        @if (!string.IsNullOrEmpty(other?.User?.ProfilePictureUrl))
                        {
                            <img src="@other.User.ProfilePictureUrl"
                                 style="width:48px;height:48px;
                                                    border-radius:50%;
                                                    object-fit:cover" />
                        }
                        else
                        {
                            <div style="width:48px;height:48px;
                                                    border-radius:50%;
                                                    background:linear-gradient(135deg,
                                                        var(--teal),var(--teal-mid));
                                                    display:flex;align-items:center;
                                                    justify-content:center;
                                                    font-size:16px;font-weight:700;
                                                    color:#fff">
                                @(other?.User?.FirstName?.Substring(0, 1) ?? "?")
                            </div>
                        }
                        @if (unread > 0)
                        {
                            <div style="position:absolute;top:-2px;right:-2px;
                                                    width:18px;height:18px;
                                                    background:var(--teal);
                                                    border-radius:50%;font-size:10px;
                                                    font-weight:700;color:#fff;
                                                    display:flex;align-items:center;
                                                    justify-content:center;
                                                    border:2px solid var(--surface)">
                                @(unread > 9 ? "9+" : unread.ToString())
                            </div>
                        }
                    </div>

                    <div style="flex:1;min-width:0">
                        <div style="display:flex;
                                            justify-content:space-between;
                                            align-items:center;
                                            margin-bottom:2px">
                            <div style="font-weight:@(unread > 0 ? "700" : "600");
                                                color:var(--text-1);font-size:14px">
                                @(other?.User?.FirstName)
                                @(other?.User?.LastName)
                            </div>
                            <div style="font-size:11px;color:var(--text-3)">
                                @(lastMsg?.SentAt.ToString("HH:mm") ?? "")
                            </div>
                        </div>
                        <div style="font-size:13px;
                                            color:@(unread > 0 ? "var(--text-1)" : "var(--text-3)");
                                            font-weight:@(unread > 0 ? "500" : "400");
                                            white-space:nowrap;overflow:hidden;
                                            text-overflow:ellipsis">
                            @if (lastMsg != null)
                            {
                                if (lastMsg.SenderId == currentUserId)
                                {
                                    <text>You: </text>
                                }
                            @(lastMsg.MessageType !=
                                                MoneyTransfer.Models.MessageType.Text
                                                ? "📎 " + lastMsg.MediaFileName
                                                : lastMsg.Content)
                                        }
                            else
                            {
                                <text>No messages yet</text>
                            }
                        </div>
                    </div>
                </a>

                <!-- Delete button -->
                <button onclick="confirmDelete(@c.Id,
                                    '@Html.Raw(otherName.Replace("'", "\\'"))',
                                    event)"
                        style="position:absolute;right:14px;top:50%;
                                       transform:translateY(-50%);
                                       width:32px;height:32px;border-radius:50%;
                                       background:transparent;border:none;
                                       cursor:pointer;
                                       display:flex;align-items:center;
                                       justify-content:center;
                                       color:var(--text-3);font-size:14px;
                                       opacity:0;transition:opacity .15s,
                                           background .15s;z-index:2"
                        class="delete-conv-btn"
                        title="Delete conversation">
                    <i class="bi bi-trash"></i>
                </button>

                <!-- Hidden delete form -->
                <form id="delForm-@c.Id"
                      asp-action="DeleteConversation"
                      method="post"
                      style="display:none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@c.Id" />
                </form>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function filterChats(q) {
            const lower = q.toLowerCase().trim();
            const clearBtn = document.getElementById('clearSearch');
            if (clearBtn)
                clearBtn.style.display = lower ? 'block' : 'none';

            let anyVisible = false;
            document.querySelectorAll('.chat-list-item')
                .forEach(item => {
                    const name = (item.dataset.name || '').toLowerCase();
                    const show = !lower || name.includes(lower);
                    item.style.display = show ? '' : 'none';
                    if (show) anyVisible = true;
                });

            // Show/hide empty state for search
            let noResult = document.getElementById('noSearchResult');
            if (!noResult) {
                noResult = document.createElement('div');
                noResult.id = 'noSearchResult';
                noResult.style.cssText = 'padding:24px;text-align:center;color:var(--text-3);font-size:13px';
                noResult.innerHTML = '<i class="bi bi-search" style="font-size:24px;display:block;margin-bottom:8px;opacity:.4"></i>No chats found';
                const list = document.querySelector('.tp-card:last-of-type');
                if (list) list.appendChild(noResult);
            }
            noResult.style.display = lower && !anyVisible ? 'block' : 'none';
        }

        function confirmDelete(convId, name, e) {
            e.preventDefault();
            e.stopPropagation();
            if (confirm(`Delete your conversation with ${name}?\n\nThis will delete all messages for both users.`)) {
                document.getElementById(`delForm-${convId}`).submit();
            }
        }
    </script>
}