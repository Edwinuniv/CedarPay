@functions {
    string FormatBotMessage(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        text = System.Net.WebUtility.HtmlEncode(text);
        text = System.Text.RegularExpressions.Regex.Replace(
            text, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        var lines = text.Split('\n');
        var result = new System.Text.StringBuilder();
        bool inList = false;

        foreach (var line in lines)
        {
            var trimmed = line.Trim();
            bool isBullet = trimmed.StartsWith("•") ||
                            trimmed.StartsWith("-") ||
                            trimmed.StartsWith("*");

            if (isBullet)
            {
                if (!inList)
                {
                    result.Append("<ul style='margin:6px 0 6px 16px;padding:0;list-style:none'>");
                    inList = true;
                }
                var content = trimmed.TrimStart('•', '-', '*', ' ');
                result.Append($"<li style='margin-bottom:3px;display:flex;gap:6px'>" +
                              $"<span style='color:var(--teal);flex-shrink:0'>›</span>" +
                              $"<span>{content}</span></li>");
            }
            else
            {
                if (inList)
                {
                    result.Append("</ul>");
                    inList = false;
                }
                if (!string.IsNullOrWhiteSpace(trimmed))
                    result.Append(
                        $"<p style='margin:0 0 6px'>{trimmed}</p>");
                else
                    result.Append("<br/>");
            }
        }

        if (inList) result.Append("</ul>");
        return result.ToString();
    }
}

@section Scripts {
    <form id="csrfForm" style="display:none">
        @Html.AntiForgeryToken()
    </form>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        const convId = @Model.Id;
        const myUserId = '@ViewBag.CurrentUserId';
        const isBotChat = @(isBotChat ? "true" : "false");
        const otherName = '@(other?.User?.FirstName ?? (isBotChat ? "Cedar Bot" : "User"))';
        const token = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value;
        const area = document.getElementById('msgArea');

        function scrollDown() {
            if (area) area.scrollTop = area.scrollHeight;
        }
        scrollDown();

        function openLightbox(src) {
            document.getElementById('lbImg').src = src;
            document.getElementById('lightbox').classList.add('open');
        }
        function closeLightbox() {
            document.getElementById('lightbox').classList.remove('open');
        }
        document.getElementById('lightbox')?.addEventListener('click', function(e) {
            if (e.target.id === 'lightbox') closeLightbox();
        });

        function onFileSelected(inp) {
            const f = inp.files[0];
            if (!f) return;
            document.getElementById('attachName').textContent = f.name;
            const sz = f.size < 1024 ? f.size + 'B'
                : f.size < 1048576 ? (f.size / 1024).toFixed(1) + 'KB'
                : (f.size / 1048576).toFixed(1) + 'MB';
            document.getElementById('attachSize').textContent = sz;
            document.getElementById('attachBar').classList.add('open');
            const dt = new DataTransfer();
            dt.items.add(f);
            document.getElementById('fileFormInput').files = dt.files;
        }

        function clearAttach() {
            document.getElementById('fileIn').value = '';
            document.getElementById('fileFormInput').files = new DataTransfer().files;
            document.getElementById('attachBar').classList.remove('open');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.emoji-picker-popup') &&
                !e.target.closest('.msg-action-btn')) {
                document.querySelectorAll('.emoji-picker-popup')
                    .forEach(function(p) { p.classList.remove('open'); });
            }
            if (!e.target.closest('#inputEmojiPicker') &&
                !e.target.closest('#inputEmojiBtn')) {
                document.getElementById('inputEmojiPicker')?.classList.remove('open');
            }
            if (!e.target.closest('#ctxMenu')) {
                document.getElementById('ctxMenu').classList.remove('open');
            }
        });

        function toggleEmojiPicker(e, msgId) {
            e.stopPropagation();
            const p = document.getElementById('ep-' + msgId);
            const was = p.classList.contains('open');
            document.querySelectorAll('.emoji-picker-popup')
                .forEach(function(x) { x.classList.remove('open'); });
            if (!was) p.classList.add('open');
        }

        async function reactTo(msgId, emoji, e) {
            if (e) e.stopPropagation();
            document.getElementById('ep-' + msgId)?.classList.remove('open');
            const res = await fetch('/Chat/ReactToMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'messageId=' + msgId + '&emoji=' + encodeURIComponent(emoji)
            });
            if (res.ok) {
                const data = await res.json();
                renderReactions(msgId, data.counts);
            }
        }

        function renderReactions(msgId, counts) {
            const strip = document.getElementById('reactions-' + msgId);
            if (!strip) return;
            strip.innerHTML = '';
            (counts || []).forEach(function(r) {
                const btn = document.createElement('button');
                btn.className = 'reaction-pill';
                btn.onclick = function(e) { reactTo(msgId, r.emoji, e); };
                btn.innerHTML = r.emoji + ' <span class="cnt">' + r.count + '</span>';
                strip.appendChild(btn);
            });
        }

        function toggleInputEmoji(e) {
            e.stopPropagation();
            document.getElementById('inputEmojiPicker').classList.toggle('open');
        }

        function insertEmoji(em) {
            const inp = document.getElementById('msgInput');
            const s = inp.selectionStart, en = inp.selectionEnd;
            inp.value = inp.value.slice(0, s) + em + inp.value.slice(en);
            inp.selectionStart = inp.selectionEnd = s + em.length;
            inp.focus();
            document.getElementById('inputEmojiPicker').classList.remove('open');
        }

        function setReply(msgId, name, preview) {
            document.getElementById('replyBar').classList.add('open');
            document.getElementById('replyToName').textContent = name;
            document.getElementById('replyToContent').textContent = preview;
            document.getElementById('msgInput').dataset.replyTo = msgId;
            document.getElementById('msgInput').focus();
        }

        function clearReply() {
            document.getElementById('replyBar').classList.remove('open');
            delete document.getElementById('msgInput').dataset.replyTo;
        }

        let editId = null;

        function openEditModal(msgId, current) {
            editId = msgId;
            document.getElementById('editContent').value = current;
            document.getElementById('editOverlay').classList.add('open');
            setTimeout(function() { document.getElementById('editContent').focus(); }, 50);
        }

        function closeEdit() {
            document.getElementById('editOverlay').classList.remove('open');
            editId = null;
        }

        async function submitEdit() {
            const nc = document.getElementById('editContent').value.trim();
            if (!nc || !editId) return;
            const res = await fetch('/Chat/EditMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'messageId=' + editId + '&newContent=' + encodeURIComponent(nc)
            });
            if (res.ok) {
                document.getElementById('bubble-' + editId).textContent = nc;
                closeEdit();
            }
        }

        document.getElementById('editContent')?.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && e.ctrlKey) submitEdit();
            if (e.key === 'Escape') closeEdit();
        });

        let ctxId = null;

        function openDeleteMenu(e, msgId) {
            e.preventDefault();
            e.stopPropagation();
            ctxId = msgId;
            const m = document.getElementById('ctxMenu');
            m.classList.add('open');
            m.style.top = e.clientY + 'px';
            m.style.left = e.clientX + 'px';
        }

        async function deleteMsg(msgId, type) {
            document.getElementById('ctxMenu').classList.remove('open');
            const res = await fetch('/Chat/DeleteMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'messageId=' + msgId + '&deleteType=' + type
            });
            if (res.ok) {
                if (type === 'me') {
                    const el = document.getElementById('msg-' + msgId);
                    if (el) {
                        el.classList.add('msg-deleting');
                        setTimeout(function() { el.remove(); }, 200);
                    }
                } else {
                    const b = document.getElementById('bubble-' + msgId);
                    if (b) b.innerHTML = '<span class="deleted-msg">🚫 This message was deleted.</span>';
                }
            }
        }

                async function sendText(content, replyToId) {
            const inp = document.getElementById('msgInput');
            const btn = document.getElementById('sendBtn');
            inp.disabled = true;
            btn.disabled = true;
            btn.style.opacity = '0.6';

            try {
                const fd = new FormData();
                fd.append('conversationId', convId);
                fd.append('content', content);
                if (replyToId) fd.append('replyToId', replyToId);
                fd.append('__RequestVerificationToken', token);

                const res = await fetch('/Chat/Send', {
                    method:  'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body:    fd
                });

                if (res.ok) {
                    const data = await res.json();
                    if (data.success) {
                        inp.value = '';
                        clearReply();
                        appendOwnBubble(content, data.sentAt, data.messageId);
                    }
                } else {
                    console.error('Send failed:', res.status);
                }
            } catch (err) {
                console.error('Send error:', err);
            } finally {
                inp.disabled    = false;
                btn.disabled    = false;
                btn.style.opacity = '1';
                inp.focus();
            }
        }

        function appendOwnBubble(content, sentAt, msgId) {
            const row = document.createElement('div');
            row.id = 'msg-' + (msgId || Date.now());
            row.className = 'msg-wrapper mine';

            row.innerHTML = `
                <div class="msg-bubble">
                    <div style="position:relative">
                        <div id="bubble-${msgId || Date.now()}"
                             class="bubble-inner bubble-mine"
                             style="word-break:break-word">
                            ${escHtml(content)}
                        </div>
                        <div class="msg-time mine">
                            ${sentAt || new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}
                            <span class="read-tick"
                                  style="color:var(--text-3)">✓</span>
                        </div>
                        <div class="reactions-strip"
                             id="reactions-${msgId || Date.now()}"
                             style="justify-content:flex-end"></div>
                    </div>
                </div>`;

            area.appendChild(row);
            scrollDown();
        }

        const sendBtn = document.getElementById('sendBtn');
        const msgInput = document.getElementById('msgInput');
        const msgForm = document.getElementById('csrfForm');

        if (sendBtn) {
            sendBtn.addEventListener('click', function(e) {
                if (isBotChat) {
                    document.getElementById('csrfForm').submit();
                    return;
                }
                const fi = document.getElementById('fileFormInput');
                if (fi && fi.files && fi.files.length) {
                    document.getElementById('fileReplyId').value = document.getElementById('msgInput').dataset.replyTo || '';
                    document.getElementById('fileForm').submit();
                    return;
                }
                const c = msgInput.value.trim();
                if (!c) return;
                const rid = msgInput.dataset.replyTo || '';
                sendText(c, rid);
            });
        }

        if (msgInput) {
            msgInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if (isBotChat) {
                        document.getElementById('csrfForm').submit();
                        return;
                    }
                    const fi = document.getElementById('fileFormInput');
                    if (fi && fi.files && fi.files.length) {
                        document.getElementById('fileReplyId').value = document.getElementById('msgInput').dataset.replyTo || '';
                        document.getElementById('fileForm').submit();
                        return;
                    }
                    const c = this.value.trim();
                    if (!c) return;
                    const rid = this.dataset.replyTo || '';
                    sendText(c, rid);
                }
            });
        }

        if (!isBotChat) {
            const conn = new signalR.HubConnectionBuilder()
                .withUrl('/chatHub')
                .withAutomaticReconnect()
                .build();

            conn.on('ReceiveMessage', function(data) {
                if (data.conversationId !== convId) return;
                if (data.senderId === myUserId) return;
                if (document.getElementById('msg-' + data.messageId)) return;

                const row = document.createElement('div');
                row.id = 'msg-' + data.messageId;
                row.className = 'msg-wrapper theirs';

                const av = document.createElement('div');
                av.className = 'msg-avatar-init';
                av.textContent = otherName.charAt(0).toUpperCase();

                const mt = (data.messageType || 'Text').toLowerCase();
                const pad = mt === 'text' ? 'bubble-inner' : 'bubble-inner media-pad';
                const replyHtml = data.replyPreview
                    ? '<div class="reply-preview"><strong>' + escHtml(data.replySender || '') + '</strong>' + escHtml(data.replyPreview) + '</div>'
                    : '';

                let content = '';
                if (mt === 'image') {
                    content = '<img src="' + escHtml(data.mediaUrl) + '" class="media-img" onclick="openLightbox(\'' + escHtml(data.mediaUrl) + '\')" />';
                } else if (mt === 'video') {
                    content = '<video class="media-video" controls preload="metadata"><source src="' + escHtml(data.mediaUrl) + '" /></video>';
                } else if (mt === 'voice') {
                    content = '<div style="padding:4px 8px"><div style="font-size:11px;opacity:.7;margin-bottom:4px">🎤 Voice message</div><audio controls><source src="' + escHtml(data.mediaUrl) + '" /></audio></div>';
                } else if (mt === 'file') {
                    content = '<a href="' + escHtml(data.mediaUrl) + '" download="' + escHtml(data.mediaFileName) + '" class="file-card"><div class="file-icon">📁</div><div class="file-info"><div class="fname">' + escHtml(data.mediaFileName) + '</div></div><i class="bi bi-download" style="font-size:16px;opacity:.7"></i></a>';
                } else {
                    content = escHtml(data.content);
                }

                const bub = document.createElement('div');
                bub.className = 'msg-bubble';
                bub.innerHTML = replyHtml + '<div style="position:relative"><div id="bubble-' + data.messageId + '" class="' + pad + ' bubble-theirs">' + content + '</div><div class="msg-time theirs">' + data.sentAt + '</div><div class="reactions-strip" id="reactions-' + data.messageId + '" style="justify-content:flex-start"></div></div>';

                row.appendChild(av);
                row.appendChild(bub);
                area.appendChild(row);
                scrollDown();
            });

            conn.on('MessageEdited', function(data) {
                const b = document.getElementById('bubble-' + data.messageId);
                if (b && !b.querySelector('.deleted-msg')) b.textContent = data.newContent;
            });

            conn.on('MessageDeleted', function(data) {
                if (data.deletedForEveryone) {
                    const b = document.getElementById('bubble-' + data.messageId);
                    if (b) b.innerHTML = '<span class="deleted-msg">🚫 This message was deleted.</span>';
                }
            });

            conn.on('ReactionUpdated', function(data) {
                renderReactions(data.messageId, data.counts);
            });

            conn.start()
                .then(function() { return conn.invoke('JoinConversation', convId); })
                .catch(console.error);
        }

        async function openProfile() {
            document.getElementById('profileOverlay').style.display = 'block';
            document.getElementById('profilePanel').style.right = '0';
            document.getElementById('profileLoading').style.display = 'flex';
            document.getElementById('profileContent').style.display = 'none';

            try {
                const res = await fetch('/Chat/ConversationProfile/' + convId);
                if (!res.ok) return;
                const d = await res.json();

                const av = document.getElementById('panelAvatar');
                if (d.profilePicture) {
                    av.innerHTML = '<img src="' + escHtml(d.profilePicture) + '" style="width:90px;height:90px;object-fit:cover" />';
                } else {
                    av.textContent = (d.firstName || '?').charAt(0).toUpperCase();
                }

                document.getElementById('panelName').textContent = (d.firstName || '') + ' ' + (d.lastName || '');
                document.getElementById('panelUsername').textContent = d.username ? '@@' + d.username : '';
                document.getElementById('panelVerified').style.display = d.isVerified ? 'block' : 'none';

                const bio = document.getElementById('panelBio');
                if (d.bio) {
                    bio.textContent = d.bio;
                    bio.style.display = 'block';
                }

                document.getElementById('panelPhone').textContent = d.phone || 'No phone';

                if (d.city || d.country) {
                    document.getElementById('panelLocRow').style.display = 'flex';
                    let locText = '';
                    if (d.city) locText += d.city;
                    if (d.country) {
                        if (locText) locText += ', ';
                        locText += d.country;
                    }
                    document.getElementById('panelLoc').textContent = locText;
                }
                document.getElementById('panelSince').textContent = 'Member since ' + (d.memberSince || 'recently');

                const grid = document.getElementById('panelImages');
                grid.innerHTML = '';
                const imgs = (d.images || []).slice(0, 9);
                if (imgs.length) {
                    imgs.forEach(function(img) {
                        const div = document.createElement('div');
                        div.style.cssText = 'aspect-ratio:1;border-radius:6px;overflow:hidden;cursor:pointer';
                        div.onclick = function() { openLightbox(img.mediaUrl); };
                        div.innerHTML = '<img src="' + escHtml(img.mediaUrl) + '" style="width:100%;height:100%;object-fit:cover" />';
                        grid.appendChild(div);
                    });
                    document.getElementById('panelNoMedia').style.display = 'none';
                } else {
                    document.getElementById('panelNoMedia').style.display = 'block';
                }

                const files = d.files || [];
                if (files.length) {
                    const fc = document.getElementById('panelFiles');
                    fc.innerHTML = '';
                    files.forEach(function(f) {
                        const parts = (f.mediaFileName || '').split('.');
                        const ext = parts.length > 1 ? parts.pop().toLowerCase() : '';
                        let ic = '📁';
                        if (ext === 'pdf') ic = '📄';
                        else if (ext === 'doc' || ext === 'docx') ic = '📝';
                        else if (ext === 'xls' || ext === 'xlsx') ic = '📊';
                        else if (ext === 'zip' || ext === 'rar') ic = '🗜️';
                        else if (ext === 'txt') ic = '📃';

                        let sz = '';
                        if (f.mediaFileSize) {
                            if (f.mediaFileSize < 1024) {
                                sz = f.mediaFileSize + 'B';
                            } else if (f.mediaFileSize < 1048576) {
                                sz = (f.mediaFileSize / 1024).toFixed(1) + 'KB';
                            } else {
                                sz = (f.mediaFileSize / 1048576).toFixed(1) + 'MB';
                            }
                        }

                        fc.innerHTML += '<a href="' + escHtml(f.mediaUrl) + '" download="' + escHtml(f.mediaFileName) + '" class="file-card" style="text-decoration:none;color:inherit"><div class="file-icon">' + ic + '</div><div class="file-info"><div class="fname">' + escHtml(f.mediaFileName || 'File') + '</div><div class="fsize">' + sz + '</div></div><i class="bi bi-download" style="font-size:15px;opacity:.6"></i></a>';
                    });
                    document.getElementById('panelFilesSection').style.display = 'block';
                }

                document.getElementById('profileLoading').style.display = 'none';
                document.getElementById('profileContent').style.display = 'block';
            } catch (err) {
                console.error(err);
                document.getElementById('profileLoading').innerHTML = '<div style="color:var(--red)">Failed to load profile</div>';
            }
        }

        function closeProfile() {
            document.getElementById('profilePanel').style.right = '-420px';
            document.getElementById('profileOverlay').style.display = 'none';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeProfile();
                closeLightbox();
                closeEdit();
            }
        });

        function escHtml(s) {
            if (!s) return '';
            return String(s).replace(/[&<>"']/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                if (m === '"') return '&quot;';
                if (m === "'") return '&#39;';
                return m;
            });
        }
    </script>
}