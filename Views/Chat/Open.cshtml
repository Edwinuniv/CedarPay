@model MoneyTransfer.Models.Conversation
@{
    ViewData["Title"] = "Chat";
    string currentUserId = ViewBag.CurrentUserId ?? "";
    var other = Model.Participants
        .FirstOrDefault(p => p.UserId != currentUserId);
}

<div style="display:flex;flex-direction:column;
            height:calc(100vh - 140px);
            max-width:800px;margin:0 auto">

    <div style="background:var(--surface);
                border:1px solid var(--border);
                border-radius:var(--r-lg) var(--r-lg) 0 0;
                padding:14px 20px;
                display:flex;align-items:center;gap:12px">
        <a asp-action="Index"
           style="color:var(--text-2);text-decoration:none;
                  margin-right:4px">
            <i class="bi bi-arrow-left"></i>
        </a>

        @if (!string.IsNullOrEmpty(
                other?.User?.ProfilePictureUrl))
        {
            <img src="@other.User.ProfilePictureUrl"
                 style="width:40px;height:40px;border-radius:50%;
                            object-fit:cover;flex-shrink:0" />
        }
        else
        {
            <div style="width:40px;height:40px;border-radius:50%;
                            background:linear-gradient(135deg,
                                var(--teal),var(--teal-mid));
                            display:flex;align-items:center;
                            justify-content:center;
                            font-size:15px;font-weight:700;
                            color:#fff;flex-shrink:0">
                @(other?.User?.FirstName?.Substring(0, 1) ?? "?")
            </div>
        }

        <div style="flex:1">
            <div style="font-weight:700;font-size:15px;
                        color:var(--text-1)">
                @other?.User?.FirstName @other?.User?.LastName
            </div>
            <div style="font-size:12px;color:var(--text-3)">
                @other?.User?.PhoneNumber
            </div>
        </div>
    </div>

    <div id="msgArea"
         style="flex:1;overflow-y:auto;
                background:var(--surface-2);
                padding:16px;
                display:flex;flex-direction:column;
                gap:6px;
                border-left:1px solid var(--border);
                border-right:1px solid var(--border)">

        @{
            DateTime? lastDate = null;
        }

        @foreach (var msg in Model.Messages
                .OrderBy(m => m.SentAt))
        {
            bool isMine = msg.SenderId == currentUserId;

            if (lastDate == null || lastDate.Value.Date != msg.SentAt.Date)
            {
                lastDate = msg.SentAt;
                <div style="text-align:center;margin:8px 0">
                    <span style="font-size:11px;
                                         color:var(--text-3);
                                         background:var(--surface-2);
                                         padding:3px 10px;
                                         border-radius:10px;
                                         border:1px solid var(--border)">
                        @msg.SentAt.ToString("MMMM dd, yyyy")
                    </span>
                </div>
            }

            <div style="display:flex;
                            justify-content:@(isMine ? "flex-end" : "flex-start");
                            align-items:flex-end;gap:6px">

                @if (!isMine)
                {
                    if (!string.IsNullOrEmpty(
                    msg.Sender?.ProfilePictureUrl))
                    {
                        <img src="@msg.Sender.ProfilePictureUrl"
                             style="width:28px;height:28px;
                                                border-radius:50%;
                                                object-fit:cover;flex-shrink:0;
                                                margin-bottom:2px" />
                    }
                    else
                    {
                        <div style="width:28px;height:28px;
                                                border-radius:50%;
                                                background:var(--teal-light);
                                                display:flex;align-items:center;
                                                justify-content:center;
                                                font-size:11px;font-weight:700;
                                                color:var(--teal);flex-shrink:0;
                                                margin-bottom:2px">
                            @(msg.Sender?.FirstName ?.Substring(0, 1) ?? "?")
            </div>
                    }
                }

                <div style="max-width:65%">
                    <div style="padding:9px 13px;
                                    border-radius:@(isMine ? "16px 16px 4px 16px" : "16px 16px 16px 4px");
                                background:@(isMine ? "var(--teal)" : "var(--surface)");
                                color:@(isMine ? "#fff" : "var(--text-1)");
                                border:@(isMine ? "none" : "1px solid var(--border)");
                                word-break:break-word">
                    @msg.Content
                </div>
                <div style="font-size:10px;
                                color:var(--text-3);
                                margin-top:2px;
                                text-align:@(isMine ? "right" : "left");
                                padding:0 4px">
                    @msg.SentAt.ToString("HH:mm")
                    @if (isMine)
                        {
                            <span style="margin-left:3px;
                                color:@(msg.IsRead  ? "var(--teal)" : "var(--text-3)")">
                        @(msg.IsRead ? "✓✓" : "✓")
                    </span>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!Model.Messages.Any())
        {
            <div style="text-align:center;margin:auto;
                            color:var(--text-3);font-size:13px">
                <i class="bi bi-chat-dots"
                   style="font-size:32px;display:block;
                              margin-bottom:8px;opacity:.4"></i>
                Say hi to @other?.User?.FirstName!
            </div>
        }
    </div>

    <div style="background:var(--surface);
                border:1px solid var(--border);
                border-radius:0 0 var(--r-lg) var(--r-lg);
                padding:12px 16px">
        <form asp-action="Send" method="post"
              style="display:flex;gap:10px;align-items:center">
            @Html.AntiForgeryToken()
            <input type="hidden" name="conversationId"
                   value="@Model.Id" />
            <input type="text" name="content"
                   id="msgInput"
                   class="form-control"
                   placeholder="Type a message..."
                   autocomplete="off"
                   style="flex:1;border-radius:20px;
                          padding:10px 16px" />
            <button type="submit"
                    style="width:42px;height:42px;
                           border-radius:50%;
                           background:var(--teal);
                           border:none;color:#fff;
                           font-size:16px;
                           display:flex;align-items:center;
                           justify-content:center;
                           cursor:pointer;flex-shrink:0;
                           transition:var(--transition)"
                    onmouseover="this.style.background='var(--teal-dark)'"
                    onmouseout="this.style.background='var(--teal)'">
                <i class="bi bi-send-fill"
                   style="margin-left:2px"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const area = document.getElementById('msgArea');
        if (area) area.scrollTop = area.scrollHeight;

        const input = document.getElementById('msgInput');
        if (input) {
            input.addEventListener('keypress', e => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    input.closest('form').submit();
                }
            });
        }
    </script>
}