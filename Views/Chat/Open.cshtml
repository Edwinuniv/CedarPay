@using System.IO
@model MoneyTransfer.Models.Conversation
@{
    ViewData["Title"] = "Chat";
    ViewBag.PageClass = "page-chat";
    string currentUserId = ViewBag.CurrentUserId ?? "";
    var other = Model.Participants.FirstOrDefault(p => p.UserId != currentUserId);
    bool isBotChat = ViewBag.IsBot == true;
}

@functions {
    string FormatBotMessage(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        text = System.Net.WebUtility.HtmlEncode(text);
        text = System.Text.RegularExpressions.Regex.Replace(
            text, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        var lines = text.Split('\n');
        var result = new System.Text.StringBuilder();
        bool inList = false;

        foreach (var line in lines)
        {
            var trimmed = line.Trim();
            bool isBullet = trimmed.StartsWith("•") ||
                            trimmed.StartsWith("-") ||
                            trimmed.StartsWith("*");

            if (isBullet)
            {
                if (!inList)
                {
                    result.Append("<ul class='bot-msg-list'>");
                    inList = true;
                }
                var content = trimmed.TrimStart('•', '-', '*', ' ');
                result.Append($"<li class='bot-msg-list-item'><span class='bot-msg-bullet'>›</span><span>{content}</span></li>");
            }
            else
            {
                if (inList)
                {
                    result.Append("</ul>");
                    inList = false;
                }
                if (!string.IsNullOrWhiteSpace(trimmed))
                    result.Append($"<p class='bot-msg-paragraph'>{trimmed}</p>");
                else
                    result.Append("<br/>");
            }
        }

        if (inList) result.Append("</ul>");
        return result.ToString();
    }
}

<div class="chat-shell">

    <div class="chat-header">
        <a asp-controller="Chat" asp-action="Index" class="chat-back">
            <i class="bi bi-arrow-left"></i>
        </a>

        @if (isBotChat)
        {
            <div class="chat-avatar bot-avatar">🤖</div>
            <div class="chat-header-info">
                <div class="chat-header-name">Cedar Bot</div>
                <div class="chat-header-status">
                    @{
                        var apiKey = ViewBag.GeminiApiKey as string;
                        bool isAiMode = !string.IsNullOrWhiteSpace(apiKey);
                    }
                    <span class="status-dot @(isAiMode ? "ai" : "basic")"></span>
                    @(isAiMode ? "AI Powered · Always online" : "Basic Mode · Always online")
                </div>
            </div>
        }
        else
        {
            <button type="button" class="chat-profile-btn" onclick="openProfile()">
                @if (!string.IsNullOrEmpty(other?.User?.ProfilePictureUrl))
                {
                    <img src="@other.User.ProfilePictureUrl" class="chat-avatar chat-avatar-img" />
                }
                else
                {
                    <div class="chat-avatar chat-avatar-initials">
                        @(other?.User?.FirstName?.Substring(0, 1) ?? "?")
                    </div>
                }
                <div class="chat-profile-info">
                    <div class="chat-profile-name">
                        @other?.User?.FirstName @other?.User?.LastName
                        @if (other?.User?.IsVerified == true)
                        {
                            <span class="verified-badge" title="Verified">✓</span>
                        }
                    </div>
                    <div class="chat-profile-phone">
                        @other?.User?.PhoneNumber
                    </div>
                </div>
            </button>
        }
    </div>

    <div class="chat-messages" id="msgArea">
        @{
            DateTime? lastDate = null;
        }

        @foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
        {
            bool isMine = isBotChat ? !msg.IsFromAdmin : msg.SenderId == currentUserId;
            bool hiddenForMe = !isBotChat && isMine && msg.IsDeletedForSender;
            if (hiddenForMe) continue;

            if (lastDate == null || lastDate.Value.Date != msg.SentAt.Date)
            {
                lastDate = msg.SentAt;
                <div class="date-sep">
                    <span>@msg.SentAt.ToString("MMMM dd, yyyy")</span>
                </div>
            }

            var rxGroups = msg.Reactions
            .GroupBy(r => r.Emoji)
            .Select(g => new
            {
                Emoji = g.Key,
                Count = g.Count(),
                IsMine = g.Any(r => r.UserId == currentUserId)
            }).ToList();

            <div id="msg-@msg.Id" class="msg-wrapper @(isMine ? "mine" : "theirs")">

                @if (!isMine && !isBotChat)
                {
                    if (!string.IsNullOrEmpty(msg.Sender?.ProfilePictureUrl))
                    {
                        <img src="@msg.Sender.ProfilePictureUrl" class="msg-avatar-img" />
                    }
                    else
                    {
                        <div class="msg-avatar-init">
                            @(msg.Sender?.FirstName?.Substring(0, 1) ?? other?.User?.FirstName?.Substring(0, 1) ?? "?")
                        </div>
                    }
                }
                @if (!isMine && isBotChat)
                {
                    <div class="msg-avatar-init">🤖</div>
                }

                <div class="msg-bubble">
                    @if (!msg.IsDeletedForEveryone && !isBotChat)
                    {
                        <div class="emoji-picker-popup @(isMine ? "mine" : "theirs")" id="ep-@msg.Id">
                            @foreach (var em in new[] { "👍", "❤️", "😂", "😮", "😢", "🙏" })
                            {
                                <button class="ep-btn" onclick="reactTo(@msg.Id,'@em',event)" title="@em">@em</button>
                            }
                        </div>
                    }

                    @if (msg.ReplyTo != null && !msg.ReplyTo.IsDeletedForEveryone)
                    {
                        <div class="reply-preview @(isMine ? "mine-reply" : "")">
                            <strong>@(msg.ReplyTo.Sender?.FirstName ?? "User")</strong>
                            @{
                                var rp = msg.ReplyTo.MessageType != MoneyTransfer.Models.MessageType.Text
                                ? "📎 " + msg.ReplyTo.MediaFileName
                                : msg.ReplyTo.Content;
                            }
                            @(rp?.Length > 60 ? rp.Substring(0, 60) + "…" : rp)
                        </div>
                    }

                    <div class="bubble-wrapper">
                        @if (!msg.IsDeletedForEveryone && !isBotChat)
                        {
                            <div class="msg-actions">
                                <button class="msg-action-btn" title="React" onclick="toggleEmojiPicker(event,@msg.Id)">
                                    <i class="bi bi-emoji-smile"></i>
                                </button>
                                <button class="msg-action-btn" title="Reply" onclick="setReply(@msg.Id,
                                                    '@Html.Raw((msg.Sender?.FirstName ?? other?.User?.FirstName ?? "User").Replace("'", "\\'"))',
                                                    '@Html.Raw(((msg.MessageType == MoneyTransfer.Models.MessageType.Text ? msg.Content : "📎 " + msg.MediaFileName) ?? "").Length > 40 ? ((msg.MessageType == MoneyTransfer.Models.MessageType.Text ? msg.Content : "📎 " + msg.MediaFileName) ?? "").Substring(0, 40) + "…" : ((msg.MessageType == MoneyTransfer.Models.MessageType.Text ? msg.Content : "📎 " + msg.MediaFileName) ?? "").Replace("'", "\\'"))')">
                                    <i class="bi bi-reply-fill"></i>
                                </button>
                                @if (isMine && msg.MessageType == MoneyTransfer.Models.MessageType.Text)
                                {
                                    <button class="msg-action-btn" title="Edit" onclick="openEditModal(@msg.Id,'@Html.Raw(msg.Content.Replace("'", "\\'").Replace("\r", "").Replace("\n", "\\n"))')">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                }
                                @if (isMine)
                                {
                                    <button class="msg-action-btn danger" title="Delete" onclick="openDeleteMenu(event,@msg.Id)">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="msg-action-btn danger" title="Delete for me" onclick="deleteMsg(@msg.Id,'me')">
                                        <i class="bi bi-eye-slash-fill"></i>
                                    </button>
                                }
                            </div>
                        }

                        <div id="bubble-@msg.Id" class="bubble-inner @(msg.MessageType != MoneyTransfer.Models.MessageType.Text ? "media-pad" : "") @(isMine ? "bubble-mine" : "bubble-theirs")">
                            @if (msg.IsDeletedForEveryone)
                            {
                                <span class="deleted-msg">🚫 This message was deleted.</span>
                            }
                            else if (msg.MessageType == MoneyTransfer.Models.MessageType.Image)
                            {
                                <img src="@msg.MediaUrl" class="media-img" onclick="openLightbox('@msg.MediaUrl')" alt="@msg.MediaFileName" />
                            }
                            else if (msg.MessageType == MoneyTransfer.Models.MessageType.Video)
                            {
                                <video class="media-video" controls preload="metadata">
                                    <source src="@msg.MediaUrl" />
                                </video>
                            }
                            else if (msg.MessageType == MoneyTransfer.Models.MessageType.Voice)
                            {
                                <div class="voice-message">
                                    <div class="voice-label">🎤 Voice message</div>
                                    <audio controls>
                                        <source src="@msg.MediaUrl" />
                                    </audio>
                                </div>
                            }
                            else if (msg.MessageType == MoneyTransfer.Models.MessageType.File)
                            {
                                string fileExt = string.IsNullOrEmpty(msg.MediaFileName) ? "" : System.IO.Path.GetExtension(msg.MediaFileName).ToLower();
                                string fileIcon = "📁";
                                if (fileExt == ".pdf") { fileIcon = "📄"; }
                                else if (fileExt == ".doc" || fileExt == ".docx") { fileIcon = "📝"; }
                                else if (fileExt == ".xls" || fileExt == ".xlsx") { fileIcon = "📊"; }
                                else if (fileExt == ".zip" || fileExt == ".rar") { fileIcon = "🗜️"; }
                                else if (fileExt == ".txt") { fileIcon = "📃"; }

                                <a href="@msg.MediaUrl" download="@msg.MediaFileName" class="file-card">
                                    <div class="file-icon">@fileIcon</div>
                                    <div class="file-info">
                                        <div class="fname">@msg.MediaFileName</div>
                                        <div class="fsize">
                                            @if (msg.MediaFileSize.HasValue)
                                            {
                                                long sz = msg.MediaFileSize.Value;
                                                if (sz < 1024)
                                                {
                                                    @(sz.ToString() + " B")
                                                }
                                                else if (sz < 1048576)
                                                {

                                                    @((sz / 1024.0).ToString("F1") + " KB")
                                                }
                                                else
                                                {

                                                    @((sz / 1048576.0).ToString("F1") + " MB")
                                                }
                                            }
                                        </div>
                                    </div>
                                    <i class="bi bi-download download-icon"></i>
                                </a>
                            }
                            else
                            {
                                @if (isBotChat && msg.IsFromAdmin)
                                {
                                    @Html.Raw(FormatBotMessage(msg.Content))
                                }
                                else
                                {
                                    @msg.Content
                                }
                            }
                        </div>

                        <div class="msg-time @(isMine ? "mine" : "theirs")">
                            @msg.SentAt.ToString("HH:mm")
                            @if (msg.IsEdited && !msg.IsDeletedForEveryone && msg.MessageType == MoneyTransfer.Models.MessageType.Text)
                            {
                                <span class="edited-badge">(edited)</span>
                            }
                            @if (isMine && !isBotChat)
                            {
                                <span class="read-tick @(msg.IsRead ? "read" : "")">@(msg.IsRead ? "✓✓" : "✓")</span>
                            }
                        </div>

                        <div class="reactions-strip" id="reactions-@msg.Id">
                            @foreach (var rg in rxGroups)
                            {
                                <button class="reaction-pill @(rg.IsMine ? "mine-react" : "")" onclick="reactTo(@msg.Id, '@rg.Emoji',event)" title="Toggle">
                                    @rg.Emoji <span class="cnt">@rg.Count</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Messages.Any())
        {
            <div class="chat-empty">
                @if (isBotChat)
                {
                    <i class="bi bi-robot"></i>
                    <p>Hi! I'm Cedar Bot. Ask me anything!</p>
                }
                else
                {
                    <i class="bi bi-chat-dots"></i>
                    <p>Say hi to @other?.User?.FirstName!</p>
                }
            </div>
        }
    </div>

    <div class="attach-bar" id="attachBar">
        <i class="bi bi-paperclip attach-icon"></i>
        <div class="attach-info">
            <div id="attachName" class="attach-name"></div>
            <div id="attachSize" class="attach-size"></div>
        </div>
        <button onclick="clearAttach()" class="bar-clear"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="reply-bar" id="replyBar">
        <i class="bi bi-reply-fill reply-icon"></i>
        <div class="reply-info">
            <div id="replyToName" class="reply-name"></div>
            <div id="replyToContent" class="reply-content"></div>
        </div>
        <button onclick="clearReply()" class="bar-clear"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="chat-input-bar">
        <div class="chat-input-row">
            @if (!isBotChat)
            {
                <button type="button" class="input-tool-btn" onclick="document.getElementById('fileIn').click()" title="Attach file">
                    <i class="bi bi-paperclip"></i>
                </button>

                <div class="emoji-input-wrap">
                    <button type="button" class="input-tool-btn" id="inputEmojiBtn" onclick="toggleInputEmoji(event)" title="Emoji">
                        😊
                    </button>
                    <div class="input-emoji-picker" id="inputEmojiPicker">
                        <div class="emoji-grid">
                            @foreach (var e in new[]{
                                                "😀","😂","😍","🥰","😎","🤔","😢","😡",
                                                "👍","👎","❤️","🔥","🎉","🙏","💰","🌲",
                                                "✅","❌","⭐","💯","🚀","💬","📱","🏦"})
                            {
                                <button type="button" class="ep-btn" onclick="insertEmoji(event,'@e')">@e</button>
                            }
                        </div>
                    </div>
                </div>
            }

            <input type="text" id="msgInput" placeholder="Type a message..." autocomplete="off" />

            <button class="send-btn" id="sendBtn" title="Send">
                <i class="bi bi-send-fill send-icon"></i>
            </button>
        </div>

        @if (!isBotChat)
        {
            <input type="file" id="fileIn" style="display:none"
                   accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip,.rar"
                   onchange="onFileSelected(this)" />

            <form id="fileForm" method="post" asp-controller="Chat" asp-action="SendFile" enctype="multipart/form-data" style="display:none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="conversationId" value="@Model.Id" />
                <input type="hidden" name="replyToId" id="fileReplyId" value="" />
                <input type="file" name="file" id="fileFormInput" />
            </form>
        }
    </div>
</div>

<div class="profile-overlay" id="profileOverlay" onclick="closeProfile()"></div>
<div class="profile-panel" id="profilePanel">
    <div class="profile-panel-header">
        <button onclick="closeProfile()" class="profile-close-btn"><i class="bi bi-x-lg"></i></button>
        <span class="profile-panel-title">Contact Info</span>
    </div>
    <div id="profileLoading" class="profile-loading">
        <div class="loading-spinner">⏳</div>
        <div>Loading...</div>
    </div>
    <div id="profileContent" class="profile-content" style="display:none">
        <div class="profile-avatar-section">
            <div id="panelAvatar" class="profile-avatar"></div>
            <div id="panelName" class="profile-name"></div>
            <div id="panelUsername" class="profile-username"></div>
            <div id="panelVerified" class="profile-verified"></div>
        </div>
        <div class="profile-info-section">
            <div class="profile-section-title">About</div>
            <div id="panelBio" class="profile-bio"></div>
            <div class="profile-info-row" id="panelPhoneRow">
                <i class="bi bi-telephone-fill"></i>
                <span id="panelPhone"></span>
            </div>
            <div class="profile-info-row" id="panelLocRow" style="display:none">
                <i class="bi bi-geo-alt-fill"></i>
                <span id="panelLoc"></span>
            </div>
            <div class="profile-info-row">
                <i class="bi bi-calendar3"></i>
                <span id="panelSince"></span>
            </div>
        </div>
        <div class="profile-media-section">
            <div class="profile-section-title">Shared Media</div>
            <div id="panelImages" class="profile-images-grid"></div>
            <div id="panelNoMedia" class="profile-no-media">No shared media yet</div>
        </div>
        <div id="panelFilesSection" class="profile-files-section" style="display:none">
            <div class="profile-section-title">Shared Files</div>
            <div id="panelFiles" class="profile-files-list"></div>
        </div>
    </div>
</div>

<div id="lightbox" class="lightbox">
    <button class="lb-close" onclick="closeLightbox()"><i class="bi bi-x-lg"></i></button>
    <img id="lbImg" src="" alt="" />
</div>

<div id="ctxMenu" class="ctx-menu">
    <div class="ctx-item danger" onclick="deleteMsg(ctxId,'me')">
        <i class="bi bi-eye-slash-fill"></i> Delete for Me
    </div>
    <div class="ctx-item danger" onclick="deleteMsg(ctxId,'everyone')">
        <i class="bi bi-trash-fill"></i> Delete for Everyone
    </div>
</div>

<div id="editOverlay" class="edit-overlay">
    <div class="edit-modal">
        <div class="edit-modal-header">
            <i class="bi bi-pencil-fill"></i> Edit Message
        </div>
        <textarea id="editContent" rows="3" class="form-control edit-textarea"></textarea>
        <div class="edit-modal-actions">
            <button onclick="closeEdit()" class="btn-tp-secondary">Cancel</button>
            <button onclick="submitEdit()" class="btn-tp-primary"><i class="bi bi-check-lg"></i> Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <form id="csrfForm" style="display:none">@Html.AntiForgeryToken()</form>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        const convId = @Model.Id;
        const myUserId = '@ViewBag.CurrentUserId';
        const isBotChat = @(isBotChat ? "true" : "false");
        const otherName = '@(other?.User?.FirstName ?? (isBotChat ? "Cedar Bot" : "User"))';
        const token = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value;
        const area = document.getElementById('msgArea');

        function scrollDown() {
            if (area) area.scrollTop = area.scrollHeight;
        }
        scrollDown();

        function openLightbox(src) {
            document.getElementById('lbImg').src = src;
            document.getElementById('lightbox').classList.add('open');
        }
        function closeLightbox() {
            document.getElementById('lightbox').classList.remove('open');
        }
        document.getElementById('lightbox')?.addEventListener('click', function(e) {
            if (e.target.id === 'lightbox') closeLightbox();
        });

        function onFileSelected(inp) {
            const f = inp.files[0];
            if (!f) return;
            document.getElementById('attachName').textContent = f.name;
            const sz = f.size < 1024 ? f.size + 'B'
                : f.size < 1048576 ? (f.size / 1024).toFixed(1) + 'KB'
                : (f.size / 1048576).toFixed(1) + 'MB';
            document.getElementById('attachSize').textContent = sz;
            document.getElementById('attachBar').classList.add('open');
            const dt = new DataTransfer();
            dt.items.add(f);
            document.getElementById('fileFormInput').files = dt.files;
        }

        function clearAttach() {
            document.getElementById('fileIn').value = '';
            document.getElementById('fileFormInput').files = new DataTransfer().files;
            document.getElementById('attachBar').classList.remove('open');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.emoji-picker-popup') &&
                !e.target.closest('.msg-action-btn')) {
                document.querySelectorAll('.emoji-picker-popup')
                    .forEach(function(p) { p.classList.remove('open'); });
            }
            if (!e.target.closest('#inputEmojiPicker') &&
                !e.target.closest('#inputEmojiBtn')) {
                document.getElementById('inputEmojiPicker')?.classList.remove('open');
            }
            if (!e.target.closest('#ctxMenu')) {
                document.getElementById('ctxMenu').classList.remove('open');
            }
        });

        function toggleEmojiPicker(e, msgId) {
            e.stopPropagation();
            const p = document.getElementById('ep-' + msgId);
            const was = p.classList.contains('open');
            document.querySelectorAll('.emoji-picker-popup')
                .forEach(function(x) { x.classList.remove('open'); });
            if (!was) p.classList.add('open');
        }

        async function reactTo(msgId, emoji, e) {
            if (e) e.stopPropagation();
            document.getElementById('ep-' + msgId)?.classList.remove('open');
            const res = await fetch('/Chat/ReactToMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'messageId=' + msgId + '&emoji=' + encodeURIComponent(emoji)
            });
            if (res.ok) {
                const data = await res.json();
                renderReactions(msgId, data.counts);
            }
        }

        function renderReactions(msgId, counts) {
            const strip = document.getElementById('reactions-' + msgId);
            if (!strip) return;
            strip.innerHTML = '';
            (counts || []).forEach(function(r) {
                const btn = document.createElement('button');
                btn.className = 'reaction-pill';
                btn.onclick = function(e) { reactTo(msgId, r.emoji, e); };
                btn.innerHTML = r.emoji + ' <span class="cnt">' + r.count + '</span>';
                strip.appendChild(btn);
            });
        }

        function toggleInputEmoji(e) {
            e.stopPropagation();
            document.getElementById('inputEmojiPicker').classList.toggle('open');
        }

        function insertEmoji(event, em) {
            event.stopPropagation();
            const inp = document.getElementById('msgInput');
            const s = inp.selectionStart, en = inp.selectionEnd;
            inp.value = inp.value.slice(0, s) + em + inp.value.slice(en);
            inp.selectionStart = inp.selectionEnd = s + em.length;
            inp.focus();
        }

        function setReply(msgId, name, preview) {
            document.getElementById('replyBar').classList.add('open');
            document.getElementById('replyToName').textContent = name;
            document.getElementById('replyToContent').textContent = preview;
            document.getElementById('msgInput').dataset.replyTo = msgId;
            document.getElementById('msgInput').focus();
        }

        function clearReply() {
            document.getElementById('replyBar').classList.remove('open');
            delete document.getElementById('msgInput').dataset.replyTo;
        }

        let editId = null;

        function openEditModal(msgId, current) {
            editId = msgId;
            document.getElementById('editContent').value = current;
            document.getElementById('editOverlay').classList.add('open');
            setTimeout(function() { document.getElementById('editContent').focus(); }, 50);
        }

        function closeEdit() {
            document.getElementById('editOverlay').classList.remove('open');
            editId = null;
        }

        async function submitEdit() {
            const nc = document.getElementById('editContent').value.trim();
            if (!nc || !editId) return;
            const res = await fetch('/Chat/EditMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'messageId=' + editId + '&newContent=' + encodeURIComponent(nc)
            });
            if (res.ok) {
                document.getElementById('bubble-' + editId).textContent = nc;
                closeEdit();
            }
        }

        document.getElementById('editContent')?.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && e.ctrlKey) submitEdit();
            if (e.key === 'Escape') closeEdit();
        });

        let ctxId = null;

        function openDeleteMenu(e, msgId) {
            e.preventDefault();
            e.stopPropagation();
            ctxId = msgId;
            const m = document.getElementById('ctxMenu');
            m.classList.add('open');
            m.style.top = e.clientY + 'px';
            m.style.left = e.clientX + 'px';
        }

        async function deleteMsg(msgId, type) {
            document.getElementById('ctxMenu').classList.remove('open');
            const res = await fetch('/Chat/DeleteMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'messageId=' + msgId + '&deleteType=' + type
            });
            if (res.ok) {
                if (type === 'me') {
                    const el = document.getElementById('msg-' + msgId);
                    if (el) {
                        el.classList.add('msg-deleting');
                        setTimeout(function() { el.remove(); }, 200);
                    }
                } else {
                    const b = document.getElementById('bubble-' + msgId);
                    if (b) b.innerHTML = '<span class="deleted-msg">🚫 This message was deleted.</span>';
                }
            }
        }

        async function sendText(content, replyToId) {
            const inp = document.getElementById('msgInput');
            const btn = document.getElementById('sendBtn');
            inp.disabled = true;
            btn.disabled = true;
            btn.style.opacity = '0.6';

            try {
                const fd = new FormData();
                fd.append('conversationId', convId);
                fd.append('content', content);
                if (replyToId) fd.append('replyToId', replyToId);
                fd.append('__RequestVerificationToken', token);

                const res = await fetch('/Chat/Send', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: fd
                });

                if (res.ok) {
                    const data = await res.json();
                    if (data.success) {
                        const rName = document.getElementById('replyToName').textContent;
                        const rText = document.getElementById('replyToContent').textContent;
                        inp.value = '';
                        clearReply();
                        appendOwnBubble(content, data.sentAt, data.messageId, rName || null, rText || null);
                    }
                } else {
                    console.error('Send failed:', res.status);
                }
            } catch (err) {
                console.error('Send error:', err);
            } finally {
                inp.disabled = false;
                btn.disabled = false;
                btn.style.opacity = '1';
                inp.focus();
            }
        }

        function appendOwnBubble(content, sentAt, msgId, replyName, replyText) {
            const id = msgId || Date.now();
            const replyHtml = replyName
                ? '<div class="reply-preview mine-reply"><strong>' + escHtml(replyName) + '</strong>' + escHtml(replyText || '') + '</div>'
                : '';

            const row = document.createElement('div');
            row.id = 'msg-' + id;
            row.className = 'msg-wrapper mine';

            row.innerHTML = `
                <div class="msg-bubble">
                    ${replyHtml}
                    <div class="bubble-wrapper">
                        <div id="bubble-${id}" class="bubble-inner bubble-mine">${escHtml(content)}</div>
                        <div class="msg-time mine">
                            ${sentAt || new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}
                            <span class="read-tick">✓</span>
                        </div>
                        <div class="reactions-strip" id="reactions-${id}"></div>
                    </div>
                </div>`;

            area.appendChild(row);
            scrollDown();
        }

        const sendBtn = document.getElementById('sendBtn');
        const msgInput = document.getElementById('msgInput');

        if (sendBtn) {
            sendBtn.addEventListener('click', function(e) {
                if (isBotChat) {
                    document.getElementById('csrfForm').submit();
                    return;
                }
                const fi = document.getElementById('fileFormInput');
                if (fi && fi.files && fi.files.length) {
                    document.getElementById('fileReplyId').value = document.getElementById('msgInput').dataset.replyTo || '';
                    document.getElementById('fileForm').submit();
                    return;
                }
                const c = msgInput.value.trim();
                if (!c) return;
                const rid = msgInput.dataset.replyTo || '';
                sendText(c, rid);
            });
        }

        if (msgInput) {
            msgInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if (isBotChat) {
                        document.getElementById('csrfForm').submit();
                        return;
                    }
                    const fi = document.getElementById('fileFormInput');
                    if (fi && fi.files && fi.files.length) {
                        document.getElementById('fileReplyId').value = document.getElementById('msgInput').dataset.replyTo || '';
                        document.getElementById('fileForm').submit();
                        return;
                    }
                    const c = this.value.trim();
                    if (!c) return;
                    const rid = this.dataset.replyTo || '';
                    sendText(c, rid);
                }
            });
        }

        if (!isBotChat) {
            const conn = new signalR.HubConnectionBuilder()
                .withUrl('/chatHub')
                .withAutomaticReconnect()
                .build();

            conn.on('ReceiveMessage', function(data) {
                if (data.conversationId !== convId) return;
                if (data.senderId === myUserId) return;
                if (document.getElementById('msg-' + data.messageId)) return;

                const row = document.createElement('div');
                row.id = 'msg-' + data.messageId;
                row.className = 'msg-wrapper theirs';

                const av = document.createElement('div');
                av.className = 'msg-avatar-init';
                av.textContent = otherName.charAt(0).toUpperCase();

                const mt = (data.messageType || 'Text').toLowerCase();
                const pad = mt === 'text' ? 'bubble-inner' : 'bubble-inner media-pad';
                const replyHtml = data.replyPreview
                    ? '<div class="reply-preview"><strong>' + escHtml(data.replySender || '') + '</strong>' + escHtml(data.replyPreview) + '</div>'
                    : '';

                let content = '';
                if (mt === 'image') {
                    content = '<img src="' + escHtml(data.mediaUrl) + '" class="media-img" onclick="openLightbox(\'' + escHtml(data.mediaUrl) + '\')" />';
                } else if (mt === 'video') {
                    content = '<video class="media-video" controls preload="metadata"><source src="' + escHtml(data.mediaUrl) + '" /></video>';
                } else if (mt === 'voice') {
                    content = '<div class="voice-message"><div class="voice-label">🎤 Voice message</div><audio controls><source src="' + escHtml(data.mediaUrl) + '" /></audio></div>';
                } else if (mt === 'file') {
                    content = '<a href="' + escHtml(data.mediaUrl) + '" download="' + escHtml(data.mediaFileName) + '" class="file-card"><div class="file-icon">📁</div><div class="file-info"><div class="fname">' + escHtml(data.mediaFileName) + '</div></div><i class="bi bi-download download-icon"></i></a>';
                } else {
                    content = escHtml(data.content);
                }

                const bub = document.createElement('div');
                bub.className = 'msg-bubble';
                bub.innerHTML = replyHtml + '<div class="bubble-wrapper"><div id="bubble-' + data.messageId + '" class="' + pad + ' bubble-theirs">' + content + '</div><div class="msg-time theirs">' + data.sentAt + '</div><div class="reactions-strip" id="reactions-' + data.messageId + '"></div></div>';

                row.appendChild(av);
                row.appendChild(bub);
                area.appendChild(row);
                scrollDown();
            });

            conn.on('MessageEdited', function(data) {
                const b = document.getElementById('bubble-' + data.messageId);
                if (b && !b.querySelector('.deleted-msg')) b.textContent = data.newContent;
            });

            conn.on('MessageDeleted', function(data) {
                if (data.deletedForEveryone) {
                    const b = document.getElementById('bubble-' + data.messageId);
                    if (b) b.innerHTML = '<span class="deleted-msg">🚫 This message was deleted.</span>';
                }
            });

            conn.on('ReactionUpdated', function(data) {
                renderReactions(data.messageId, data.counts);
            });

            conn.start()
                .then(function() { return conn.invoke('JoinConversation', convId); })
                .catch(console.error);
        }

        async function openProfile() {
            document.getElementById('profileOverlay').style.display = 'block';
            document.getElementById('profilePanel').style.right = '0';
            document.getElementById('profileLoading').style.display = 'flex';
            document.getElementById('profileContent').style.display = 'none';

            try {
                const res = await fetch('/Chat/ConversationProfile/' + convId);
                if (!res.ok) return;
                const d = await res.json();

                const av = document.getElementById('panelAvatar');
                if (d.profilePicture) {
                    av.innerHTML = '<img src="' + escHtml(d.profilePicture) + '" style="width:90px;height:90px;object-fit:cover" />';
                } else {
                    av.textContent = (d.firstName || '?').charAt(0).toUpperCase();
                    av.style.background = 'linear-gradient(135deg, var(--teal), var(--teal-mid))';
                    av.style.display = 'flex';
                    av.style.alignItems = 'center';
                    av.style.justifyContent = 'center';
                    av.style.fontSize = '32px';
                    av.style.fontWeight = '700';
                    av.style.color = '#fff';
                }

                document.getElementById('panelName').textContent = (d.firstName || '') + ' ' + (d.lastName || '');
                document.getElementById('panelUsername').textContent = d.username ? '@@' + d.username : '';
                document.getElementById('panelVerified').style.display = d.isVerified ? 'block' : 'none';

                const bio = document.getElementById('panelBio');
                if (d.bio) {
                    bio.textContent = d.bio;
                    bio.style.display = 'block';
                }

                document.getElementById('panelPhone').textContent = d.phone || 'No phone';

                if (d.city || d.country) {
                    document.getElementById('panelLocRow').style.display = 'flex';
                    let locText = '';
                    if (d.city) locText += d.city;
                    if (d.country) {
                        if (locText) locText += ', ';
                        locText += d.country;
                    }
                    document.getElementById('panelLoc').textContent = locText;
                }
                document.getElementById('panelSince').textContent = 'Member since ' + (d.memberSince || 'recently');

                const grid = document.getElementById('panelImages');
                grid.innerHTML = '';
                const imgs = (d.images || []).slice(0, 9);
                if (imgs.length) {
                    imgs.forEach(function(img) {
                        const div = document.createElement('div');
                        div.className = 'profile-media-item';
                        div.onclick = function() { openLightbox(img.mediaUrl); };
                        div.innerHTML = '<img src="' + escHtml(img.mediaUrl) + '" class="profile-media-thumb" />';
                        grid.appendChild(div);
                    });
                    document.getElementById('panelNoMedia').style.display = 'none';
                } else {
                    document.getElementById('panelNoMedia').style.display = 'block';
                }

                const files = d.files || [];
                if (files.length) {
                    const fc = document.getElementById('panelFiles');
                    fc.innerHTML = '';
                    files.forEach(function(f) {
                        const parts = (f.mediaFileName || '').split('.');
                        const ext = parts.length > 1 ? parts.pop().toLowerCase() : '';
                        let ic = '📁';
                        if (ext === 'pdf') ic = '📄';
                        else if (ext === 'doc' || ext === 'docx') ic = '📝';
                        else if (ext === 'xls' || ext === 'xlsx') ic = '📊';
                        else if (ext === 'zip' || ext === 'rar') ic = '🗜️';
                        else if (ext === 'txt') ic = '📃';

                        let sz = '';
                        if (f.mediaFileSize) {
                            if (f.mediaFileSize < 1024) {
                                sz = f.mediaFileSize + 'B';
                            } else if (f.mediaFileSize < 1048576) {
                                sz = (f.mediaFileSize / 1024).toFixed(1) + 'KB';
                            } else {
                                sz = (f.mediaFileSize / 1048576).toFixed(1) + 'MB';
                            }
                        }

                        fc.innerHTML += `
                            <a href="${escHtml(f.mediaUrl)}" download="${escHtml(f.mediaFileName)}" class="file-card">
                                <div class="file-icon">${ic}</div>
                                <div class="file-info">
                                    <div class="fname">${escHtml(f.mediaFileName || 'File')}</div>
                                    <div class="fsize">${sz}</div>
                                </div>
                                <i class="bi bi-download download-icon"></i>
                            </a>`;
                    });
                    document.getElementById('panelFilesSection').style.display = 'block';
                }

                document.getElementById('profileLoading').style.display = 'none';
                document.getElementById('profileContent').style.display = 'block';
            } catch (err) {
                console.error(err);
                document.getElementById('profileLoading').innerHTML = '<div class="error-message">Failed to load profile</div>';
            }
        }

        function closeProfile() {
            document.getElementById('profilePanel').style.right = '-420px';
            document.getElementById('profileOverlay').style.display = 'none';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeProfile();
                closeLightbox();
                closeEdit();
            }
        });

        function escHtml(s) {
            if (!s) return '';
            return String(s).replace(/[&<>"']/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                if (m === '"') return '&quot;';
                if (m === "'") return '&#39;';
                return m;
            });
        }
    </script>
}