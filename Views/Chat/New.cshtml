@{
    ViewData["Title"] = "New Chat";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="page-header">
            <div>
                <h2>Start a Conversation</h2>
                <p>Find someone by phone or username</p>
            </div>
            <a asp-action="Index" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        @if (ViewBag.Error != null)
        {
            <div style="background:var(--red-light);
                                border:1px solid rgba(255,107,107,.25);
                                border-radius:var(--r-md);
                                padding:12px 16px;margin-bottom:16px;
                                font-size:13px;color:var(--red);
                                display:flex;align-items:center;gap:8px">
                <i class="bi bi-exclamation-circle"></i>
                @ViewBag.Error
            </div>
        }

        <div style="display:flex;gap:0;margin-bottom:16px;
                    border-radius:var(--r-md);overflow:hidden;
                    border:1px solid var(--border)">
            <button id="tabPhone"
                    onclick="switchTab('phone')"
                    style="flex:1;padding:11px;font-size:13px;
                           font-weight:600;border:none;cursor:pointer;
                           background:var(--teal);color:#fff;
                           transition:var(--transition)">
                <i class="bi bi-telephone"></i> By Phone
            </button>
            <button id="tabUsername"
                    onclick="switchTab('username')"
                    style="flex:1;padding:11px;font-size:13px;
                           font-weight:600;border:none;cursor:pointer;
                           background:var(--surface-2);
                           color:var(--text-2);
                           transition:var(--transition)">
                <i class="bi bi-at"></i> By Username
            </button>
        </div>

        <div id="panelPhone" class="tp-card">
            <form asp-action="FindAndStart" method="post" class="tp-form">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Phone Number</label>
                    <input type="tel"
                           name="phoneNumber"
                           class="form-control"
                           placeholder="+961 XX XXX XXX"
                           autofocus />
                    <div style="font-size:12px;color:var(--text-3);margin-top:6px">
                        Enter the phone number registered on CedarPay
                    </div>
                </div>
                <button type="submit" class="btn-tp-primary" style="width:100%">
                    <i class="bi bi-search"></i> Find & Start Chat
                </button>
            </form>
        </div>

        <div id="panelUsername" class="tp-card" style="display:none">
            <form asp-action="FindByUsername" method="post" class="tp-form">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Username</label>
                    <div style="position:relative;display:flex;align-items:center;
                                border:1px solid var(--border);border-radius:var(--r-md);
                                background:var(--surface);overflow:hidden;
                                transition:border-color .15s"
                         onfocusin="this.style.borderColor='var(--teal)'"
                         onfocusout="this.style.borderColor='var(--border)'">
                        <span style="padding:0 6px 0 14px;color:var(--text-3);
                                     font-size:15px;flex-shrink:0;
                                     border-right:1px solid var(--border);
                                     line-height:42px">&#64;</span>
                        <input type="text"
                               name="username"
                               class="form-control"
                               placeholder="username"
                               style="border:none;border-radius:0;
                                      box-shadow:none;padding-left:10px;
                                      background:transparent" />
                    </div>
                    <div style="font-size:12px;color:var(--text-3);margin-top:6px">
                        Enter their CedarPay username (without the &#64;)
                    </div>
                </div>
                <button type="submit" class="btn-tp-primary" style="width:100%">
                    <i class="bi bi-search"></i> Find & Start Chat
                </button>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function switchTab(tab) {
            const isPhone = tab === 'phone';
            document.getElementById('panelPhone').style.display = isPhone ? '' : 'none';
            document.getElementById('panelUsername').style.display = isPhone ? 'none' : '';
            document.getElementById('tabPhone').style.background = isPhone ? 'var(--teal)' : 'var(--surface-2)';
            document.getElementById('tabPhone').style.color = isPhone ? '#fff' : 'var(--text-2)';
            document.getElementById('tabUsername').style.background = isPhone ? 'var(--surface-2)' : 'var(--teal)';
            document.getElementById('tabUsername').style.color = isPhone ? 'var(--text-2)' : '#fff';
        }

        @if (ViewBag.ActiveTab == "username")
        {
                @:switchTab('username');
        }
    </script>
}