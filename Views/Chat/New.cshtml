@{
    ViewData["Title"] = "New Chat";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="page-header">
            <div>
                <h2>Start a Conversation</h2>
                <p>Enter the person's phone number</p>
            </div>
            <a asp-action="Index" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        @if (ViewBag.Error != null)
        {
            <div style="background:var(--red-light);
                            border:1px solid rgba(255,107,107,.25);
                            border-radius:var(--r-md);
                            padding:12px 16px;margin-bottom:16px;
                            font-size:13px;color:var(--red);
                            display:flex;align-items:center;gap:8px">
                <i class="bi bi-exclamation-circle"></i>
                @ViewBag.Error
            </div>
        }

        <div class="tp-card">
            <form asp-action="FindAndStart" method="post"
                  class="tp-form">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">
                        Phone Number
                    </label>
                    <input type="tel"
                           name="phoneNumber"
                           class="form-control"
                           placeholder="+961 XX XXX XXX"
                           autofocus
                           required />
                    <div style="font-size:12px;
                                color:var(--text-3);
                                margin-top:6px">
                        Enter the phone number registered
                        on CedarPay
                    </div>
                </div>

                <button type="submit" class="btn-tp-primary">
                    <i class="bi bi-search"></i>
                    Find & Start Chat
                </button>
            </form>
        </div>
    </div>
</div>