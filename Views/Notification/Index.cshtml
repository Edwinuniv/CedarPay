@model List<MoneyTransfer.ViewModels.NotificationViewModel>
@{
    ViewData["Title"] = "Notifications";
    ViewBag.PageClass = "page-notifications";
}

<div class="page-header">
    <div>
        <h2>Notifications</h2>
        <p>Your recent alerts and updates</p>
    </div>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllAsRead" method="post">
            <button type="submit" class="btn-tp-secondary">
                <i class="bi bi-check-all"></i> Mark All Read
            </button>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-bell-slash"></i>
            <p>No notifications yet.</p>
        </div>
    </div>
}
else
{
    <div class="tp-card">
        @foreach (var n in Model)
        {
            <div class="notification-item @(!n.IsRead ? "unread" : "")">
                <div class="notification-icon">
                    @switch (n.Type)
                    {
                        case "TransactionSent":
                            <text>↑</text>
                            break;
                        case "TransactionReceived":
                            <text>↓</text>
                            break;
                        case "TopUpCompleted":
                            <text>+</text>
                            break;
                        default:
                            <text>🔔</text>
                            break;
                    }
                </div>
                <div class="notification-content">
                    <div class="notification-title @(!n.IsRead ? "unread" : "read")">
                        @n.Title
                        @if (!n.IsRead)
                        {
                            <span class="notification-unread-dot"></span>
                        }
                    </div>
                    <div class="notification-message">@n.Message</div>
                    <div class="notification-date">
                        @n.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                    </div>
                </div>
                @if (!n.IsRead)
                {
                    <form asp-action="MarkAsRead" asp-route-id="@n.Id" method="post">
                        <button type="submit" class="btn-tp-secondary notification-mark-read-btn">
                            Mark Read
                        </button>
                    </form>
                }
            </div>
        }
    </div>
}