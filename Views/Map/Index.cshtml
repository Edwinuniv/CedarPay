@model List<MoneyTransfer.Models.Agent>
@{
    ViewData["Title"] = "Agent Map";
    ViewBag.PageClass = "page-map";
    var userAgents = ViewBag.UserAgents as
        List<MoneyTransfer.Models.Agent>
        ?? new List<MoneyTransfer.Models.Agent>();
    bool isAgentOrAdmin = User.IsInRole("Agent") || User.IsInRole("Admin");
}

<div class="page-header">
    <div>
        <h2>Agent Map</h2>
        <p>Find a CedarPay agent near you</p>
    </div>
    @if (isAgentOrAdmin)
    {
        <a asp-controller="Agent"
           asp-action="SetLocation"
           class="btn-tp-primary">
            <i class="bi bi-geo-alt-fill"></i>
            @(userAgents.Any(a => a.Latitude != 0)
                ? "Update My Location"
                : "Set My Location")
        </a>
    }
</div>

<!-- Your Stores Section for agents and admins -->
@if (isAgentOrAdmin)
{
    <div class="tp-card mb-3">
        <div class="agent-stores-header">
            <div class="agent-stores-title">
                <i class="bi bi-shop agent-stores-icon"></i>
                <span class="agent-stores-title-text">Your Stores</span>
            </div>
            <a asp-controller="AgentApplication" asp-action="Apply" class="btn-tp-primary agent-register-btn">
                <i class="bi bi-plus"></i> Register New Store
            </a>
        </div>
        
        @if (userAgents.Any())
        {
            <div class="agent-stores-list">
                @foreach (var store in userAgents)
                {
                    <div class="agent-store-item">
                        <div class="agent-store-info">
                            <div class="agent-store-name">@store.StoreName</div>
                            <div class="agent-store-location">@store.City, @store.Country</div>
                            @if (store.Latitude != 0 && store.Longitude != 0)
                            {
                                <span class="badge-tp success agent-store-badge">Location Set ✓</span>
                            }
                            else
                            {
                                <span class="badge-tp warning agent-store-badge">Location Not Set</span>
                            }
                        </div>
                        <a asp-controller="Agent" asp-action="SetLocation" asp-route-id="@store.Id" class="btn-tp-secondary agent-store-set-location">
                            <i class="bi bi-geo-alt-fill"></i> Set Location
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="agent-stores-empty">
                <i class="bi bi-shop agent-stores-empty-icon"></i>
                <p>You don't have any stores yet.</p>
                <a asp-controller="AgentApplication" asp-action="Apply" class="btn-tp-primary">Register Your First Store</a>
            </div>
        }
    </div>
}

<div class="tp-card mb-3">
    <div class="agent-map-search">
        <input type="text"
               id="searchInput"
               class="form-control"
               placeholder="Type a city or agent name to filter..."
               oninput="filterAgents(this.value)" />
        <div class="agent-map-count">
            <span id="agentCount">@Model.Count</span>
            agent@(Model.Count != 1 ? "s" : "")
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="tp-card agent-map-container">
            <div id="map" class="agent-map-frame"></div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="tp-card agent-list-sidebar">
            <div class="agent-list-header">All Agents</div>
            <div id="agentList" class="agent-list-items">
                @foreach (var agent in Model)
                {
                    <div class="agent-card-item"
                         data-name="@(agent.StoreName?.ToLower() ?? "")"
                         data-city="@(agent.City?.ToLower() ?? "")"
                         data-lat="@agent.Latitude"
                         data-lng="@agent.Longitude"
                         onclick="flyTo(@agent.Latitude, @agent.Longitude, '@(agent.StoreName?.Replace("'", "\\'") ?? "")')">
                        <div class="agent-card-name">@agent.StoreName</div>
                        <div class="agent-card-location">
                            <i class="bi bi-geo-alt"></i>
                            @agent.City, @agent.Country
                        </div>
                        @if (!string.IsNullOrEmpty(agent.WorkingHours))
                        {
                            <div class="agent-card-hours">
                                <i class="bi bi-clock"></i>
                                @agent.WorkingHours
                            </div>
                        }
                        @if (agent.Latitude == 0 && agent.Longitude == 0)
                        {
                            <div class="agent-card-warning">
                                <i class="bi bi-exclamation-triangle"></i>
                                Location not set
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.js"></script>
    <script>
        const map = L.map('map').setView([33.8547, 35.8623], 9);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors',
            maxZoom: 18
        }).addTo(map);

        const tealIcon = L.divIcon({
            html: `<div class="leaflet-custom-icon"></div>`,
            className: '',
            iconSize: [32, 32],
            iconAnchor: [16, 32],
            popupAnchor: [0, -32]
        });

        const agents = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Select(a => new {
                name = a.StoreName,
                agent = a.AgentName,
                city = a.City,
                country = a.Country,
                phone = a.PhoneNumber,
                hours = a.WorkingHours,
                lat = a.Latitude,
                lng = a.Longitude
            })
        ));

        const markers = [];

        agents.forEach(a => {
            if (!a.lat || !a.lng || (a.lat === 0 && a.lng === 0)) return;

            const marker = L.marker([a.lat, a.lng], { icon: tealIcon })
                .bindPopup(`
                    <div style="font-family:sans-serif;min-width:160px">
                        <div class="custom-popup-name">${escapeHtml(a.name)}</div>
                        <div class="custom-popup-location">${escapeHtml(a.city)}, ${escapeHtml(a.country)}</div>
                        ${a.phone ? `<div class="custom-popup-phone">📞 ${escapeHtml(a.phone)}</div>` : ''}
                        ${a.hours ? `<div class="custom-popup-hours">🕐 ${escapeHtml(a.hours)}</div>` : ''}
                    </div>
                `)
                .addTo(map);

            markers.push({ marker, data: a });
        });

        if (markers.length === 0) {
            console.log('No agents with valid coordinates found');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        function flyTo(lat, lng, name) {
            if (!lat || !lng || (lat === 0 && lng === 0)) {
                alert('This agent has not set their location yet.');
                return;
            }
            map.flyTo([lat, lng], 14, { duration: 1 });
            markers.forEach(m => {
                if (m.data.lat === lat && m.data.lng === lng) {
                    m.marker.openPopup();
                }
            });
        }

        function filterAgents(query) {
            const q = query.toLowerCase().trim();
            const items = document.querySelectorAll('.agent-card-item');
            let count = 0;
            let firstLat = null;
            let firstLng = null;

            items.forEach(item => {
                const name = (item.dataset.name || '').toLowerCase();
                const city = (item.dataset.city || '').toLowerCase();
                const show = q === '' || name.includes(q) || city.includes(q);

                item.style.display = show ? 'block' : 'none';

                if (show) {
                    count++;
                    if (firstLat === null) {
                        const lat = parseFloat(item.dataset.lat);
                        const lng = parseFloat(item.dataset.lng);
                        if (lat && lng && !(lat === 0 && lng === 0)) {
                            firstLat = lat;
                            firstLng = lng;
                        }
                    }
                }
            });

            document.getElementById('agentCount').textContent = count;

            if (firstLat && firstLng) {
                map.flyTo([firstLat, firstLng], 12, { duration: 1.5 });
            }
        }

        document.getElementById('searchInput').addEventListener('input', function() {
            filterAgents(this.value);
        });
    </script>
}