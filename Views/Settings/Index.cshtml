@{
    ViewData["Title"] = "Settings";
    ViewBag.PageClass = "page-settings";
}

<div class="page-header">
    <div>
        <h2>Settings</h2>
        <p>Manage your account preferences</p>
    </div>
</div>

<div class="row g-3">

    <!-- Tutorial Highlight Card -->
    <div class="col-12">
        <a asp-controller="Tutorial" asp-action="Index" class="settings-tutorial-link">
            <div>
                <div class="settings-tutorial-title">📖 Tutorial</div>
                <div class="settings-tutorial-desc">Review how to use CedarPay</div>
            </div>
            <i class="bi bi-chevron-right settings-tutorial-icon"></i>
        </a>
    </div>

    <div class="col-md-6">
        <div class="tp-card">
            <div class="tp-card-header">
                <span class="tp-card-title">
                    <i class="bi bi-shield-lock"></i>
                    Security
                </span>
            </div>
            <div class="d-flex flex-column gap-2">
                <a asp-controller="Settings" asp-action="ChangePassword" class="settings-card-link">
                    <div>
                        <div class="settings-link-title">Change Password</div>
                        <div class="settings-link-desc">Update your login password</div>
                    </div>
                    <i class="bi bi-chevron-right settings-link-icon"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="tp-card">
            <div class="tp-card-header">
                <span class="tp-card-title">
                    <i class="bi bi-palette"></i>
                    Appearance
                </span>
            </div>
            <div class="dark-mode-toggle">
                <div>
                    <div class="settings-link-title">Dark Mode</div>
                    <div class="settings-link-desc">Switch to dark background</div>
                </div>
                <label class="dark-mode-label">
                    <input type="checkbox" id="darkToggle" class="dark-mode-input" onchange="toggleDarkMode(this)" />
                    <span id="darkSlider" class="dark-mode-slider">
                        <span id="darkKnob" class="dark-mode-knob"></span>
                    </span>
                </label>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="tp-card">
            <div class="tp-card-header">
                <span class="tp-card-title">
                    <i class="bi bi-person-gear"></i>
                    Account
                </span>
            </div>
            <div class="d-flex flex-column gap-2">
                <a asp-controller="Account" asp-action="Profile" class="settings-card-link">
                    <div>
                        <div class="settings-link-title">Edit Profile</div>
                        <div class="settings-link-desc">Update your personal information</div>
                    </div>
                    <i class="bi bi-chevron-right settings-link-icon"></i>
                </a>
                <a asp-controller="Tutorial" asp-action="Index" class="settings-card-link">
                    <div>
                        <div class="settings-link-title">View Tutorial</div>
                        <div class="settings-link-desc">Learn how to use CedarPay</div>
                    </div>
                    <i class="bi bi-chevron-right settings-link-icon"></i>
                </a>
                <a asp-controller="Account" asp-action="DeleteAccount" class="settings-delete-link">
                    <div>
                        <div class="settings-delete-title">Delete Account</div>
                        <div class="settings-delete-desc">Permanently remove your account</div>
                    </div>
                    <i class="bi bi-chevron-right settings-delete-icon"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="tp-card">
            <div class="tp-card-header">
                <span class="tp-card-title">
                    <i class="bi bi-info-circle"></i>
                    About CedarPay
                </span>
            </div>
            <div>
                <div class="settings-about-row">
                    <span class="settings-about-label">Version</span>
                    <span class="settings-about-value">1.0.0</span>
                </div>
                <div class="settings-about-row">
                    <span class="settings-about-label">Platform</span>
                    <span class="settings-about-value">ASP.NET Core 9</span>
                </div>
                <div class="settings-about-row">
                    <span class="settings-about-label">Licensed by</span>
                    <span class="settings-about-value">Banque du Liban</span>
                </div>
                <div class="settings-about-row">
                    <span class="settings-about-label">Support</span>
                    <span class="settings-about-value-highlight">support@cedarpay.lb</span>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const isDark = localStorage.getItem('darkMode') === '1';
            const toggle = document.getElementById('darkToggle');
            const knob = document.getElementById('darkKnob');
            const slider = document.getElementById('darkSlider');

            if (toggle) toggle.checked = isDark;
            if (isDark) {
                if (knob) knob.style.transform = 'translateX(22px)';
                if (slider) slider.style.background = 'var(--teal)';
            }
        });

        function toggleDarkMode(cb) {
            const on = cb.checked;
            localStorage.setItem('darkMode', on ? '1' : '0');
            document.body.classList.toggle('dark-mode', on);

            const knob = document.getElementById('darkKnob');
            const slider = document.getElementById('darkSlider');
            if (knob) knob.style.transform = on ? 'translateX(22px)' : '';
            if (slider) slider.style.background = on ? 'var(--teal)' : '#d0d7e0';
        }
    </script>
}