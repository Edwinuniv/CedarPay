@model MoneyTransfer.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="page-header">
            <div>
                <h2>Change Password</h2>
                <p>Choose a strong password</p>
            </div>
            <a asp-action="Index" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <div class="tp-card">
            <form asp-action="ChangePassword"
                  method="post" class="tp-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All"
                     class="alert-tp error"
                     style="@(ViewData.ModelState.ErrorCount > 0
                                              ? "" : "display:none")">
                </div>

                <div class="form-group">
                    <label class="form-label">Current Password</label>
                    <input asp-for="CurrentPassword"
                           class="form-control"
                           type="password"
                           placeholder="••••••••" />
                    <span asp-validation-for="CurrentPassword"
                          class="text-danger"
                          style="font-size:12px"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">New Password</label>
                    <input asp-for="NewPassword"
                           class="form-control"
                           type="password"
                           placeholder="Min. 8 characters" />
                    <span asp-validation-for="NewPassword"
                          class="text-danger"
                          style="font-size:12px"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           type="password"
                           placeholder="Repeat new password" />
                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"
                          style="font-size:12px"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-tp-primary">
                        <i class="bi bi-lock"></i> Update Password
                    </button>
                    <a asp-action="Index"
                       class="btn-tp-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}