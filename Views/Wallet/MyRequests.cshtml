@model List<MoneyTransfer.Models.WalletRequest>
@{
    ViewData["Title"] = "My Wallet Requests";
}

<div class="page-header">
    <div>
        <h2>Wallet Requests</h2>
        <p>Track your wallet creation requests</p>
    </div>
    <a asp-action="Create" class="btn-tp-primary">
        <i class="bi bi-plus"></i> New Request
    </a>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-wallet2"></i>
            <p>No wallet requests yet.</p>
            <a asp-action="Create" class="btn-tp-primary">
                Request a Wallet
            </a>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var r in Model)
        {
            <div class="tp-card">
                <div style="display:flex;align-items:center;
                                    justify-content:space-between">
                    <div style="display:flex;
                                        align-items:center;gap:12px">
                        <div style="width:44px;height:44px;
                                            border-radius:var(--r-sm);
                                            background:var(--teal-light);
                                            display:flex;align-items:center;
                                            justify-content:center;
                                            font-size:18px;font-weight:800;
                                            color:var(--teal)">
                            @r.Currency?.Symbol
                        </div>
                        <div>
                            <div style="font-weight:700;
                                                color:var(--text-1)">
                                @r.Currency?.Code — @r.Currency?.Name
                            </div>
                            <div style="font-size:12px;
                                                color:var(--text-3)">
                                Requested
                                @r.RequestedAt.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                    </div>
                    <div style="text-align:right">
                        @{
                            var badgeClass = r.Status switch
                            {
                                WalletRequestStatus.Pending => "warning",
                                WalletRequestStatus.Approved => "success",
                                WalletRequestStatus.Rejected => "danger",
                                _ => "default"
                            };
                        }
                        <span class="badge-tp @badgeClass">
                            @r.Status
                        </span>
                        @if (r.ReviewedAt.HasValue)
                        {
                            <div style="font-size:11px;
                                                    color:var(--text-3);
                                                    margin-top:4px">
                                Reviewed
                                @r.ReviewedAt.Value.ToString("MMM dd")
                            </div>
                        }
                    </div>
                </div>
                @if (r.Status == WalletRequestStatus.Rejected &&
                        !string.IsNullOrEmpty(r.RejectionReason))
                {
                    <div style="margin-top:10px;padding:10px 14px;
                                            background:var(--red-light);
                                            border-radius:var(--r-sm);
                                            font-size:13px;color:var(--red)">
                        <i class="bi bi-x-circle"></i>
                        @r.RejectionReason
                    </div>
                }
            </div>
        }
    </div>
}