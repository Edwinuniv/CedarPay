@model List<MoneyTransfer.Models.WalletRequest>
@{
    ViewData["Title"] = "My Wallet Requests";
}

<div class="page-header">
    <div>
        <h2>Wallet Requests</h2>
        <p>Pending and history of all your wallet requests</p>
    </div>
    <div style="display:flex;gap:8px">
        <a asp-action="Index" class="btn-tp-secondary">
            <i class="bi bi-arrow-left"></i> Back to Wallets
        </a>
        <a asp-action="Create" class="btn-tp-primary">
            <i class="bi bi-plus-lg"></i> New Request
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-wallet2"></i>
            <p>No wallet requests yet.</p>
            <a asp-action="Create" class="btn-tp-primary">
                Request a Wallet
            </a>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var r in Model)
        {
            <div class="tp-card">
                <div style="display:flex;align-items:center;
                                            justify-content:space-between;
                                            gap:12px">
                    <div style="display:flex;
                                                align-items:center;
                                                gap:12px">
                        <div style="width:48px;height:48px;
                                                    border-radius:var(--r-md);
                                                    background:var(--teal-light);
                                                    display:flex;
                                                    align-items:center;
                                                    justify-content:center;
                                                    font-size:20px;
                                                    font-weight:800;
                                                    color:var(--teal)">
                            @(r.Currency?.Symbol ?? "?")
                        </div>
                        <div>
                            <div style="font-weight:700;
                                                        font-size:15px;
                                                        color:var(--text-1)">
                                @r.Currency?.Code —
                                @r.Currency?.Name
                            </div>
                            <div style="font-size:12px;
                                                        color:var(--text-3);
                                                        margin-top:2px">
                                Requested
                                @r.RequestedAt.ToString(
                                "MMM dd, yyyy HH:mm")
                    </div>
                </div>
            </div>

            <div style="text-align:right">
                @{
                            var badgeClass = r.Status switch
                            {
                                WalletRequestStatus.Pending
                                => "warning",
                                WalletRequestStatus.Approved
                                => "success",
                                WalletRequestStatus.Rejected
                                => "danger",
                                _ => "default"
                            };
                        }
                        <span class="badge-tp @badgeClass">
                            @r.Status
                        </span>
                        @if (r.ReviewedAt.HasValue)
                        {
                            <div style="font-size:11px;
                                                                color:var(--text-3);
                                                                margin-top:4px">
                                Reviewed
                                @r.ReviewedAt.Value
                                .ToString("MMM dd")
                            </div>
                        }
                    </div>
                </div>

                @if (r.Status == WalletRequestStatus.Rejected
                        && !string.IsNullOrEmpty(
                        r.RejectionReason))
                {
                    <div style="margin-top:12px;
                                                        padding:10px 14px;
                                                        background:var(--red-light);
                                                        border-radius:var(--r-sm);
                                                        font-size:13px;
                                                        color:var(--red)">
                        <i class="bi bi-x-circle"></i>
                        <strong>Reason:</strong>
                        @r.RejectionReason
                        <div style="margin-top:8px">
                            <a asp-action="Create"
                               class="btn-tp-secondary"
                               style="padding:6px 14px;
                                                              font-size:12px">
                                Request Again
                            </a>
                        </div>
                    </div>
                }

                @if (r.Status == WalletRequestStatus.Pending)
                {
                    <div style="margin-top:12px;padding:10px 14px;
                                                        background:var(--yellow-light);
                                                        border-radius:var(--r-sm);
                                                        font-size:13px;
                                                        color:var(--yellow)">
                        <i class="bi bi-clock"></i>
                        Your request is under review.
                        An admin will approve it shortly.
                    </div>
                }

                @if (r.Status == WalletRequestStatus.Approved)
                {
                    <div style="margin-top:12px;padding:10px 14px;
                                                        background:var(--teal-light);
                                                        border-radius:var(--r-sm);
                                                        font-size:13px;
                                                        color:var(--teal-dark)">
                        <i class="bi bi-check-circle-fill"></i>
                        Wallet created successfully!
                        <a asp-controller="Wallet"
                           asp-action="Index"
                           style="color:var(--teal);
                                                          font-weight:600;
                                                          text-decoration:none;
                                                          margin-left:6px">
                            View Wallets →
                        </a>
                    </div>
                }
            </div>
        }
    </div>
}

<div class="tp-card mt-3"
     style="background:var(--surface-2);
            border:1px solid var(--border)">
    <div style="font-size:13px;color:var(--text-2)">
        <i class="bi bi-info-circle"
           style="color:var(--teal);margin-right:6px"></i>
        Wallet creation requires admin approval. Once approved, your wallet will appear in
        <a asp-controller="Wallet" asp-action="Index" style="color:var(--teal)">My Wallets</a>.
    </div>
</div>