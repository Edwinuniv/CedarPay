@model List<MoneyTransfer.Models.WalletRequest>
@{
    ViewData["Title"] = "My Wallet Requests";
    ViewBag.PageClass = "page-wallet";
}

<div class="page-header">
    <div>
        <h2>Wallet Requests</h2>
        <p>Pending and history of all your wallet requests</p>
    </div>
    <div class="wallet-requests-header-actions">
        <a asp-action="Index" class="btn-tp-secondary">
            <i class="bi bi-arrow-left"></i> Back to Wallets
        </a>
        <a asp-action="Create" class="btn-tp-primary">
            <i class="bi bi-plus-lg"></i> New Request
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-wallet2"></i>
            <p>No wallet requests yet.</p>
            <a asp-action="Create" class="btn-tp-primary">
                Request a Wallet
            </a>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var r in Model)
        {
            <div class="tp-card wallet-request-card">
                <div class="wallet-request-row">
                    <div class="wallet-request-info">
                        <div class="wallet-request-symbol-box">
                            @(r.Currency?.Symbol ?? "?")
                        </div>
                        <div class="wallet-request-details">
                            <div class="wallet-request-currency">
                                @r.Currency?.Code — @r.Currency?.Name
                            </div>
                            <div class="wallet-request-date">
                                Requested @r.RequestedAt.ToString("MMM dd, yyyy HH:mm")
                            </div>
                        </div>
                    </div>

                    <div class="wallet-request-right">
                        @{
                            var badgeClass = r.Status switch
                            {
                                WalletRequestStatus.Pending => "warning",
                                WalletRequestStatus.Approved => "success",
                                WalletRequestStatus.Rejected => "danger",
                                _ => "default"
                            };
                        }
                        <span class="badge-tp @badgeClass">
                            @r.Status
                        </span>
                        @if (r.ReviewedAt.HasValue)
                        {
                            <div class="wallet-request-reviewed-date">
                                Reviewed @r.ReviewedAt.Value.ToString("MMM dd")
                            </div>
                        }
                    </div>
                </div>

                @if (r.Status == WalletRequestStatus.Rejected && !string.IsNullOrEmpty(r.RejectionReason))
                {
                    <div class="wallet-request-rejection">
                        <i class="bi bi-x-circle"></i>
                        <strong>Reason:</strong>
                        @r.RejectionReason
                        <div class="wallet-request-rejection-action">
                            <a asp-action="Create" class="btn-tp-secondary wallet-request-rejection-btn">
                                Request Again
                            </a>
                        </div>
                    </div>
                }

                @if (r.Status == WalletRequestStatus.Pending)
                {
                    <div class="wallet-request-pending">
                        <i class="bi bi-clock"></i>
                        Your request is under review. An admin will approve it shortly.
                    </div>
                }

                @if (r.Status == WalletRequestStatus.Approved)
                {
                    <div class="wallet-request-approved">
                        <i class="bi bi-check-circle-fill"></i>
                        Wallet created successfully!
                        <a asp-controller="Wallet" asp-action="Index" class="wallet-request-view-link">
                            View Wallets →
                        </a>
                    </div>
                }
            </div>
        }
    </div>
}

<div class="tp-card wallet-requests-footer">
    <div class="wallet-requests-footer-content">
        <i class="bi bi-info-circle wallet-requests-footer-icon"></i>
        Wallet creation requires admin approval. Once approved, your wallet will appear in
        <a asp-controller="Wallet" asp-action="Index" class="wallet-requests-footer-link">My Wallets</a>.
    </div>
</div>