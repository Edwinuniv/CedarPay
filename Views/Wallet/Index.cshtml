@model List<MoneyTransfer.ViewModels.WalletViewModel>
@{
    ViewData["Title"] = "My Wallets";
    ViewBag.PageClass = "page-wallet";
}

<div class="page-header">
    <div>
        <h2>My Wallets</h2>
        <p>Manage your currency wallets</p>
    </div>
    <div class="wallet-header-actions">
        <a asp-action="MyRequests" class="btn-tp-secondary">
            <i class="bi bi-clock-history"></i> My Requests
        </a>
        <a asp-action="Create" class="btn-tp-primary">
            <i class="bi bi-plus-lg"></i> New Wallet
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-wallet2"></i>
            <p>You don't have any wallets yet.</p>
            <a asp-action="Create" class="btn-tp-primary">
                <i class="bi bi-plus"></i> Create Your First Wallet
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var wallet in Model)
        {
            <div class="col-md-4">
                <div class="tp-card wallet-card @(wallet.IsDefault ? "default" : "")">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="wallet-currency">@wallet.CurrencyCode</div>
                        @if (wallet.IsDefault)
                        {
                            <span class="badge-tp success">Default</span>
                        }
                    </div>
                    <div class="wallet-balance">
                        @wallet.CurrencySymbol@wallet.Balance.ToString("N2")
                    </div>
                    <div class="wallet-currency-name">
                        @wallet.CurrencyName
                    </div>
                    <div class="wallet-serial">@wallet.SerialNumber</div>
                    <div class="wallet-created-date">
                        Created @wallet.CreatedAt.ToString("MMM dd, yyyy")
                    </div>

                    <div class="wallet-actions">
                        @if (!wallet.IsDefault)
                        {
                            <form asp-action="SetDefault" asp-route-id="@wallet.Id"
                                  method="post" class="wallet-action-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-tp-secondary wallet-set-default-btn">
                                    Set Default
                                </button>
                            </form>
                        }
                        @if (!wallet.IsDefault && wallet.Balance == 0)
                        {
                            <form asp-action="Delete" asp-route-id="@wallet.Id"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-tp-danger wallet-delete-btn"
                                        onclick="return confirm('Delete this wallet?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}