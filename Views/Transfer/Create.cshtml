@model MoneyTransfer.ViewModels.TransferViewModel
@using MoneyTransfer.Models
@{
    ViewData["Title"] = "Send Money";
    ViewBag.PageClass = "page-transfer";
}

<div class="transfer-container">
    <div class="col-md-7 mx-auto">

        <div class="page-header">
            <div>
                <h2>Send Money</h2>
                <p>Transfer funds instantly</p>
            </div>
        </div>

        <div class="tp-card">
            <form asp-action="Store" method="post" class="tp-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="alert-tp error"
                     style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>

                <div class="form-group">
                    <label class="form-label">Transfer Type</label>
                    <div class="transfer-type-grid" id="transferTypeGrid">
                        <label class="transfer-type-label" id="lblWallet">
                            <input type="radio" asp-for="TransferType"
                                   value="WalletToWallet"
                                   id="typeWallet"
                                   style="display:none"
                                   onchange="selectTransferType('WalletToWallet')" />
                            <div id="cardWallet" class="transfer-type-card">
                                <i class="bi bi-wallet2 transfer-type-icon"></i>
                                <div class="transfer-type-title">Wallet to Wallet</div>
                                <div class="transfer-type-desc">Transfer to any wallet</div>
                            </div>
                        </label>

                        <label class="transfer-type-label" id="lblMobile">
                            <input type="radio" asp-for="TransferType"
                                   value="MobileTransfer"
                                   id="typeMobile"
                                   style="display:none"
                                   onchange="selectTransferType('MobileTransfer')" />
                            <div id="cardMobile" class="transfer-type-card">
                                <i class="bi bi-phone transfer-type-icon"></i>
                                <div class="transfer-type-title">Mobile Transfer</div>
                                <div class="transfer-type-desc">Send via phone number</div>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">From Wallet</label>
                    <select asp-for="SenderWalletId" class="form-select">
                        <option value="">— Select wallet —</option>
                        @foreach (var w in Model.UserWallets)
                        {
                            <option value="@w.Id">
                                @w.CurrencyCode — @w.CurrencySymbol@w.Balance.ToString("N2")
                                @(w.IsDefault ? "(Default)" : "")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="SenderWalletId" class="text-danger validation-error"></span>
                </div>

                <div class="form-group" id="walletField">
                    <label class="form-label">Receiver Wallet Serial</label>
                    @if (Model.Beneficiaries.Any())
                    {
                        <select class="form-select beneficiary-select" id="beneficiarySelect"
                                onchange="fillBeneficiary(this)">
                            <option value="">— Or select from beneficiaries —</option>
                            @foreach (var b in Model.Beneficiaries)
                            {
                                <option value="@b.ReceiverWalletSerial"
                                        data-phone="@b.ReceiverPhoneNumber"
                                        data-name="@b.ReceiverName"
                                        data-type="@b.Type">
                                    @b.Nickname (@b.ReceiverName)
                                </option>
                            }
                        </select>
                    }
                    <input asp-for="ReceiverWalletSerial" class="form-control"
                           placeholder="WAL-2026-XXXXX" id="walletInput" />
                </div>

                <div id="mobileFields" style="display:none">
                    <div class="form-group">
                        <label class="form-label">Receiver Phone Number</label>
                        <input asp-for="ReceiverPhoneNumber" class="form-control"
                               placeholder="+961 XX XXX XXX" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Receiver Name</label>
                        <input asp-for="ReceiverName" class="form-control"
                               placeholder="Full name" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Amount</label>
                    <input asp-for="Amount" class="form-control"
                           type="number" step="0.01" min="0.01"
                           placeholder="0.00" />
                    <span asp-validation-for="Amount" class="text-danger validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Category</label>
                    <select asp-for="Category" class="form-select"
                            asp-items="Html.GetEnumSelectList<TransactionCategory>()">
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Note (Optional)</label>
                    <input asp-for="Description" class="form-control"
                           placeholder="What's this for?" />
                </div>

                @{
                    bool nxtFree = ViewBag.NextIsFree == true;
                    decimal feePct = ViewBag.FeePercentage != null ? (decimal)ViewBag.FeePercentage : 2.0m;
                    decimal fixedFee = ViewBag.FixedFee != null ? (decimal)ViewBag.FixedFee : 0.50m;
                    int freeEvery = ViewBag.FreeThreshold != null ? (int)ViewBag.FreeThreshold : 10;
                    int txsDone = ViewBag.TxCount != null ? (int)ViewBag.TxCount : 0;
                    int remaining = nxtFree ? 0 : (freeEvery - (txsDone % freeEvery));
                }
                @if (nxtFree)
                {
                    <div class="free-transfer-alert">
                        <i class="bi bi-gift-fill"></i>
                        <strong>🎉 This transfer is FREE!</strong> No fee will be charged.
                    </div>
                }
                else
                {
                    <div class="fee-info-alert">
                        <i class="bi bi-info-circle"></i>
                        Fee: <strong>@feePct.ToString("F1")% + $@fixedFee.ToString("F2")</strong> per transfer.
                        Every <strong>@freeEvery</strong>th is free 🎉 —
                        <strong>@remaining</strong> transfer@(remaining == 1 ? "" : "s") until your next free one.
                    </div>
                }

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-tp-primary">
                        <i class="bi bi-send-fill"></i> Send Money
                    </button>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn-tp-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function selectTransferType(type) {
            const walletCard = document.getElementById('cardWallet');
            const mobileCard = document.getElementById('cardMobile');
            const walletIco = walletCard?.querySelector('i');
            const mobileIco = mobileCard?.querySelector('i');

            if (type === 'WalletToWallet') {
                if (walletCard) walletCard.classList.add('active');
                if (walletIco) walletIco.classList.add('active');
                if (mobileCard) mobileCard.classList.remove('active');
                if (mobileIco) mobileIco.classList.remove('active');

                const wf = document.getElementById('walletField');
                const mf = document.getElementById('mobileFields');
                if (wf) wf.style.display = 'block';
                if (mf) mf.style.display = 'none';
            } else {
                if (mobileCard) mobileCard.classList.add('active');
                if (mobileIco) mobileIco.classList.add('active');
                if (walletCard) walletCard.classList.remove('active');
                if (walletIco) walletIco.classList.remove('active');

                const wf = document.getElementById('walletField');
                const mf = document.getElementById('mobileFields');
                if (wf) wf.style.display = 'none';
                if (mf) mf.style.display = 'block';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const defaultType = '@Model.TransferType';
            if (defaultType === 'MobileTransfer') {
                selectTransferType('MobileTransfer');
                document.getElementById('typeMobile').checked = true;
            } else {
                selectTransferType('WalletToWallet');
                document.getElementById('typeWallet').checked = true;
            }
        });

        function fillBeneficiary(select) {
            const opt = select.options[select.selectedIndex];
            const type = opt.getAttribute('data-type');
            if (type === 'MobileTransfer') {
                document.getElementById('typeMobile').checked = true;
                selectTransferType('MobileTransfer');
                const phoneInput = document.querySelector('[name="ReceiverPhoneNumber"]');
                const nameInput = document.querySelector('[name="ReceiverName"]');
                if (phoneInput) phoneInput.value = opt.getAttribute('data-phone') || '';
                if (nameInput) nameInput.value = opt.getAttribute('data-name') || '';
            } else {
                document.getElementById('typeWallet').checked = true;
                selectTransferType('WalletToWallet');
                const walletInput = document.getElementById('walletInput');
                if (walletInput) walletInput.value = opt.value || '';
            }
        }
    </script>
}