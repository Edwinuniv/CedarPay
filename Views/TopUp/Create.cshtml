@model MoneyTransfer.ViewModels.TopUpViewModel
@{
    ViewData["Title"] = "Top Up";
    bool isAgentOrAdmin =
        User.IsInRole("agent") || User.IsInRole("admin");
    var stripeKey = ViewBag.StripePublishableKey as string ?? "";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="page-header">
            <div>
                <h2>Add Funds</h2>
                <p>Top up your wallet</p>
            </div>
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <!-- Agent/Admin: Cash In/Out shortcut -->
        @if (isAgentOrAdmin)
        {
            <div class="tp-card mb-3"
                 style="background:linear-gradient(135deg,
                            rgba(249,115,22,.1),
                            rgba(249,115,22,.05));
                            border:1px solid rgba(249,115,22,.2)">
                <div style="font-size:13px;font-weight:700;
                                color:var(--text-1);
                                margin-bottom:12px">
                    <i class="bi bi-shop"
                       style="color:var(--orange);
                                  margin-right:6px"></i>
                    Agent Operations
                </div>
                <div style="display:flex;gap:10px">
                    <a asp-controller="Agent"
                       asp-action="CashIn"
                       class="btn-tp-primary"
                       style="flex:1;justify-content:center;
                                  background:var(--teal)">
                        <i class="bi bi-cash-coin"></i>
                        Cash In (Add to User)
                    </a>
                    <a asp-controller="Agent"
                       asp-action="CashOut"
                       class="btn-tp-secondary"
                       style="flex:1;justify-content:center">
                        <i class="bi bi-cash-stack"></i>
                        Cash Out (From User)
                    </a>
                </div>
            </div>
        }

        <!-- Regular Top Up Form -->
        <div class="tp-card">
            <form id="topupForm"
                  asp-action="Store" method="post"
                  class="tp-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="alert-tp error"
                     style="@(ViewData.ModelState
                                              .ErrorCount > 0 ? "" :
                                              "display:none")"></div>

                <div class="form-group">
                    <label class="form-label">
                        Select Wallet
                    </label>
                    <select asp-for="WalletId"
                            class="form-select">
                        <option value="">
                            — Choose wallet —
                        </option>
                        @foreach (var w in Model.UserWallets)
                        {
                            <option value="@w.Id">
                                @w.CurrencyCode —
                                @w.CurrencySymbol@w.Balance.ToString("N2")
                                @(w.IsDefault ? "(Default)" : "")
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Amount</label>
                    <input asp-for="Amount"
                           class="form-control"
                           type="number"
                           step="0.01" min="1"
                           placeholder="0.00"
                           id="amountInput"
                           oninput="updateTotal()" />
                </div>

                <!-- Total display -->
                <div id="totalDisplay"
                     style="display:none;
                            background:var(--surface-2);
                            border-radius:var(--r-sm);
                            padding:12px 16px;
                            font-size:13px">
                    <div style="display:flex;
                                justify-content:space-between">
                        <span style="color:var(--text-3)">
                            Amount
                        </span>
                        <span id="displayAmount">$0.00</span>
                    </div>
                    <div style="display:flex;
                                justify-content:space-between;
                                font-weight:700;
                                margin-top:6px;
                                padding-top:6px;
                                border-top:1px solid var(--border)">
                        <span>Total to add</span>
                        <span id="displayTotal"
                              style="color:var(--teal)">
                            $0.00
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Payment Method
                    </label>
                    <div style="display:grid;
                                grid-template-columns:1fr 1fr;
                                gap:10px"
                         id="methodGrid">
                        <label style="cursor:pointer">
                            <input type="radio"
                                   asp-for="Method"
                                   value="CreditCard"
                                   style="display:none"
                                   class="method-radio" />
                            <div class="method-card"
                                 data-method="CreditCard"
                                 style="padding:14px;
                                        border-radius:var(--r-md);
                                        border:2px solid var(--border);
                                        background:var(--surface-2);
                                        text-align:center;
                                        cursor:pointer;
                                        transition:var(--transition)">
                                <i class="bi bi-credit-card-fill"
                                   style="font-size:24px;
                                          display:block;
                                          margin-bottom:6px;
                                          color:var(--purple)"></i>
                                <div style="font-size:13px;
                                            font-weight:600">
                                    Credit Card
                                </div>
                                <div style="font-size:11px;
                                            color:var(--text-3)">
                                    Stripe Secure
                                </div>
                            </div>
                        </label>

                        <label style="cursor:pointer">
                            <input type="radio"
                                   asp-for="Method"
                                   value="BankTransfer"
                                   style="display:none"
                                   class="method-radio" />
                            <div class="method-card"
                                 data-method="BankTransfer"
                                 style="padding:14px;
                                        border-radius:var(--r-md);
                                        border:2px solid var(--border);
                                        background:var(--surface-2);
                                        text-align:center;
                                        cursor:pointer;
                                        transition:var(--transition)">
                                <i class="bi bi-bank"
                                   style="font-size:24px;
                                          display:block;
                                          margin-bottom:6px;
                                          color:var(--teal)"></i>
                                <div style="font-size:13px;
                                            font-weight:600">
                                    Bank Transfer
                                </div>
                                <div style="font-size:11px;
                                            color:var(--text-3)">
                                    Manual process
                                </div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Stripe Card Element -->
                <div id="stripeSection"
                     style="display:none">
                    <div class="form-group">
                        <label class="form-label">
                            Card Details
                        </label>
                        <div id="card-element"
                             style="padding:12px 14px;
                                    border:1px solid var(--border-md);
                                    border-radius:var(--r-sm);
                                    background:var(--surface-2)">
                        </div>
                        <div id="card-errors"
                             style="color:var(--red);
                                    font-size:12px;
                                    margin-top:6px">
                        </div>
                        <div style="font-size:12px;
                                    color:var(--text-3);
                                    margin-top:6px">
                            🔒 Test card:
                            <code>4242 4242 4242 4242</code>
                            · Any future date · Any CVC
                        </div>
                    </div>
                    <!-- Hidden token input for Stripe -->
                    <input type="hidden"
                           name="stripeToken"
                           id="stripeToken" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Note (Optional)
                    </label>
                    <input asp-for="Description"
                           class="form-control"
                           placeholder="What's this top up for?" />
                </div>

                <button type="submit"
                        id="submitBtn"
                        class="btn-tp-primary"
                        style="width:100%;
                               justify-content:center;
                               padding:14px">
                    <i class="bi bi-plus-circle-fill"></i>
                    Add Funds
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        const stripeKey = '@stripeKey';
        let stripe = null;
        let cardElement = null;

        if (stripeKey) {
            stripe = Stripe(stripeKey);
            const elements = stripe.elements();
            cardElement = elements.create('card', {
                style: {
                    base: {
                        fontSize: '14px',
                        color: '#1a1a2e',
                        fontFamily:
                            "'Plus Jakarta Sans', sans-serif",
                        '::placeholder': {
                            color: '#b0b8c4'
                        }
                    }
                }
            });
        }

        // Method card selector
        document.querySelectorAll('.method-radio')
            .forEach(radio => {
                radio.addEventListener('change', () => {
                    // Reset all
                    document.querySelectorAll('.method-card')
                        .forEach(c => {
                            c.style.borderColor =
                                'var(--border)';
                            c.style.background =
                                'var(--surface-2)';
                        });

                    // Highlight selected
                    const card = radio.closest('label')
                        .querySelector('.method-card');
                    if (card) {
                        card.style.borderColor =
                            'var(--teal)';
                        card.style.background =
                            'var(--teal-light)';
                    }

                    // Show/hide Stripe
                    const stripeSection =
                        document.getElementById(
                            'stripeSection');
                    if (radio.value === 'CreditCard' ||
                        radio.value === 'DebitCard')
                    {
                        stripeSection.style.display = 'block';
                        if (cardElement) {
                            cardElement.mount('#card-element');
                        }
                    } else {
                        stripeSection.style.display = 'none';
                    }
                });
            });

        // Default select Credit Card
        document.addEventListener('DOMContentLoaded', () => {
            const firstRadio =
                document.querySelector('.method-radio');
            if (firstRadio) {
                firstRadio.checked = true;
                firstRadio.dispatchEvent(
                    new Event('change'));
            }
        });

        function updateTotal() {
            const amount = parseFloat(
                document.getElementById('amountInput')
                    .value) || 0;
            const display =
                document.getElementById('totalDisplay');
            const dispAmt =
                document.getElementById('displayAmount');
            const dispTotal =
                document.getElementById('displayTotal');

            if (amount > 0) {
                display.style.display = 'block';
                dispAmt.textContent = '$' +
                    amount.toFixed(2);
                dispTotal.textContent = '$' +
                    amount.toFixed(2);
            } else {
                display.style.display = 'none';
            }
        }

        // Handle form submission with Stripe
        document.getElementById('topupForm')
            .addEventListener('submit', async (e) => {
                const method = document.querySelector(
                    '.method-radio:checked')?.value;

                if ((method === 'CreditCard' ||
                     method === 'DebitCard') &&
                    stripe && cardElement)
                {
                    e.preventDefault();

                    const submitBtn =
                        document.getElementById('submitBtn');
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Processing...';

                    const { token, error } =
                        await stripe.createToken(
                            cardElement);

                    if (error) {
                        document.getElementById(
                            'card-errors').textContent =
                            error.message;
                        submitBtn.disabled = false;
                        submitBtn.innerHTML =
                            '<i class="bi bi-plus-circle-fill"></i> Add Funds';
                    } else {
                        document.getElementById(
                            'stripeToken').value = token.id;
                        e.target.submit();
                    }
                }
            });
    </script>
}