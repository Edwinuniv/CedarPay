@model MoneyTransfer.ViewModels.TopUpViewModel
@{
    ViewData["Title"] = "Top Up";
    ViewBag.PageClass = "page-topup";
    bool isAgentOrAdmin = User.IsInRole("agent") || User.IsInRole("admin");
    var stripeKey = ViewBag.StripePublishableKey as string ?? "";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="page-header">
            <div>
                <h2>Add Funds</h2>
                <p>Top up your wallet</p>
            </div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        @if (isAgentOrAdmin)
        {
            <div class="tp-card mb-3 topup-agent-card">
                <div class="topup-agent-header">
                    <i class="bi bi-shop topup-agent-icon"></i>
                    Agent Operations
                </div>
                <div class="topup-agent-actions">
                    <a asp-controller="Agent" asp-action="CashIn" class="btn-tp-primary topup-agent-cashin">
                        <i class="bi bi-cash-coin"></i> Cash In (Add to User)
                    </a>
                    <a asp-controller="Agent" asp-action="CashOut" class="btn-tp-secondary topup-agent-cashout">
                        <i class="bi bi-cash-stack"></i> Cash Out (From User)
                    </a>
                </div>
            </div>
        }

        <div class="tp-card">
            <form id="topupForm" asp-action="Store" method="post" class="tp-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="alert-tp error"
                     style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>

                <div class="form-group">
                    <label class="form-label">Select Wallet</label>
                    <select asp-for="WalletId" class="form-select" id="walletSelect" onchange="onWalletChange()">
                        <option value="">— Choose wallet —</option>
                        @foreach (var w in Model.UserWallets)
                        {
                            <option value="@w.Id"
                                    data-symbol="@w.CurrencySymbol"
                                    data-code="@w.CurrencyCode">
                                @w.CurrencyCode — @w.CurrencySymbol@w.Balance.ToString("N2")
                                @(w.IsDefault ? "(Default)" : "")
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Amount</label>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="1" placeholder="0.00" id="amountInput" oninput="updateTotal()" />
                </div>

                <div id="totalDisplay" class="topup-total-display">
                    <div class="topup-total-row">
                        <span class="topup-total-label">Amount</span>
                        <span id="displayAmount">$0.00</span>
                    </div>
                    <div class="topup-total-divider">
                        <span>Total to add</span>
                        <span id="displayTotal" class="topup-total-value">$0.00</span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Payment Method</label>
                    <div class="topup-method-grid" id="methodGrid">
                        <label class="topup-method-label">
                            <input type="radio" asp-for="Method" value="CreditCard" style="display:none" class="method-radio" />
                            <div class="topup-method-card" data-method="CreditCard">
                                <i class="bi bi-credit-card-fill topup-method-icon purple"></i>
                                <div class="topup-method-title">Credit Card</div>
                                <div class="topup-method-desc">Stripe Secure</div>
                            </div>
                        </label>

                        <label class="topup-method-label">
                            <input type="radio" asp-for="Method" value="BankTransfer" style="display:none" class="method-radio" />
                            <div class="topup-method-card" data-method="BankTransfer">
                                <i class="bi bi-bank topup-method-icon teal"></i>
                                <div class="topup-method-title">Bank Transfer</div>
                                <div class="topup-method-desc">Manual process</div>
                            </div>
                        </label>
                    </div>
                </div>

                <div id="stripeSection" class="topup-stripe-section">
                    <div class="form-group">
                        <label class="form-label">Card Details</label>
                        <div id="card-element" class="topup-card-element"></div>
                        <div id="card-errors" class="topup-card-errors"></div>
                        <div class="topup-card-hint">
                            🔒 Test card: <code>4242 4242 4242 4242</code> · Any future date · Any CVC
                        </div>
                    </div>
                    <input type="hidden" name="stripeToken" id="stripeToken" />
                </div>

                <div class="form-group">
                    <label class="form-label">Note (Optional)</label>
                    <input asp-for="Description" class="form-control" placeholder="What's this top up for?" />
                </div>

                <button type="submit" id="submitBtn" class="btn-tp-primary topup-submit-btn">
                    <i class="bi bi-plus-circle-fill"></i> Add Funds
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        const stripeKey = '@stripeKey';
        let stripe = null;
        let cardElement = null;

        if (stripeKey) {
            stripe = Stripe(stripeKey);
            const elements = stripe.elements();
            cardElement = elements.create('card', {
                style: {
                    base: {
                        fontSize: '14px',
                        color: '#1a1a2e',
                        fontFamily: "'Plus Jakarta Sans', sans-serif",
                        '::placeholder': { color: '#b0b8c4' }
                    }
                }
            });
        }

        document.querySelectorAll('.method-radio').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.topup-method-card').forEach(c => {
                    c.classList.remove('active');
                });

                const card = radio.closest('label').querySelector('.topup-method-card');
                if (card) card.classList.add('active');

                const stripeSection = document.getElementById('stripeSection');
                if (radio.value === 'CreditCard' || radio.value === 'DebitCard') {
                    stripeSection.style.display = 'block';
                    if (cardElement) cardElement.mount('#card-element');
                } else {
                    stripeSection.style.display = 'none';
                }
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            onWalletChange();
            const firstRadio = document.querySelector('.method-radio');
            if (firstRadio) {
                firstRadio.checked = true;
                firstRadio.dispatchEvent(new Event('change'));
            }
        });

        let currentSymbol = '$';
        let currentCode = 'USD';

        function onWalletChange() {
            const sel = document.getElementById('walletSelect');
            const opt = sel.options[sel.selectedIndex];
            currentSymbol = opt.getAttribute('data-symbol') || '$';
            currentCode = opt.getAttribute('data-code') || 'USD';
            updateTotal();
        }

        function updateTotal() {
            const amount = parseFloat(document.getElementById('amountInput').value) || 0;
            const display = document.getElementById('totalDisplay');
            const dispAmt = document.getElementById('displayAmount');
            const dispTotal = document.getElementById('displayTotal');

            if (amount > 0) {
                display.style.display = 'block';
                dispAmt.textContent = currentSymbol + amount.toFixed(2);
                dispTotal.textContent = currentSymbol + amount.toFixed(2);
            } else {
                display.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            onWalletChange();
        });

        document.getElementById('topupForm').addEventListener('submit', async (e) => {
            const method = document.querySelector('.method-radio:checked')?.value;

            if ((method === 'CreditCard' || method === 'DebitCard') && stripe && cardElement) {
                e.preventDefault();

                const submitBtn = document.getElementById('submitBtn');
                submitBtn.disabled = true;
                submitBtn.textContent = 'Processing...';

                const { token, error } = await stripe.createToken(cardElement);

                if (error) {
                    document.getElementById('card-errors').textContent = error.message;
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-plus-circle-fill"></i> Add Funds';
                } else {
                    document.getElementById('stripeToken').value = token.id;
                    e.target.submit();
                }
            }
        });
    </script>
}