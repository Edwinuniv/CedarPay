@model List<MoneyTransfer.Models.ScheduledTransfer>
@{
    ViewData["Title"] = "Scheduled Transfers";
    ViewBag.PageClass = "page-transfer";
    var wallets = ViewBag.Wallets as List<MoneyTransfer.Models.Wallet> ?? new();
}

<div class="page-header">
    <div>
        <h2>Scheduled Transfers</h2>
        <p>Recurring and future-dated payments</p>
    </div>
    <button onclick="document.getElementById('createModal').style.display='flex'" class="btn-tp-primary">
        <i class="bi bi-plus-circle"></i> New Schedule
    </button>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state" style="padding:60px 20px;text-align:center">
            <i class="bi bi-calendar-check" style="font-size:40px;color:var(--text-3);display:block;margin-bottom:12px"></i>
            <p>No scheduled transfers yet.</p>
            <button onclick="document.getElementById('createModal').style.display='flex'" class="btn-tp-primary mt-2">
                <i class="bi bi-plus-circle"></i> Create One
            </button>
        </div>
    </div>
}
else
{
    <div class="tp-card">
        <div class="tp-card-header">
            <span class="tp-card-title"><i class="bi bi-calendar-week"></i> Your Schedules</span>
            <span class="badge-tp default">@Model.Count</span>
        </div>
        <div class="scheduled-list">
            @foreach (var s in Model)
            {
                var isPaused = !s.IsActive;
                <div class="scheduled-item @(isPaused ? "paused" : "")">
                    <div class="scheduled-icon">
                        <i class="bi bi-arrow-repeat" style="color:var(--teal)"></i>
                    </div>
                    <div class="scheduled-info">
                        <div class="scheduled-amount">
                            @s.SenderWallet?.Currency?.Symbol@s.Amount.ToString("N2")
                            <span class="badge-tp @(s.IsActive ? "success" : "warning")" style="font-size:10px;margin-left:6px">
                                @(s.IsActive ? "Active" : "Paused")
                            </span>
                        </div>
                        <div class="scheduled-meta">
                            <span><i class="bi bi-wallet2"></i> @s.SenderWallet?.SerialNumber</span>
                            <span>→</span>
                            <span>@(s.ReceiverWalletSerial ?? s.ReceiverPhoneNumber ?? "Unknown")</span>
                            @if (!string.IsNullOrEmpty(s.ReceiverName))
                            {
                                <span style="color:var(--text-3)">(@s.ReceiverName)</span>
                            }
                        </div>
                        <div class="scheduled-meta" style="margin-top:4px">
                            <span class="badge-tp default" style="font-size:10px">@s.Frequency</span>
                            <span style="color:var(--text-3);font-size:11px">
                                Next: @s.NextRunAt.ToString("MMM dd, yyyy")
                            </span>
                            <span style="color:var(--text-3);font-size:11px">
                                Ran @s.ExecutionCount time@(s.ExecutionCount != 1 ? "s" : "")
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(s.Description))
                        {
                            <div style="font-size:11px;color:var(--text-3);margin-top:3px">@s.Description</div>
                        }
                    </div>
                    <div class="scheduled-actions">
                        <form asp-action="ToggleActive" method="post" style="margin:0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <button type="submit" class="btn-tp-secondary" style="font-size:12px;padding:5px 10px" title="@(s.IsActive ? "Pause" : "Resume")">
                                <i class="bi @(s.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                            </button>
                        </form>
                        <form asp-action="Delete" method="post" style="margin:0"
                              onsubmit="return confirm('Delete this scheduled transfer?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <button type="submit" class="btn-tp-secondary" style="font-size:12px;padding:5px 10px;color:var(--red)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div id="createModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center">
    <div style="background:var(--surface-1);border-radius:16px;padding:28px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
            <h3 style="margin:0">New Scheduled Transfer</h3>
            <button onclick="document.getElementById('createModal').style.display='none'" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-3)">×</button>
        </div>
        <form asp-action="Create" method="post" class="tp-form">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">From Wallet</label>
                <select name="senderWalletId" class="form-select" required>
                    <option value="">— Select wallet —</option>
                    @foreach (var w in wallets)
                    {
                        <option value="@w.Id">@w.Currency?.Code — @w.Currency?.Symbol@w.Balance.ToString("N2")</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Receiver Wallet Serial</label>
                <input type="text" name="receiverWalletSerial" class="form-control" placeholder="WAL-2026-XXXXX" />
            </div>
            <div class="form-group">
                <label class="form-label">Or Receiver Phone</label>
                <input type="text" name="receiverPhoneNumber" class="form-control" placeholder="+961 XX XXX XXX" />
            </div>
            <div class="form-group">
                <label class="form-label">Receiver Name</label>
                <input type="text" name="receiverName" class="form-control" placeholder="Full name (optional)" />
            </div>
            <div class="form-group">
                <label class="form-label">Amount</label>
                <input type="number" name="amount" class="form-control" step="0.01" min="0.01" required placeholder="0.00" />
            </div>
            <div class="form-group">
                <label class="form-label">Note (optional)</label>
                <input type="text" name="description" class="form-control" placeholder="What's this for?" />
            </div>
            <div class="form-group">
                <label class="form-label">Frequency</label>
                <select name="frequency" class="form-select">
                    <option value="0">Daily</option>
                    <option value="1">Weekly</option>
                    <option value="2" selected>Monthly</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">First Run Date</label>
                <input type="datetime-local" name="firstRunAt" class="form-control" required
                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-tp-primary">
                    <i class="bi bi-check-lg"></i> Schedule
                </button>
                <button type="button" onclick="document.getElementById('createModal').style.display='none'" class="btn-tp-secondary">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .scheduled-list {
        padding: 0 4px 4px;
    }

    .scheduled-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        transition: var(--transition);
    }

        .scheduled-item:last-child {
            border-bottom: none;
        }

        .scheduled-item:hover {
            background: var(--surface-2);
        }

        .scheduled-item.paused {
            opacity: 0.6;
        }

    .scheduled-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--teal-light);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 18px;
    }

    .scheduled-info {
        flex: 1;
        min-width: 0;
    }

    .scheduled-amount {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-1);
        display: flex;
        align-items: center;
        margin-bottom: 6px;
    }

    .scheduled-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--text-2);
        flex-wrap: wrap;
    }

    .scheduled-actions {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }
</style>
