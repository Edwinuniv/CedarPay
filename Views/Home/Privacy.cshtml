@{
    ViewData["Title"] = "Privacy Policy";
    ViewBag.PageClass = "page-dashboard";
}

<div class="privacy-container">
    <div class="privacy-header">
        <div class="privacy-icon">🔒</div>
        <h1 class="privacy-title">Privacy Policy</h1>
        <p class="privacy-subtitle">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
    </div>

    <div class="tp-card privacy-card">
        <h2 class="privacy-section-title">1. Information We Collect</h2>
        <p class="privacy-text">
            CedarPay collects personal information that you provide to us, including your name, email address,
            phone number, and identity documents for KYC verification. We also collect transaction data
            and wallet activity to provide our services.
        </p>

        <h2 class="privacy-section-title">2. How We Use Your Information</h2>
        <p class="privacy-text">
            We use your information to process transactions, verify your identity, prevent fraud,
            comply with regulatory requirements, and improve our services. We never sell your personal
            data to third parties.
        </p>

        <h2 class="privacy-section-title">3. Data Security</h2>
        <p class="privacy-text">
            Your data is encrypted using industry-standard protocols. We employ bank-grade security
            measures to protect your personal and financial information.
        </p>

        <h2 class="privacy-section-title">4. Your Rights</h2>
        <p class="privacy-text">
            You have the right to access, correct, or delete your personal information. You may also
            request a copy of your data or restrict certain processing activities.
        </p>

        <h2 class="privacy-section-title">5. Contact Us</h2>
        <p class="privacy-text">
            If you have questions about this privacy policy, please contact us at
            <a href="mailto:privacy@cedarpay.com" class="privacy-link">privacy@cedarpay.com</a>
        </p>

        <div class="privacy-footer">
            <a asp-controller="Home" asp-action="Index" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back to Home
            </a>
        </div>
    </div>
</div>
