@{
    ViewData["Title"] = "About Us - CedarPay";
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About Us - CedarPay</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/transferpay.css" asp-append-version="true" />

    <script>
        (function() {
            if (localStorage.getItem('darkMode') === '1') {
                document.documentElement.classList.add('dark-mode');
                if (document.body) document.body.classList.add('dark-mode');
            }
        })();
    </script>
</head>
<body class="home-page">

    <nav class="public-nav">
        <div class="sidebar-brand" style="padding:0;margin:0">
            <div class="brand-icon">
                <img src="/images/cedarpay-logo.png" alt="CedarPay" style="width:28px;height:28px;object-fit:contain" />
            </div>
            <span class="brand-name">
                Cedar<span class="brand-accent">Pay</span>
            </span>
        </div>
        <div class="public-nav-links">
            <a asp-controller="Home" asp-action="Index" class="btn-login">Home</a>
            <a asp-controller="Home" asp-action="Features" class="btn-login">Features</a>
            <a asp-controller="Home" asp-action="AboutUs" class="btn-login">About</a>
            <a asp-controller="Home" asp-action="SecurityPolicy" class="btn-login">Security</a>
            <a asp-controller="Home" asp-action="ContactUs" class="btn-login">Contact</a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn-login">Login</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-register">Register</a>
        </div>
    </nav>

    <div class="home-container">
        @if (!string.IsNullOrEmpty(returnUrl) && returnUrl.Contains("/Settings"))
        {
            <div class="mb-3">
                <a href="@returnUrl" class="btn-tp-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Settings
                </a>
            </div>
        }

        <div class="home-hero">
            <div class="home-hero-icon">🌲</div>
            <h1 class="home-title">About <span class="home-title-accent">CedarPay</span></h1>
            <p class="home-subtitle">Lebanon's trusted digital payment platform</p>
        </div>

        <div class="tp-card mb-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h2 style="color: var(--cedar-gold); margin-bottom: 20px;">Our Story</h2>
                    <p style="font-size: 16px; line-height: 1.6; margin-bottom: 15px;">
                        CedarPay was founded with a simple mission: to provide Lebanon with a fast, secure, and
                        accessible digital payment solution. In a country facing economic challenges, we believe
                        that reliable financial technology can empower individuals and businesses alike.
                    </p>
                    <p style="font-size: 16px; line-height: 1.6;">
                        Built by Lebanese developers for the Lebanese people, CedarPay combines cutting-edge
                        technology with local expertise to deliver a platform that truly understands the needs
                        of our community.
                    </p>
                </div>
                <div class="col-md-4 text-center">
                    <div style="font-size: 80px;">🇱🇧</div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="tp-card home-feature-card text-center">
                    <div class="home-feature-icon">🎯</div>
                    <h3 class="home-feature-title">Our Mission</h3>
                    <p class="home-feature-text">
                        To democratize financial services in Lebanon by providing secure, instant,
                        and affordable digital payment solutions for everyone.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="tp-card home-feature-card text-center">
                    <div class="home-feature-icon">👁️</div>
                    <h3 class="home-feature-title">Our Vision</h3>
                    <p class="home-feature-text">
                        To become Lebanon's leading digital payment ecosystem, connecting individuals,
                        businesses, and agents across the nation.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="tp-card home-feature-card text-center">
                    <div class="home-feature-icon">💎</div>
                    <h3 class="home-feature-title">Our Values</h3>
                    <p class="home-feature-text">
                        Transparency, Security, Innovation, and Lebanese Pride in everything we do.
                    </p>
                </div>
            </div>
        </div>

        <div class="tp-card mb-4">
            <div class="text-center">
                <h2 style="color: var(--cedar-gold); margin-bottom: 30px;">Why Choose CedarPay?</h2>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div style="font-size: 36px; margin-bottom: 10px;">⚡</div>
                        <h4 style="margin-bottom: 10px;">Instant</h4>
                        <p style="font-size: 13px; color: var(--text-3);">Real-time transfers</p>
                    </div>
                    <div class="col-md-3">
                        <div style="font-size: 36px; margin-bottom: 10px;">🔒</div>
                        <h4 style="margin-bottom: 10px;">Secure</h4>
                        <p style="font-size: 13px; color: var(--text-3);">Bank-grade encryption</p>
                    </div>
                    <div class="col-md-3">
                        <div style="font-size: 36px; margin-bottom: 10px;">💎</div>
                        <h4 style="margin-bottom: 10px;">Low Fees</h4>
                        <p style="font-size: 13px; color: var(--text-3);">Affordable rates</p>
                    </div>
                    <div class="col-md-3">
                        <div style="font-size: 36px; margin-bottom: 10px;">🌍</div>
                        <h4 style="margin-bottom: 10px;">Multi-Currency</h4>
                        <p style="font-size: 13px; color: var(--text-3);">USD, LBP, EUR & more</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="home-footer">
            <div class="home-footer-links">
                <a asp-controller="Home" asp-action="Index" class="home-footer-link">Home</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Features" class="home-footer-link">Features</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="AboutUs" class="home-footer-link">About</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="SecurityPolicy" class="home-footer-link">Security</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="ContactUs" class="home-footer-link">Contact</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Privacy" class="home-footer-link">Privacy</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Terms" class="home-footer-link">Terms</a>
            </div>
            <p class="home-footer-copyright">© @DateTime.Now.Year CedarPay — Licensed by Banque du Liban</p>
        </div>
    </div>

</body>
</html>