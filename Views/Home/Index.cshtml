@{
    ViewData["Title"] = "CedarPay - Send Money. Support Home.";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CedarPay - Lebanon's Digital Wallet</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/transferpay.css" asp-append-version="true" />

    <script>
        (function() {
            if (localStorage.getItem('darkMode') === '1') {
                document.documentElement.classList.add('dark-mode');
                if (document.body) document.body.classList.add('dark-mode');
            }
        })();
    </script>
</head>
<body class="home-page">

    <nav class="public-nav">
        <div class="sidebar-brand" style="padding:0;margin:0">
            <div class="brand-icon">
                <img src="/images/cedarpay-logo.png" alt="CedarPay" style="width:28px;height:28px;object-fit:contain" />
            </div>
            <span class="brand-name">
                Cedar<span class="brand-accent">Pay</span>
            </span>
        </div>
        <div class="public-nav-links">
            <a asp-controller="Home" asp-action="Index" class="btn-login">Home</a>
            <a asp-controller="Home" asp-action="Features" class="btn-login">Features</a>
            <a asp-controller="Home" asp-action="AboutUs" class="btn-login">About</a>
            <a asp-controller="Home" asp-action="SecurityPolicy" class="btn-login">Security</a>
            <a asp-controller="Home" asp-action="ContactUs" class="btn-login">Contact</a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn-login">Login</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-register">Register</a>
        </div>
    </nav>

    <div class="home-container">
        <div class="home-hero">
            <div class="home-hero-icon">🌲</div>
            <h1 class="home-title">Welcome to <span class="home-title-accent">CedarPay</span></h1>
            <p class="home-subtitle">Lebanon's fastest-growing digital payment platform</p>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="tp-card home-feature-card">
                    <div class="home-feature-icon">💰</div>
                    <h3 class="home-feature-title">Instant Transfers</h3>
                    <p class="home-feature-text">Send and receive money instantly with our secure platform.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="tp-card home-feature-card">
                    <div class="home-feature-icon">🌍</div>
                    <h3 class="home-feature-title">Multi-Currency</h3>
                    <p class="home-feature-text">Support for USD, EUR, LBP, AED and more currencies.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="tp-card home-feature-card">
                    <div class="home-feature-icon">🔒</div>
                    <h3 class="home-feature-title">Secure & Safe</h3>
                    <p class="home-feature-text">Bank-grade security with full encryption and KYC verification.</p>
                </div>
            </div>
        </div>

        <div class="tp-card home-cultural-card">
            <div class="home-cultural-content">
                <div class="home-cultural-text">
                    <h3 class="home-cultural-title">🇱🇧 Proudly Lebanese</h3>
                    <p class="home-cultural-desc">
                        CedarPay is built for Lebanon, by Lebanese developers.
                        We're committed to providing a reliable, secure, and
                        accessible payment platform for all Lebanese citizens.
                    </p>
                    <div class="home-flag-stripes">
                        <span class="home-flag-red"></span>
                        <span class="home-flag-white"></span>
                        <span class="home-flag-green"></span>
                    </div>
                </div>
                <div class="home-cultural-icon">🌲</div>
            </div>
        </div>

        <div class="home-cta">
            <h3 class="home-cta-title">Ready to get started?</h3>
            <p class="home-cta-text">Join thousands of happy customers using CedarPay daily.</p>
            <div class="home-cta-buttons">
                <a asp-area="Identity" asp-page="/Account/Register" class="btn-tp-primary home-cta-btn-primary">
                    <i class="bi bi-person-plus-fill"></i> Create Account
                </a>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn-tp-secondary home-cta-btn-secondary">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </a>
            </div>
        </div>

        <div class="home-footer">
            <div class="home-footer-links">
                <a asp-controller="Home" asp-action="Index" class="home-footer-link">Home</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Features" class="home-footer-link">Features</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="AboutUs" class="home-footer-link">About</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="SecurityPolicy" class="home-footer-link">Security</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="ContactUs" class="home-footer-link">Contact</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Privacy" class="home-footer-link">Privacy</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Terms" class="home-footer-link">Terms</a>
            </div>
            <p class="home-footer-copyright">© @DateTime.Now.Year CedarPay — Licensed by Banque du Liban</p>
        </div>
    </div>

</body>
</html>