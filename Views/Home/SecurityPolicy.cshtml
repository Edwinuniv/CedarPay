@{
    ViewData["Title"] = "Security Policy - CedarPay";
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Security Policy - CedarPay</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/transferpay.css" asp-append-version="true" />

    <script>
        (function() {
            if (localStorage.getItem('darkMode') === '1') {
                document.documentElement.classList.add('dark-mode');
                if (document.body) document.body.classList.add('dark-mode');
            }
        })();
    </script>
</head>
<body class="home-page">

    <nav class="public-nav">
        <div class="sidebar-brand" style="padding:0;margin:0">
            <div class="brand-icon">
                <img src="/images/cedarpay-logo.png" alt="CedarPay" style="width:28px;height:28px;object-fit:contain" />
            </div>
            <span class="brand-name">
                Cedar<span class="brand-accent">Pay</span>
            </span>
        </div>
        <div class="public-nav-links">
            <a asp-controller="Home" asp-action="Index" class="btn-login">Home</a>
            <a asp-controller="Home" asp-action="Features" class="btn-login">Features</a>
            <a asp-controller="Home" asp-action="AboutUs" class="btn-login">About</a>
            <a asp-controller="Home" asp-action="SecurityPolicy" class="btn-login">Security</a>
            <a asp-controller="Home" asp-action="ContactUs" class="btn-login">Contact</a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn-login">Login</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-register">Register</a>
        </div>
    </nav>

    <div class="home-container">
        @if (!string.IsNullOrEmpty(returnUrl) && returnUrl.Contains("/Settings"))
        {
            <div class="mb-3">
                <a href="@returnUrl" class="btn-tp-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Settings
                </a>
            </div>
        }

        <div class="home-hero">
            <div class="home-hero-icon">🔒</div>
            <h1 class="home-title">Security <span class="home-title-accent">Policy</span></h1>
            <p class="home-subtitle">Your security is our top priority</p>
        </div>

        <div class="tp-card mb-4">
            <h2 style="color: var(--cedar-gold); margin-bottom: 20px;">Bank-Grade Security</h2>
            <p style="font-size: 16px; line-height: 1.6;">
                At CedarPay, we employ enterprise-grade security measures to protect your financial data and transactions.
                Our platform is built with multiple layers of security to ensure your money and information stay safe.
            </p>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="tp-card home-feature-card text-center">
                    <div class="home-feature-icon">🔐</div>
                    <h3 class="home-feature-title">End-to-End Encryption</h3>
                    <p class="home-feature-text">All data transmitted between your device and our servers is encrypted using TLS 1.3, the highest standard available.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="tp-card home-feature-card text-center">
                    <div class="home-feature-icon">🛡️</div>
                    <h3 class="home-feature-title">PCI DSS Compliant</h3>
                    <p class="home-feature-text">We adhere to Payment Card Industry Data Security Standards for all payment processing.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="tp-card home-feature-card text-center">
                    <div class="home-feature-icon">👁️</div>
                    <h3 class="home-feature-title">24/7 Monitoring</h3>
                    <p class="home-feature-text">Our security team monitors the platform around the clock for suspicious activity.</p>
                </div>
            </div>
        </div>

        <div class="tp-card mb-4">
            <h2 style="color: var(--cedar-gold); margin-bottom: 20px;">Security Measures</h2>
            <div class="row">
                <div class="col-md-6">
                    <ul style="list-style: none; padding-left: 0;">
                        <li style="margin-bottom: 12px;"><i class="bi bi-check-circle-fill" style="color: #00b894; margin-right: 10px;"></i> Two-Factor Authentication (2FA)</li>
                        <li style="margin-bottom: 12px;"><i class="bi bi-check-circle-fill" style="color: #00b894; margin-right: 10px;"></i> Biometric Login Support</li>
                        <li style="margin-bottom: 12px;"><i class="bi bi-check-circle-fill" style="color: #00b894; margin-right: 10px;"></i> Automatic Session Timeout</li>
                        <li style="margin-bottom: 12px;"><i class="bi bi-check-circle-fill" style="color: #00b894; margin-right: 10px;"></i> Device Fingerprinting</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul style="list-style: none; padding-left: 0;">
                        <li style="margin-bottom: 12px;"><i class="bi bi-check-circle-fill" style="color: #00b894; margin-right: 10px;"></i> KYC Verification Requirements</li>
                        <li style="margin-bottom: 12px;"><i class="bi bi-check-circle-fill" style="color: #00b894; margin-right: 10px;"></i> Fraud Detection Algorithms</li>
                        <li style="margin-bottom: 12px;"><i class="bi bi-check-circle-fill" style="color: #00b894; margin-right: 10px;"></i> Secure Data Centers</li>
                        <li style="margin-bottom: 12px;"><i class="bi bi-check-circle-fill" style="color: #00b894; margin-right: 10px;"></i> Regular Security Audits</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="tp-card mb-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h2 style="color: var(--cedar-gold); margin-bottom: 20px;">Your Responsibility</h2>
                    <p style="font-size: 16px; line-height: 1.6;">
                        While we provide robust security measures, you play an important role in keeping your account secure:
                    </p>
                    <ul style="margin-top: 15px;">
                        <li>Use a strong, unique password</li>
                        <li>Never share your login credentials</li>
                        <li>Enable Two-Factor Authentication</li>
                        <li>Regularly review your transaction history</li>
                        <li>Report suspicious activity immediately</li>
                    </ul>
                </div>
                <div class="col-md-4 text-center">
                    <div style="font-size: 80px;">🛡️</div>
                </div>
            </div>
        </div>

        <div class="tp-card mb-4">
            <h2 style="color: var(--cedar-gold); margin-bottom: 20px;">Report a Security Issue</h2>
            <p>If you discover a security vulnerability or have concerns about your account:</p>
            <ul>
                <li>Email us directly at: <strong>cedarpay.notifications@gmail.com</strong></li>
                <li>Call our security hotline: <strong>+961 78 805 447</strong> (24/7)</li>
                <li>Use the in-app support chat</li>
            </ul>
        </div>

        <div class="home-footer">
            <div class="home-footer-links">
                <a asp-controller="Home" asp-action="Index" class="home-footer-link">Home</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Features" class="home-footer-link">Features</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="AboutUs" class="home-footer-link">About</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="SecurityPolicy" class="home-footer-link">Security</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="ContactUs" class="home-footer-link">Contact</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Privacy" class="home-footer-link">Privacy</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Terms" class="home-footer-link">Terms</a>
            </div>
            <p class="home-footer-copyright">© @DateTime.Now.Year CedarPay — Licensed by Banque du Liban</p>
        </div>
    </div>

</body>
</html>