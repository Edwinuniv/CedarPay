@{
    ViewData["Title"] = "Contact Us - CedarPay";
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact Us - CedarPay</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/transferpay.css" asp-append-version="true" />

    <script>
        (function() {
            if (localStorage.getItem('darkMode') === '1') {
                document.documentElement.classList.add('dark-mode');
                if (document.body) document.body.classList.add('dark-mode');
            }
        })();
    </script>
</head>
<body class="home-page">

    <nav class="public-nav">
        <div class="sidebar-brand" style="padding:0;margin:0">
            <div class="brand-icon">
                <img src="/images/cedarpay-logo.png" alt="CedarPay" style="width:28px;height:28px;object-fit:contain" />
            </div>
            <span class="brand-name">
                Cedar<span class="brand-accent">Pay</span>
            </span>
        </div>
        <div class="public-nav-links">
            <a asp-controller="Home" asp-action="Index" class="btn-login">Home</a>
            <a asp-controller="Home" asp-action="Features" class="btn-login">Features</a>
            <a asp-controller="Home" asp-action="AboutUs" class="btn-login">About</a>
            <a asp-controller="Home" asp-action="SecurityPolicy" class="btn-login">Security</a>
            <a asp-controller="Home" asp-action="ContactUs" class="btn-login">Contact</a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn-login">Login</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-register">Register</a>
        </div>
    </nav>

    <div class="home-container">
        @if (!string.IsNullOrEmpty(returnUrl) && returnUrl.Contains("/Settings"))
        {
            <div class="mb-3">
                <a href="@returnUrl" class="btn-tp-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Settings
                </a>
            </div>
        }

        <div class="home-hero">
            <div class="home-hero-icon">📞</div>
            <h1 class="home-title">Contact <span class="home-title-accent">Us</span></h1>
            <p class="home-subtitle">We're here to help! Reach out anytime.</p>
        </div>

        @if (TempData["ContactSuccess"] != null)
        {
            <div class="alert alert-success" style="background: rgba(0, 184, 148, 0.1); color: #00b894; border: 1px solid #00b894; border-radius: 12px; padding: 15px; margin-bottom: 20px;">
                <i class="bi bi-check-circle-fill"></i> @TempData["ContactSuccess"]
            </div>
        }

        @if (TempData["ContactError"] != null)
        {
            <div class="alert alert-danger" style="background: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid #dc3545; border-radius: 12px; padding: 15px; margin-bottom: 20px;">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ContactError"]
            </div>
        }

        <div class="row g-4">
            <div class="col-md-6">
                <div class="tp-card">
                    <h2 style="color: var(--cedar-gold); margin-bottom: 25px; text-align: center;">Get in Touch</h2>

                    <div style="margin-bottom: 30px; padding: 20px; background: var(--bg-2); border-radius: 12px;">
                        <div style="display: flex; align-items: center; margin-bottom: 20px;">
                            <div style="width: 50px; height: 50px; background: rgba(0, 184, 148, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                                <i class="bi bi-envelope-fill" style="font-size: 24px; color: #00b894;"></i>
                            </div>
                            <div>
                                <h4 style="margin-bottom: 5px;">Email Us</h4>
                                <a href="mailto:cedarpay.notifications@gmail.com" style="color: #00b894; text-decoration: none; font-size: 16px;">
                                    cedarpay.notifications@gmail.com
                                </a>
                            </div>
                        </div>

                        <div style="display: flex; align-items: center;">
                            <div style="width: 50px; height: 50px; background: rgba(0, 184, 148, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                                <i class="bi bi-telephone-fill" style="font-size: 24px; color: #00b894;"></i>
                            </div>
                            <div>
                                <h4 style="margin-bottom: 5px;">Call Us</h4>
                                <a href="tel:+96178805447" style="color: #00b894; text-decoration: none; font-size: 16px;">
                                    +961 78 805 447
                                </a>
                                <p style="font-size: 12px; color: var(--text-3); margin-top: 5px;">Available Mon-Fri, 9AM - 6PM</p>
                            </div>
                        </div>
                    </div>

                    <div style="padding: 20px; background: var(--bg-2); border-radius: 12px;">
                        <h4 style="margin-bottom: 15px;">Business Hours</h4>
                        <div style="display: flex; justify-content: space-between; padding: 8px 0;">
                            <span>Monday - Friday:</span>
                            <span>9:00 AM - 6:00 PM</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 8px 0;">
                            <span>Saturday:</span>
                            <span>10:00 AM - 2:00 PM</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 8px 0;">
                            <span>Sunday:</span>
                            <span>Closed</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="tp-card">
                    <h2 style="color: var(--cedar-gold); margin-bottom: 25px; text-align: center;">Send us a Message</h2>

                    <form asp-action="SubmitContact" asp-controller="Home" method="post">
                        <div class="mb-3">
                            <label class="form-label">Full Name *</label>
                            <input type="text" name="fullName" class="form-control" required style="background: var(--bg-2); border: 1px solid var(--border); color: var(--text-1);">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email Address *</label>
                            <input type="email" name="email" class="form-control" required style="background: var(--bg-2); border: 1px solid var(--border); color: var(--text-1);">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Phone Number (Optional)</label>
                            <input type="tel" name="phone" class="form-control" style="background: var(--bg-2); border: 1px solid var(--border); color: var(--text-1);">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Subject *</label>
                            <select name="subject" class="form-control" required style="background: var(--bg-2); border: 1px solid var(--border); color: var(--text-1);">
                                <option value="">Select a subject</option>
                                <option value="General Inquiry">General Inquiry</option>
                                <option value="Technical Support">Technical Support</option>
                                <option value="Account Issue">Account Issue</option>
                                <option value="Transaction Problem">Transaction Problem</option>
                                <option value="KYC Verification">KYC Verification</option>
                                <option value="Complaint">Complaint</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Message *</label>
                            <textarea name="message" class="form-control" rows="5" required style="background: var(--bg-2); border: 1px solid var(--border); color: var(--text-1);"></textarea>
                        </div>
                        <button type="submit" class="btn-tp-primary w-100" style="padding: 12px;">
                            <i class="bi bi-send-fill"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="tp-card mt-4 text-center">
            <h3 style="color: var(--cedar-gold); margin-bottom: 15px;">Emergency Support</h3>
            <p style="margin-bottom: 10px;">For urgent issues related to lost accounts or security concerns:</p>
            <h4><i class="bi bi-telephone-fill"></i> +961 78 805 447</h4>
            <p style="font-size: 12px; color: var(--text-3); margin-top: 10px;">Available 24/7 for security emergencies</p>
        </div>

        <div class="home-footer mt-4">
            <div class="home-footer-links">
                <a asp-controller="Home" asp-action="Index" class="home-footer-link">Home</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Features" class="home-footer-link">Features</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="AboutUs" class="home-footer-link">About</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="SecurityPolicy" class="home-footer-link">Security</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="ContactUs" class="home-footer-link">Contact</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Privacy" class="home-footer-link">Privacy</a>
                <span class="home-footer-separator">•</span>
                <a asp-controller="Home" asp-action="Terms" class="home-footer-link">Terms</a>
            </div>
            <p class="home-footer-copyright">© @DateTime.Now.Year CedarPay — Licensed by Banque du Liban</p>
        </div>
    </div>

</body>
</html>