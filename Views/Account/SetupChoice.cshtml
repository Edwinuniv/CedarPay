@{
    ViewData["Title"] = "Welcome to CedarPay";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div style="min-height:calc(100vh - 140px);
            display:flex;align-items:center;
            justify-content:center;padding:40px 20px">
    <div style="width:100%;max-width:500px;
                text-align:center">

        <!-- Cedar tree welcome -->
        <div style="margin-bottom:32px">
            <svg viewBox="0 0 80 80"
                 width="80" height="80"
                 style="margin:0 auto 16px;display:block">
                <circle cx="40" cy="40" r="40"
                        fill="#e8faf5" />
                <rect x="36" y="52" width="8" height="16"
                      fill="#2d5a27" opacity=".8" />
                <polygon points="10,58 40,22 70,58"
                         fill="#2d5a27" opacity=".7" />
                <polygon points="16,48 40,16 64,48"
                         fill="#2d5a27" opacity=".85" />
                <polygon points="22,38 40,10 58,38"
                         fill="#2d5a27" />
            </svg>
            <h1 style="font-size:26px;font-weight:800;
                       color:var(--text-1);
                       letter-spacing:-0.5px;margin:0">
                Welcome to Cedar<span style="color:var(--teal)">Pay</span>!
            </h1>
            <p style="font-size:14px;color:var(--text-3);
                      margin-top:8px">
                Your account has been created.
                Would you like to complete your profile now?
            </p>
        </div>

        <div style="display:flex;flex-direction:column;
                    gap:14px">
            <!-- Setup now -->
            <a asp-controller="Account"
               asp-action="Profile"
               asp-route-edit="true"
               class="btn-tp-primary"
               style="justify-content:center;
                      padding:16px;font-size:15px;
                      border-radius:var(--r-lg)">
                <i class="bi bi-person-fill"></i>
                Complete Profile Now
            </a>

            <!-- Setup later -->
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn-tp-secondary"
               style="justify-content:center;
                      padding:16px;font-size:15px;
                      border-radius:var(--r-lg);
                      color:var(--text-2)">
                <i class="bi bi-skip-end"></i>
                Skip for Now
            </a>
        </div>

        <p style="font-size:12px;color:var(--text-3);
                  margin-top:20px">
            You can complete your profile anytime
            from the Profile page.
            A complete profile is required to
            create wallets and send money.
        </p>
    </div>
</div>