@{
    ViewData["Title"] = "Complete Your Setup";
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewBag.PageClass = "page-dashboard";
}

<div class="setup-container">
    <div class="setup-card">

        <div class="setup-logo">
            <svg viewBox="0 0 80 80" width="80" height="80" class="setup-svg">
                <circle cx="40" cy="40" r="40" fill="#e8faf5" />
                <rect x="36" y="52" width="8" height="16" fill="#2d5a27" opacity=".8" />
                <polygon points="10,58 40,22 70,58" fill="#2d5a27" opacity=".7" />
                <polygon points="16,48 40,16 64,48" fill="#2d5a27" opacity=".85" />
                <polygon points="22,38 40,10 58,38" fill="#2d5a27" />
            </svg>
            <h1 class="setup-title">
                Welcome to Cedar<span>Pay</span>!
            </h1>
            <p class="setup-subtitle">
                Let's get your account ready. Would you like to complete your profile now?
            </p>
        </div>

        <div class="setup-buttons">
            <a asp-controller="Account"
               asp-action="Profile"
               asp-route-edit="true"
               class="btn-tp-primary setup-btn-primary">
                <i class="bi bi-person-fill"></i>
                Complete Profile Now
            </a>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn-tp-secondary setup-btn-secondary">
                <i class="bi bi-skip-end"></i>
                Set Up Later
            </a>
        </div>

        <div class="setup-footer">
            <p>
                ⚡ A complete profile is required to create wallets and send money.<br />
                You can complete your profile anytime from the Profile page.
            </p>
        </div>
    </div>
</div>