@model MoneyTransfer.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    ViewBag.PageClass = "page-profile";
    bool isEditMode = ViewBag.EditMode == true;
    string agentStatus = ViewBag.AgentApplicationStatus as string ?? "";
    bool isAgentUser = ViewBag.IsAgent == true;
    bool isAdminUser = ViewBag.IsAdmin == true;
}

<div class="row justify-content-center">
    <div class="col-md-9">

        <div class="page-header">
            <div>
                <h2>My Profile</h2>
                <p>@(isEditMode ? "Edit your information below" : "Your account information")</p>
            </div>
            @if (!isEditMode)
            {
                <a asp-action="Profile" asp-route-edit="true" class="btn-tp-primary">
                    <i class="bi bi-pencil"></i> Edit Profile
                </a>
            }
        </div>

        @if (!isEditMode)
        {
            <div class="profile-info-alert">
                <i class="bi bi-lock-fill"></i>
                Click <strong>Edit Profile</strong> to make changes to your information.
            </div>
        }

        <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RemoveProfilePicture" id="removePicFlag" value="false" />
            <input type="hidden" name="croppedProfilePicture" id="croppedPicData" />

            @if (isEditMode)
            {
                <div asp-validation-summary="All" class="alert-tp error"
                     style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>
            }

            <div class="tp-card mb-3">
                <div class="profile-avatar-wrapper">
                    <div class="profile-avatar-container">
                        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                        {
                            <img id="avatarImg" src="@Model.ProfilePictureUrl" class="profile-avatar-img" />
                            <div id="avatarInitials" class="profile-avatar-initials profile-avatar-hidden">
                                @(Model.FirstName?.Length > 0 ? Model.FirstName.Substring(0, 1).ToUpper() : "?")
                            </div>
                        }
                        else
                        {
                            <div id="avatarInitials" class="profile-avatar-initials">
                                @(Model.FirstName?.Length > 0 ? Model.FirstName.Substring(0, 1).ToUpper() : "?")
                            </div>
                            <img id="avatarImg" class="profile-avatar-img profile-avatar-hidden" />
                        }
                    </div>

                    <div class="profile-info-details">
                        <div class="profile-info-name">
                            @Model.FirstName @Model.LastName
                        </div>
                        <div class="profile-info-hint">
                            JPG, PNG or GIF · Max 2MB
                        </div>

                        @if (isEditMode)
                        {
                            <div class="profile-actions">
                                <label class="btn-edit-photo">
                                    <i class="bi bi-pencil-fill"></i> Edit Photo
                                    <input type="file" id="profilePicInput" name="profilePicture"
                                           accept="image/*" style="display:none"
                                           onchange="openCropper(this)" />
                                </label>

                                <label class="btn-change-photo" onclick="document.getElementById('profilePicInput').click()">
                                    <i class="bi bi-camera-fill"></i> Change
                                </label>

                                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                                {
                                    <button type="button" onclick="removePicture()" class="btn-delete-photo">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="tp-card mb-3">
                <div class="section-header">
                    <i class="bi bi-person-badge"></i>
                    Account Type
                </div>

                @if (ViewBag.WalletApproved == true)
                {
                    <div class="account-type-locked">
                        <span class="account-type-icon">@(Model.AccountType == "Corporate" ? "🏢" : "👤")</span>
                        <div>
                            <div class="account-type-title">@(Model.AccountType ?? "Individual")</div>
                            <div class="account-type-note">Locked — cannot be changed</div>
                        </div>
                    </div>
                    <input type="hidden" name="AccountType" value="@Model.AccountType" />
                }
                else if (isEditMode)
                {
                    <div class="account-type-selector">
                        <label class="account-type-option">
                            <input type="radio" name="AccountType" value="Individual" style="display:none" class="acct-type-radio" />
                            <div class="account-type-card" data-val="Individual">
                                <div class="account-type-emoji">👤</div>
                                <div class="account-type-name">Individual</div>
                                <div class="account-type-desc">Personal account</div>
                            </div>
                        </label>
                        <label class="account-type-option">
                            <input type="radio" name="AccountType" value="Corporate" style="display:none" class="acct-type-radio" />
                            <div class="account-type-card" data-val="Corporate">
                                <div class="account-type-emoji">🏢</div>
                                <div class="account-type-name">Corporate</div>
                                <div class="account-type-desc">Business account</div>
                            </div>
                        </label>
                    </div>
                }
                else
                {
                    <div class="account-type-locked">
                        <span class="account-type-icon">@(Model.AccountType == "Corporate" ? "🏢" : "👤")</span>
                        <div>
                            <div class="account-type-title">@(Model.AccountType ?? "Individual")</div>
                            <div class="account-type-note">@(Model.AccountType == "Corporate" ? "Business account" : "Personal account")</div>
                        </div>
                    </div>
                }
            </div>

            <div id="corporateFields" style="display:@(Model.AccountType == "Corporate" ? "block" : "none")">
                <div class="tp-card mb-3">
                    <div class="section-header">
                        <i class="bi bi-building"></i>
                        Corporate Information
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Company Name</label>
                                @if (isEditMode)
                                {
                                    <input name="CompanyName" class="form-control" value="@Model.CompanyName" placeholder="Official company name" />
                                }
                                else
                                {
                                    <div class="form-control form-control-readonly">@(Model.CompanyName ?? "—")</div>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Business Registration No.</label>
                                @if (isEditMode)
                                {
                                    <input name="BusinessRegNumber" class="form-control" value="@Model.BusinessRegNumber" placeholder="e.g. LB-2024-XXXXX" />
                                }
                                else
                                {
                                    <div class="form-control form-control-readonly">@(Model.BusinessRegNumber ?? "—")</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tp-card mb-3">
                <div class="section-header">
                    <i class="bi bi-person-fill"></i>
                    Personal Information
                    @if (isEditMode)
                    {
                        <span class="section-header-required">* Required</span>
                    }
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">First Name @if (isEditMode) {
                            <span class="text-danger">*</span>
                                                        }
</label>
                            @if (isEditMode)
                            {
                                <input asp-for="FirstName" class="form-control" placeholder="First name" />
                                <span asp-validation-for="FirstName" class="text-danger" style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.FirstName ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Father's Name</label>
                            @if (isEditMode)
                            {
                                <input asp-for="FatherName" class="form-control" placeholder="Father's name" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.FatherName ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Last Name @if (isEditMode) {
                            <span class="text-danger">*</span>
                                                        }
</label>
                            @if (isEditMode)
                            {
                                <input asp-for="LastName" class="form-control" placeholder="Last name" />
                                <span asp-validation-for="LastName" class="text-danger" style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.LastName ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Mother's Name</label>
                            @if (isEditMode)
                            {
                                <input asp-for="MotherName" class="form-control" placeholder="Mother's full name" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.MotherName ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Date of Birth @if (isEditMode) {
                            <span class="text-danger">*</span>
                                                        }
</label>
                            @if (isEditMode)
                            {
                                <input asp-for="DateOfBirth" class="form-control" type="date" max="@DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DateOfBirth" class="text-danger" style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.DateOfBirth.Year > 1 ? Model.DateOfBirth.ToString("MMM dd, yyyy") : "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Place of Birth</label>
                            @if (isEditMode)
                            {
                                <input asp-for="PlaceOfBirth" class="form-control" placeholder="City of birth" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.PlaceOfBirth ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Gender @if (isEditMode) {
                            <span class="text-danger">*</span>
                                                        }
</label>
                            @if (isEditMode)
                            {
                                <select asp-for="Gender" class="form-select"><option value="">— Select —</option><option value="Male">Male</option><option value="Female">Female</option></select>
                                <span asp-validation-for="Gender" class="text-danger" style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.Gender ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Marital Status</label>
                            @if (isEditMode)
                            {
                                <select asp-for="MaritalStatus" class="form-select"><option value="">— Select —</option><option value="Single">Single</option><option value="Married">Married</option><option value="Divorced">Divorced</option><option value="Widowed">Widowed</option></select>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.MaritalStatus ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Nationality @if (isEditMode) {
                            <span class="text-danger">*</span>
                                                        }
</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Nationality" class="form-control" placeholder="e.g. Lebanese" />
                                <span asp-validation-for="Nationality" class="text-danger" style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.Nationality ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Other Nationality</label>
                            @if (isEditMode)
                            {
                                <input asp-for="OtherNationality" class="form-control" placeholder="If applicable" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.OtherNationality ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Phone Number @if (isEditMode) {
                            <span class="text-danger">*</span>
                                                        }
</label>
                            @if (isEditMode)
                            {
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+961 XX XXX XXX" />
                                <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.PhoneNumber ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Email @if (isEditMode) {
                            <span class="text-danger">*</span>
                                                        }
</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" />
                                <span asp-validation-for="Email" class="text-danger" style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.Email ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Username</label>
                            @if (isEditMode)
                            {
                                <div class="username-input-wrapper">
                                    <span class="username-prefix">@@</span>
                                    <input name="UserUsername" value="@Model.UserUsername" class="username-input" placeholder="yourname" />
                                </div>
                                <small class="text-muted">Letters, numbers, and underscores only</small>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@@@(Model.UserUsername ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Bio</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Description" class="form-control" placeholder="Short bio (optional)" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.Description ?? "—")</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="tp-card mb-3">
                <div class="section-header">
                    <i class="bi bi-journal-bookmark"></i>
                    Civil Registry
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Record Number</label>
                            @if (isEditMode)
                            {
                                <input asp-for="RecordNumber" class="form-control" placeholder="Registry number" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.RecordNumber ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Governate</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Governate" class="form-control" placeholder="e.g. Beirut" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.Governate ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">District</label>
                            @if (isEditMode)
                            {
                                <input asp-for="District" class="form-control" placeholder="e.g. Metn" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.District ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Village</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Village" class="form-control" placeholder="Village of origin" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.Village ?? "—")</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="tp-card mb-3">
                <div class="section-header">
                    <i class="bi bi-geo-alt-fill"></i>
                    Address
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Country @if (isEditMode) {
                            <span class="text-danger">*</span>
                                                        }
</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Country" class="form-control" placeholder="Lebanon" />
                                <span asp-validation-for="Country" class="text-danger" style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.Country ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">City @if (isEditMode) {
                            <span class="text-danger">*</span>
                                                        }
</label>
                            @if (isEditMode)
                            {
                                <input asp-for="City" class="form-control" placeholder="Beirut" />
                                <span asp-validation-for="City" class="text-danger" style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.City ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Region</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Region" class="form-control" placeholder="e.g. Hamra" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.Region ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">State</label>
                            @if (isEditMode)
                            {
                                <input asp-for="State" class="form-control" placeholder="State / Province" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.State ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="form-group">
                            <label class="form-label">Street</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Street" class="form-control" placeholder="Street name" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.Street ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="form-label">Building</label>
                            @if (isEditMode)
                            {
                                <input asp-for="BuildingName" class="form-control" placeholder="Name" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.BuildingName ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="form-label">No.</label>
                            @if (isEditMode)
                            {
                                <input asp-for="BuildingNumber" class="form-control" placeholder="#" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.BuildingNumber ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Postal Code</label>
                            @if (isEditMode)
                            {
                                <input asp-for="PostalCode" class="form-control" placeholder="Postal code" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.PostalCode ?? "—")</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="tp-card mb-3">
                <div class="section-header">
                    <i class="bi bi-briefcase-fill"></i>
                    Professional Information
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Occupation</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Occupation" class="form-control" placeholder="e.g. Engineer" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.Occupation ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Employer Name</label>
                            @if (isEditMode)
                            {
                                <input asp-for="EmployerName" class="form-control" placeholder="Company name" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.EmployerName ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Annual Income (USD)</label>
                            @if (isEditMode)
                            {
                                <select asp-for="AnnualIncomeUSD" class="form-select">
                                    <option value="">— Select range —</option>
                                    <option value="$100 - $999">$100 – $999</option>
                                    <option value="$1,000 - $2,999">$1,000 – $2,999</option>
                                    <option value="$3,000 - $4,999">$3,000 – $4,999</option>
                                    <option value="$5,000 - $6,999">$5,000 – $6,999</option>
                                    <option value="$7,000 - $9,999">$7,000 – $9,999</option>
                                    <option value="$10,000 - $25,000">$10,000 – $25,000</option>
                                    <option value="$25,000 - $50,000">$25,000 – $50,000</option>
                                    <option value="$50,000 - $100,000">$50,000 – $100,000</option>
                                    <option value="Over $100,000">Over $100,000</option>
                                </select>
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.AnnualIncomeUSD ?? "—")</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Other Source of Income</label>
                            @if (isEditMode)
                            {
                                <input asp-for="OtherIncomeSource" class="form-control" placeholder="e.g. Freelancing, Rental" />
                            }
                            else
                            {
                                <div class="form-control form-control-readonly">@(Model.OtherIncomeSource ?? "—")</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="tp-card mb-3">
                <div class="kyc-status-card">
                    <div class="kyc-status-content">
                        @if (Model.KYCStatus == "Approved")
                        {
                            <i class="bi bi-patch-check-fill kyc-status-icon approved"></i>
                            <div>
                                <div class="kyc-status-title">Identity Verified</div>
                                <div class="kyc-status-text">Your KYC has been approved by our team.</div>
                            </div>
                        }
                        else if (Model.KYCStatus == "Pending")
                        {
                            <i class="bi bi-clock-fill kyc-status-icon pending"></i>
                            <div>
                                <div class="kyc-status-title">KYC Under Review</div>
                                <div class="kyc-status-text">Your documents have been submitted and are being reviewed.</div>
                            </div>
                        }
                        else if (Model.KYCStatus == "Rejected")
                        {
                            <i class="bi bi-x-circle-fill kyc-status-icon rejected"></i>
                            <div>
                                <div class="kyc-status-title rejected">KYC Rejected</div>
                                <div class="kyc-status-text">Your documents were rejected. Please resubmit.</div>
                            </div>
                        }
                        else
                        {
                            <i class="bi bi-shield-exclamation kyc-status-icon none"></i>
                            <div>
                                <div class="kyc-status-title">Identity Not Verified</div>
                                <div class="kyc-status-text">Submit your KYC documents to verify your identity. (Optional — not required for wallet creation)</div>
                            </div>
                        }
                    </div>
                    <a asp-controller="KYC" asp-action="Index" class="kyc-manage-btn">
                        <i class="bi bi-shield-check"></i>
                        @(Model.KYCStatus == "Approved" ? "View KYC" : "Manage KYC")
                    </a>
                </div>
            </div>

            @if (isEditMode)
            {
                <div class="tp-card mb-3">
                    <div class="terms-checkbox-wrapper">
                        <input type="checkbox" id="termsCheck" @(Model.ProfileCompleted ? "checked" : "") required class="terms-checkbox" />
                        <label for="termsCheck" class="terms-label">
                            I confirm that all information provided is accurate and I agree to the
                            <a href="#" class="terms-link">Terms of Service</a> and
                            <a href="#" class="terms-link">Privacy Policy</a> of CedarPay.
                        </label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-tp-primary">
                            <i class="bi bi-check-lg"></i> Save Profile
                        </button>
                        <a asp-action="Profile" class="btn-tp-secondary">Cancel</a>
                    </div>
                </div>
            }
        </form>

        @if (isAgentUser)
        {
            <div class="tp-card mb-3 agent-card">
                <div class="agent-card-content">
                    <i class="bi bi-check-circle-fill agent-card-icon"></i>
                    <div class="agent-card-text">
                        <div class="agent-card-title">You are a CedarPay Agent ✓</div>
                        <div class="agent-card-subtitle">Your application was approved. Access your agent tools below.</div>
                    </div>
                    <a asp-controller="Agent" asp-action="Dashboard" class="btn-tp-primary" style="white-space:nowrap;flex-shrink:0">
                        <i class="bi bi-speedometer2"></i> Agent Dashboard
                    </a>
                </div>
            </div>
        }
        else
        {
            @if (agentStatus == "Pending")
            {
                <div class="tp-card mb-3 agent-pending-card">
                    <div class="agent-card-content">
                        <i class="bi bi-clock-fill agent-pending-icon"></i>
                        <div class="agent-card-text">
                            <div class="agent-card-title">Application Under Review</div>
                            <div class="agent-card-subtitle">Your agent application is pending. You'll be notified once reviewed.</div>
                        </div>
                        <a asp-controller="AgentApplication" asp-action="MyApplication" class="btn-tp-secondary">View Application</a>
                    </div>
                </div>
            }
            else if (agentStatus == "Rejected")
            {
                <div class="tp-card mb-3 agent-rejected-card">
                    <div class="kyc-status-card">
                        <div>
                            <div class="agent-rejected-title">Application Rejected</div>
                            <div class="agent-card-subtitle">Your application was rejected. You can reapply below.</div>
                        </div>
                        <div style="display:flex;gap:8px">
                            <a asp-controller="AgentApplication" asp-action="MyApplication" class="btn-tp-secondary" style="padding:8px 14px;font-size:12px">View History</a>
                            <a asp-controller="AgentApplication" asp-action="Apply" class="btn-tp-primary" style="padding:8px 14px;font-size:12px">Reapply</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="tp-card mb-3 agent-card">
                    <div class="kyc-status-card">
                        <div>
                            <div class="agent-card-title">
                                <i class="bi bi-shop" style="color:var(--teal);margin-right:6px"></i>Become a CedarPay Agent
                            </div>
                            <div class="agent-card-subtitle">Register your store and earn commissions. Admin review required.</div>
                        </div>
                        <a asp-controller="AgentApplication" asp-action="Apply" class="btn-tp-primary" style="white-space:nowrap;flex-shrink:0">
                            <i class="bi bi-arrow-right"></i> Apply Now
                        </a>
                    </div>
                </div>
            }
        }

        <div class="tp-card delete-account-card">
            <div class="delete-account-content">
                <div>
                    <div class="delete-account-title">
                        <i class="bi bi-exclamation-triangle-fill" style="margin-right:6px"></i>Delete Account
                    </div>
                    <div class="delete-account-text">Permanently delete your account and all data. This cannot be undone.</div>
                </div>
                <a asp-action="DeleteAccount" class="btn-tp-danger" style="white-space:nowrap;flex-shrink:0;padding:9px 18px">
                    <i class="bi bi-trash"></i> Delete Account
                </a>
            </div>
        </div>

    </div>
</div>

<div id="cropperModal" class="cropper-modal">
    <div class="cropper-modal-content">
        <div class="cropper-modal-header">
            Crop Profile Picture
            <button onclick="closeCropper()" class="cropper-modal-close">×</button>
        </div>
        <div class="cropper-image-container">
            <img id="cropperImg" class="cropper-image" />
        </div>
        <div class="cropper-actions">
            <button type="button" onclick="cropImage()" class="btn-tp-primary">
                <i class="bi bi-check-lg"></i> Use This Photo
            </button>
            <button type="button" onclick="closeCropper()" class="btn-tp-secondary">Cancel</button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.1/dist/cropper.min.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.1/dist/cropper.min.js"></script>
    <script>
        var currentType = '@Model.AccountType';
        document.querySelectorAll('.account-type-card').forEach(function(card) {
            if (card.dataset.val === currentType) {
                card.classList.add('active');
                var radio = card.closest('label').querySelector('input[type="radio"]');
                if (radio) radio.checked = true;
            }
        });

        document.querySelectorAll('.acct-type-radio').forEach(function(radio) {
            radio.addEventListener('change', function () {
                document.querySelectorAll('.account-type-card').forEach(function(c) { c.classList.remove('active'); });
                var card = this.closest('label').querySelector('.account-type-card');
                if (card) card.classList.add('active');
                var corp = document.getElementById('corporateFields');
                if (corp) corp.style.display = this.value === 'Corporate' ? 'block' : 'none';
            });
        });

        var cropperInstance = null;

        function openCropper(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function(e) {
                var img = document.getElementById('cropperImg');
                var modal = document.getElementById('cropperModal');
                img.src = e.target.result;
                modal.style.display = 'flex';
                if (cropperInstance) cropperInstance.destroy();
                cropperInstance = new Cropper(img, { aspectRatio: 1, viewMode: 1, dragMode: 'move', autoCropArea: 1, restore: false, guides: true, center: true, highlight: false });
            };
            reader.readAsDataURL(input.files[0]);
        }

        function cropImage() {
            if (!cropperInstance) return;
            var canvas = cropperInstance.getCroppedCanvas({ width: 300, height: 300, fillColor: '#fff', imageSmoothingEnabled: true, imageSmoothingQuality: 'high' });
            var dataUrl = canvas.toDataURL('image/jpeg', 0.8);
            var preview = document.getElementById('avatarImg');
            var initials = document.getElementById('avatarInitials');
            if (preview) { preview.src = dataUrl; preview.classList.remove('profile-avatar-hidden'); }
            if (initials) initials.classList.add('profile-avatar-hidden');
            document.getElementById('croppedPicData').value = dataUrl;
            document.getElementById('removePicFlag').value = 'false';
            closeCropper();
        }

        function closeCropper() {
            var modal = document.getElementById('cropperModal');
            modal.style.display = 'none';
            if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
            var input = document.getElementById('profilePicInput');
            if (input) input.value = '';
        }

        function removePicture() {
            if (!confirm('Remove your profile picture?')) return;
            var img = document.getElementById('avatarImg');
            var init = document.getElementById('avatarInitials');
            if (img) img.classList.add('profile-avatar-hidden');
            if (init) init.classList.remove('profile-avatar-hidden');
            document.getElementById('removePicFlag').value = 'true';
            document.getElementById('croppedPicData').value = '';
        }
    </script>
}