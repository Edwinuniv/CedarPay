                                    <option value="$5,000 - $6,999">$5,000 – $6,999</option>
                                    <option value="$7,000 - $9,999">$7,000 – $9,999</option>
                                    <option value="$10,000 - $25,000">$10,000 – $25,000</option>
                                    <option value="$25,000 - $50,000">$25,000 – $50,000</option>
                                    <option value="$50,000 - $100,000">$50,000 – $100,000</option>
                                    <option value="Over $100,000">Over $100,000</option>
                                </select>
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                color:var(--text-1)">
                                    @(Model.AnnualIncomeUSD ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                Other Source of Income
                            </label>
                            @if (isEditMode)
                            {
                                <input asp-for="OtherIncomeSource"
                                       class="form-control"
                                       placeholder="e.g. Freelancing, Rental" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                                    color:var(--text-1)">
                                    @(Model.OtherIncomeSource ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- KYC Section -->
            @if (Model.KYCStatus == "Approved" || ViewBag.WalletApproved == true)
            {
                <div class="tp-card mb-3">
                    <div style="display:flex;align-items:center;gap:12px">
                        <i class="bi bi-check-circle-fill"
                           style="color:var(--teal);font-size:22px"></i>
                        <div>
                            <div style="font-weight:700;font-size:14px">
                                Identity Verified
                            </div>
                            <div style="font-size:12px;color:var(--text-3)">
                                @Model.DocumentType · @Model.DocumentNumber
                                — Cannot be changed
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="DocumentType" value="@Model.DocumentType" />
                <input type="hidden" name="DocumentNumber" value="@Model.DocumentNumber" />
            }
            else
            {
                <div class="tp-card mb-3">
                    <div style="font-size:13px;font-weight:700;
                                            color:var(--text-1);margin-bottom:14px">
