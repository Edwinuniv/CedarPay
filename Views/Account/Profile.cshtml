                        <i class="bi bi-clock-fill"
                           style="color:var(--yellow);
                                          font-size:20px"></i>
                        <div style="flex:1">
                            <div style="font-size:14px;
                                                font-weight:700;
                                                color:var(--text-1)">
                                Application Under Review
                            </div>
                            <div style="font-size:13px;
                                                color:var(--text-2)">
                                Your application is pending.
                                You'll be notified once reviewed.
                            </div>
                        </div>
                        <a asp-controller="AgentApplication"
                           asp-action="MyApplication"
                           class="btn-tp-secondary">
                            View
