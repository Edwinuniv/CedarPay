                                                              accent-color:var(--teal)" />
                        <label for="termsCheck"
                               style="font-size:13px;
                                                              color:var(--text-2);cursor:pointer">
                            I confirm that all information provided is accurate
                            and I agree to the
                            <a href="#" style="color:var(--teal)">
                                Terms of Service
                            </a>
                            and
                            <a href="#" style="color:var(--teal)">
                                Privacy Policy
                            </a>
                            of CedarPay.
                        </label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-tp-primary">
                            <i class="bi bi-check-lg"></i> Save Profile
                        </button>
                        <a asp-action="Profile" class="btn-tp-secondary">
                            Cancel
                        </a>
                    </div>
                </div>
            }
        </form>

        <!-- ROLE-SPECIFIC SECTIONS - REPLACED WITH NEW VERSION -->
