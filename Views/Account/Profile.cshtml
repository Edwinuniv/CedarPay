                                                color:var(--text-1);
                                                margin-bottom:4px">
                                <i class="bi bi-shop"
                                   style="color:var(--teal);
                                                  margin-right:6px"></i>
                                Become a CedarPay Agent
                            </div>
                            <div style="font-size:13px;
                                                color:var(--text-2)">
                                Register your store and earn
                                commissions. Admin review required.
                            </div>
                        </div>
                        <a asp-controller="AgentApplication"
                           asp-action="Apply"
                           class="btn-tp-primary"
                           style="white-space:nowrap;flex-shrink:0">
                            Apply Now
                        </a>
                    </div>
                </div>
            }
        }

        <div class="tp-card"
             style="border:1px solid rgba(255,107,107,.25)">
            <div style="display:flex;align-items:center;
                        justify-content:space-between;gap:16px">
                <div>
                    <div style="font-size:14px;font-weight:700;
                                color:var(--red);margin-bottom:4px">
                        <i class="bi bi-exclamation-triangle-fill"
                           style="margin-right:6px"></i>
                        Delete Account
                    </div>
                    <div style="font-size:13px;color:var(--text-2)">
                        Permanently delete your account and all data.
                        This cannot be undone.
                    </div>
                </div>
                <a asp-action="DeleteAccount"
                   class="btn-tp-danger"
                   style="white-space:nowrap;flex-shrink:0;
                          padding:9px 18px">
                    <i class="bi bi-trash"></i> Delete Account
                </a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const currentType = '@Model.AccountType';
        document.querySelectorAll('.acct-type-card').forEach(card => {
            if (card.dataset.val === currentType) {
                card.style.borderColor = 'var(--teal)';
                card.style.background = 'var(--teal-light)';
                const radio = card.closest('label')
                    .querySelector('input[type="radio"]');
                if (radio) radio.checked = true;
            }
        });

        document.querySelectorAll('.acct-type-radio').forEach(radio => {
            radio.addEventListener('change', function() {
                document.querySelectorAll('.acct-type-card')
                    .forEach(c => {
                        c.style.borderColor = 'var(--border)';
                        c.style.background = 'var(--surface-2)';
                    });
                const card = this.closest('label')
                    .querySelector('.acct-type-card');
                if (card) {
                    card.style.borderColor = 'var(--teal)';
                    card.style.background = 'var(--teal-light)';
                }
            });
        });

        function updateCorporateFields() {
            const radios = document.querySelectorAll(
                'input[name="AccountType"]');
            radios.forEach(r => {
                r.addEventListener('change', () => {
                    const corp = document.getElementById(
                        'corporateFields');
                    if (corp) {
                        corp.style.display =
                            r.value === 'Corporate' &&
                            r.checked ? 'block' : 'none';
                    }
                });
            });
        }
        updateCorporateFields();

        function previewPicture(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    let img = document.getElementById('avatarImg');
                    const init = document.getElementById(
                        'avatarInitials');
                    if (!img) {
                        img = document.createElement('img');
                        img.id = 'avatarImg';
                        img.style.cssText =
                            'width:80px;height:80px;border-radius:50%;' +
                            'object-fit:cover;border:3px solid var(--teal)';
                        if (init) init.parentNode
                            .insertBefore(img, init.nextSibling);
                    }
                    img.src = e.target.result;
                    img.style.display = 'block';
                    if (init) init.style.display = 'none';
                    document.getElementById('removePicFlag')
                        .value = 'false';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function removePicture() {
            if (!confirm('Remove your profile picture?')) return;
            const img = document.getElementById('avatarImg');
            const init = document.getElementById('avatarInitials');
            if (img) img.style.display = 'none';
            if (init) init.style.display = 'flex';
            document.getElementById('removePicFlag').value = 'true';
        }
    </script>
}