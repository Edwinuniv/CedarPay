                    </div>
                </div>
            }
            else if (agentStatus == "Rejected")
            {
                <div class="tp-card mb-3"
                     style="border:1px solid rgba(255,107,107,.3);
                                    background:var(--red-light)">
                    <div style="display:flex;align-items:center;
