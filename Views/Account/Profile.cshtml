@model MoneyTransfer.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    bool isEditMode = ViewBag.EditMode == true;
    string agentStatus = ViewBag.AgentApplicationStatus as string ?? "";
    bool isAgentUser = ViewBag.IsAgent == true;
    bool isAdminUser = ViewBag.IsAdmin == true;
}

<div class="row justify-content-center">
    <div class="col-md-9">

        <div class="page-header">
            <div>
                <h2>My Profile</h2>
                <p>
                    @(isEditMode ? "Edit your information below" : "Your account information")
                </p>
            </div>
            @if (!isEditMode)
            {
                <a asp-action="Profile" asp-route-edit="true"
                   class="btn-tp-primary">
                    <i class="bi bi-pencil"></i> Edit Profile
                </a>
            }
        </div>

        @if (!isEditMode)
        {
            <div style="background:var(--surface-2);
                            border:1px solid var(--border);
                            border-radius:var(--r-md);
                            padding:12px 16px;
                            font-size:13px;color:var(--text-2);
                            margin-bottom:16px;
                            display:flex;align-items:center;gap:8px">
                <i class="bi bi-lock-fill"
                   style="color:var(--teal)"></i>
                Click <strong style="margin:0 4px">Edit Profile</strong>
                to make changes to your information.
            </div>
        }

        <form asp-action="UpdateProfile" method="post"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RemoveProfilePicture"
                   id="removePicFlag" value="false" />

            @if (isEditMode)
            {
                <div asp-validation-summary="All"
                     class="alert-tp error"
                     style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>
            }

            <div class="tp-card mb-3">
                <div style="display:flex;align-items:center;gap:20px">
                    <div>
                        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                        {
                            <img id="avatarImg"
                                 src="@Model.ProfilePictureUrl"
                                 style="width:80px;height:80px;
                                                        border-radius:50%;
                                                        object-fit:cover;
                                                        border:3px solid var(--teal)" />
                        }
                        else
                        {
                            <div id="avatarInitials"
                                 style="width:80px;height:80px;
                                                border-radius:50%;
                                                background:linear-gradient(135deg,
                                                    var(--teal),var(--teal-mid));
                                                display:flex;align-items:center;
                                                justify-content:center;
                                                font-size:28px;font-weight:800;
                                                color:#fff">
                                @(Model.FirstName?.Length > 0 ? Model.FirstName.Substring(0, 1).ToUpper() : "?")
                            </div>
                            <img id="avatarImg"
                                 style="display:none;width:80px;height:80px;
                                            border-radius:50%;object-fit:cover;
                                            border:3px solid var(--teal)" />
                        }
                    </div>
                    <div>
                        <div style="font-size:14px;font-weight:700;
                                    color:var(--text-1);margin-bottom:2px">
                            @Model.FirstName @Model.LastName
                        </div>
                        <div style="font-size:12px;color:var(--text-3);
                                    margin-bottom:10px">
                            JPG, PNG or GIF · Max 2MB
                        </div>
                        @if (isEditMode)
                        {
                            <div style="display:flex;gap:8px;flex-wrap:wrap">
                                <label class="btn-tp-secondary"
                                       style="padding:7px 14px;font-size:12px;
                                                    cursor:pointer;margin:0">
                                    <i class="bi bi-camera"></i> Change Photo
                                    <input type="file" name="profilePicture"
                                           accept="image/*" style="display:none"
                                           onchange="previewPicture(this)" />
                                </label>
                                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                                {
                                    <button type="button"
                                            class="btn-tp-danger"
                                            style="padding:7px 14px;font-size:12px"
                                            onclick="removePicture()">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="tp-card mb-3">
                <div style="font-size:13px;font-weight:700;
                            color:var(--text-1);margin-bottom:14px">
                    <i class="bi bi-person-badge"
                       style="color:var(--teal);margin-right:6px"></i>
                    Account Type
                </div>

                @if (ViewBag.WalletApproved == true && !isEditMode)
                {
                    <div style="display:flex;align-items:center;gap:8px;
                                            font-size:12px;color:var(--text-3);
                                            margin-bottom:10px">
                        <i class="bi bi-lock-fill"
                           style="color:var(--teal)"></i>
                        Account type is locked after wallet approval.
                    </div>
                }

                @if (ViewBag.WalletApproved == true)
                {
                    <div style="display:flex;align-items:center;gap:10px;
                                            padding:12px;background:var(--surface-2);
                                            border-radius:var(--r-sm)">
                        <span style="font-size:24px">
                            @(Model.AccountType == "Corporate" ? "🏢" : "👤")
                        </span>
                        <div>
                            <div style="font-size:14px;font-weight:700;
                                                    color:var(--text-1)">
                                @(Model.AccountType ?? "Individual")
                            </div>
                            <div style="font-size:11px;color:var(--text-3)">
                                Locked — cannot be changed
                            </div>
                        </div>
                    </div>
                    <input type="hidden" name="AccountType" value="@Model.AccountType" />
                }
                else
                {
                    @if (isEditMode)
                    {
                        <div style="display:flex;gap:12px">
                            <label style="flex:1;cursor:pointer">
                                <input type="radio" name="AccountType"
                                       value="Individual"
                                       style="display:none"
                                       class="acct-type-radio" />
                                <div class="acct-type-card"
                                     data-val="Individual"
                                     style="padding:14px;border-radius:var(--r-md);
                                                border:2px solid var(--border);
                                                background:var(--surface-2);
                                                text-align:center;
                                                transition:var(--transition);
                                                cursor:pointer">
                                    <div style="font-size:22px;margin-bottom:4px">
                                        👤
                                    </div>
                                    <div style="font-size:13px;font-weight:700;
                                                                                    color:var(--text-1)">
                                        Individual
                                    </div>
                                    <div style="font-size:11px;color:var(--text-3)">
                                        Personal account
                                    </div>
                                </div>
                            </label>
                            <label style="flex:1;cursor:pointer">
                                <input type="radio" name="AccountType"
                                       value="Corporate"
                                       style="display:none"
                                       class="acct-type-radio" />
                                <div class="acct-type-card"
                                     data-val="Corporate"
                                     style="padding:14px;border-radius:var(--r-md);
                                                border:2px solid var(--border);
                                                background:var(--surface-2);
                                                text-align:center;
                                                transition:var(--transition);
                                                cursor:pointer">
                                    <div style="font-size:22px;margin-bottom:4px">
                                        🏢
                                    </div>
                                    <div style="font-size:13px;font-weight:700;
                                                                color:var(--text-1)">
                                        Corporate
                                    </div>
                                    <div style="font-size:11px;color:var(--text-3)">
                                        Business account
                                    </div>
                                </div>
                            </label>
                        </div>
                    }
                    else
                    {
                        <div style="display:flex;align-items:center;gap:10px;
                                                        padding:12px;background:var(--surface-2);
                                                        border-radius:var(--r-sm)">
                            <span style="font-size:24px">
                                @(Model.AccountType == "Corporate" ? "🏢" : "👤")
                            </span>
                            <div>
                                <div style="font-size:14px;font-weight:700;
                                                                                color:var(--text-1)">
                                    @(Model.AccountType ?? "Individual")
                                </div>
                                <div style="font-size:11px;color:var(--text-3)">
                                    @(Model.AccountType == "Corporate" ? "Business account" : "Personal account")
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div id="corporateFields"
                 style="display:@(Model.AccountType == "Corporate" ? "block" : "none")">
                <div class="tp-card mb-3">
                    <div style="font-size:13px;font-weight:700;
                                color:var(--text-1);margin-bottom:14px">
                        <i class="bi bi-building"
                           style="color:var(--teal);margin-right:6px"></i>
                        Corporate Information
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    Company Name
                                </label>
                                @if (isEditMode)
                                {
                                    <input name="CompanyName"
                                           class="form-control"
                                           value="@Model.CompanyName"
                                           placeholder="Official company name" />
                                }
                                else
                                {
                                    <div class="form-control"
                                         style="background:var(--surface-2)">
                                        @(Model.CompanyName ?? "—")
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    Business Registration No.
                                </label>
                                @if (isEditMode)
                                {
                                    <input name="BusinessRegNumber"
                                           class="form-control"
                                           value="@Model.BusinessRegNumber"
                                           placeholder="e.g. LB-2024-XXXXX" />
                                }
                                else
                                {
                                    <div class="form-control"
                                         style="background:var(--surface-2)">
                                        @(Model.BusinessRegNumber ?? "—")
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tp-card mb-3">
                <div style="font-size:13px;font-weight:700;
                            color:var(--text-1);margin-bottom:14px">
                    <i class="bi bi-person-fill"
                       style="color:var(--teal);margin-right:6px"></i>
                    Personal Information
                    @if (isEditMode)
                    {
                        <span style="color:var(--red);font-size:11px;
                                        margin-left:6px">* Required</span>
                    }
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">
                                First Name
                                @if (isEditMode)
                                {
                                    <span style="color:var(--red)">*</span>
                                }
                            </label>
                            @if (isEditMode)
                            {
                                <input asp-for="FirstName"
                                       class="form-control"
                                       placeholder="First name" />
                                <span asp-validation-for="FirstName"
                                      class="text-danger"
                                      style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.FirstName ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Father's Name</label>
                            @if (isEditMode)
                            {
                                <input asp-for="FatherName"
                                       class="form-control"
                                       placeholder="Father's name" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.FatherName ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">
                                Last Name
                                @if (isEditMode)
                                {
                                    <span style="color:var(--red)">*</span>
                                }
                            </label>
                            @if (isEditMode)
                            {
                                <input asp-for="LastName"
                                       class="form-control"
                                       placeholder="Last name" />
                                <span asp-validation-for="LastName"
                                      class="text-danger"
                                      style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.LastName ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Mother's Name</label>
                            @if (isEditMode)
                            {
                                <input asp-for="MotherName"
                                       class="form-control"
                                       placeholder="Mother's full name" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.MotherName ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                Date of Birth
                                @if (isEditMode)
                                {
                                    <span style="color:var(--red)">*</span>
                                }
                            </label>
                            @if (isEditMode)
                            {
                                <input asp-for="DateOfBirth"
                                       class="form-control"
                                       type="date"
                                       max="@DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DateOfBirth" class="text-danger" style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.DateOfBirth.Year > 1 ? Model.DateOfBirth.ToString("MMM dd, yyyy") : "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Place of Birth</label>
                            @if (isEditMode)
                            {
                                <input asp-for="PlaceOfBirth"
                                       class="form-control"
                                       placeholder="City of birth" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.PlaceOfBirth ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">
                                Gender
                                @if (isEditMode)
                                {
                                    <span style="color:var(--red)">*</span>
                                }
                            </label>
                            @if (isEditMode)
                            {
                                <select asp-for="Gender" class="form-select">
                                    <option value="">— Select —</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Gender"
                                      class="text-danger"
                                      style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                        color:var(--text-1)">
                                    @(Model.Gender ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Marital Status</label>
                            @if (isEditMode)
                            {
                                <select asp-for="MaritalStatus"
                                        class="form-select">
                                    <option value="">— Select —</option>
                                    <option value="Single">Single</option>
                                    <option value="Married">Married</option>
                                    <option value="Divorced">Divorced</option>
                                    <option value="Widowed">Widowed</option>
                                </select>
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                        color:var(--text-1)">
                                    @(Model.MaritalStatus ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                Nationality
                                @if (isEditMode)
                                {
                                    <span style="color:var(--red)">*</span>
                                }
                            </label>
                            @if (isEditMode)
                            {
                                <input asp-for="Nationality"
                                       class="form-control"
                                       placeholder="e.g. Lebanese" />
                                <span asp-validation-for="Nationality"
                                      class="text-danger"
                                      style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                     color:var(--text-1)">
                                    @(Model.Nationality ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                Other Nationality
                            </label>
                            @if (isEditMode)
                            {
                                <input asp-for="OtherNationality"
                                       class="form-control"
                                       placeholder="If applicable" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                        color:var(--text-1)">
                                    @(Model.OtherNationality ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                Phone Number
                                @if (isEditMode)
                                {
                                    <span style="color:var(--red)">*</span>
                                }
                            </label>
                            @if (isEditMode)
                            {
                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       placeholder="+961 XX XXX XXX" />
                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger"
                                      style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                        color:var(--text-1)">
                                    @(Model.PhoneNumber ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Bio</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Description"
                                       class="form-control"
                                       placeholder="Short bio (optional)" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                     color:var(--text-1)">
                                    @(Model.Description ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="tp-card mb-3">
                <div style="font-size:13px;font-weight:700;
                            color:var(--text-1);margin-bottom:14px">
                    <i class="bi bi-journal-bookmark"
                       style="color:var(--teal);margin-right:6px"></i>
                    Civil Registry
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Record Number</label>
                            @if (isEditMode)
                            {
                                <input asp-for="RecordNumber"
                                       class="form-control"
                                       placeholder="Registry number" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.RecordNumber ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Governate</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Governate"
                                       class="form-control"
                                       placeholder="e.g. Beirut" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.Governate ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">District</label>
                            @if (isEditMode)
                            {
                                <input asp-for="District"
                                       class="form-control"
                                       placeholder="e.g. Metn" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.District ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Village</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Village"
                                       class="form-control"
                                       placeholder="Village of origin" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.Village ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="tp-card mb-3">
                <div style="font-size:13px;font-weight:700;
                            color:var(--text-1);margin-bottom:14px">
                    <i class="bi bi-geo-alt-fill"
                       style="color:var(--teal);margin-right:6px"></i>
                    Address
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                Country
                                @if (isEditMode)
                                {
                                    <span style="color:var(--red)">*</span>
                                }
                            </label>
                            @if (isEditMode)
                            {
                                <input asp-for="Country"
                                       class="form-control"
                                       placeholder="Lebanon" />
                                <span asp-validation-for="Country"
                                      class="text-danger"
                                      style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.Country ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                City
                                @if (isEditMode)
                                {
                                    <span style="color:var(--red)">*</span>
                                }
                            </label>
                            @if (isEditMode)
                            {
                                <input asp-for="City"
                                       class="form-control"
                                       placeholder="Beirut" />
                                <span asp-validation-for="City"
                                      class="text-danger"
                                      style="font-size:11px"></span>
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.City ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Region</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Region"
                                       class="form-control"
                                       placeholder="e.g. Hamra" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                    color:var(--text-1)">
                                    @(Model.Region ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">State</label>
                            @if (isEditMode)
                            {
                                <input asp-for="State"
                                       class="form-control"
                                       placeholder="State / Province" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                color:var(--text-1)">
                                    @(Model.State ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="form-group">
                            <label class="form-label">Street</label>
                            @if (isEditMode)
                            {
                                <input asp-for="Street"
                                       class="form-control"
                                       placeholder="Street name" />
                            }
                            else
                            {
                                <div class="form-control"
                                     style="background:var(--surface-2);
                                                color:var(--text-1)">
                                    @(Model.Street ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="form-label">Building</label>
                            @if (isEditMode)
                            {
                                <input asp-for="BuildingName"
                                       class="form-control"
                                       placeholder="Name" />
                            }
                            else
