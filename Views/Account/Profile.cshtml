            }

            @if (isEditMode)
            {
                <div class="tp-card mb-3">
                    <div style="display:flex;align-items:flex-start;
                                                        gap:10px;margin-bottom:16px">
                        <input type="checkbox" id="termsCheck"
                               @(Model.ProfileCompleted ? "checked" : "")
