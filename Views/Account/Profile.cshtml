                                </div>
                                <span class="badge-tp @(app.Status == MoneyTransfer.Models.ApplicationStatus.Approved
                                                            ? "success" : app.Status == MoneyTransfer.Models
                                                                .ApplicationStatus.Pending ? "warning" : "danger")">
                    @app.Status
                </span>
            </div>
                        }
                    </div>
                }
            }
        }
        else
        {
            @if (agentStatus == "Pending")
            {
                <div class="tp-card mb-3"
                     style="border:1px solid rgba(255,209,102,.3);
                                    background:var(--yellow-light)">
                    <div style="display:flex;align-items:center;
