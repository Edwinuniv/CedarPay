                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        Back of Document
                                    </label>
                                    @if (!string.IsNullOrEmpty(Model.BackImageUrl))
                                    {
                                        <div style="margin-bottom:8px">
                                            <img src="@Model.BackImageUrl"
                                                 style="height:60px;
                                                            border-radius:var(--r-sm);
                                                            object-fit:cover;
                                                            border:1px solid var(--border)" />
                                        </div>
                                    }
                                    <input type="file" name="backImage"
                                           class="form-control"
                                           accept="image/*" />
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(Model.FrontImageUrl))
                        {
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Front</label>
                                    <img src="@Model.FrontImageUrl"
                                         style="height:60px;
                                                border-radius:var(--r-sm);
                                                object-fit:cover;
                                                border:1px solid var(--border)" />
