                        </a>
                    }
                    else
                    {
                        <a asp-controller="Agent"
                           asp-action="Dashboard"
                           class="btn-tp-secondary"
                           style="white-space:nowrap">
                            Agent Dashboard →
                        </a>
                    }
                </div>
            </div>
        }
        else if (isAgentUser)
        {
            <div class="tp-card mb-3"
                 style="border:1px solid rgba(0,184,148,.2);
                            background:var(--teal-light)">
