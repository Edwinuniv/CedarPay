                           style="color:var(--teal);margin-right:6px"></i>
                        Identity Verification
                        @if (isEditMode)
                        {
                            <span style="color:var(--red);font-size:11px;
                                                    margin-left:6px">* Required</span>
                        }
                    </div>

                    @if (Model.KYCStatus == "Pending")
                    {
                        <div style="padding:10px 14px;background:var(--yellow-light);
                                                        border-radius:var(--r-sm);font-size:13px;
                                                        color:var(--yellow);margin-bottom:12px">
                            <i class="bi bi-clock"></i>
                            Your documents are under review.
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    Document Type
                                    @if (isEditMode)
                                    {
                                        <span style="color:var(--red)">*</span>
                                    }
                                </label>
                                @if (isEditMode)
                                {
                                    <select asp-for="DocumentType"
                                            class="form-select">
                                        <option value="NationalID">
                                            National ID
                                        </option>
                                        <option value="Passport">Passport</option>
                                        <option value="DriverLicense">
                                            Driver's License
                                        </option>
                                    </select>
                                }
                                else
                                {
                                    <div class="form-control"
                                         style="background:var(--surface-2);
                                                                 color:var(--text-1)">
                                        @Model.DocumentType
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    Document Number
