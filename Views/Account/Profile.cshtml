                                gap:12px">
                    <i class="bi bi-check-circle-fill"
                       style="color:var(--teal);
                                  font-size:24px;flex-shrink:0"></i>
                    <div style="flex:1">
                        <div style="font-size:14px;font-weight:700;
                                        color:var(--text-1)">
                            You are a CedarPay Agent ✓
                        </div>
                        <div style="font-size:13px;
                                        color:var(--text-2);
                                        margin-top:2px">
                            Your application was approved.
                            Access your agent tools below.
                        </div>
                    </div>
                    <a asp-controller="Agent"
                       asp-action="Dashboard"
                       class="btn-tp-primary"
                       style="white-space:nowrap;flex-shrink:0">
                        <i class="bi bi-speedometer2"></i>
                        Agent Dashboard
                    </a>
                </div>
            </div>

            @if (ViewBag.AgentApplicationHistory != null)
            {
                var history = ViewBag.AgentApplicationHistory
                as List<MoneyTransfer.Models.AgentApplication>;
                @if (history?.Any() == true)
                {
                    <div class="tp-card mb-3">
                        <div style="font-size:13px;font-weight:700;
                                                color:var(--text-1);
