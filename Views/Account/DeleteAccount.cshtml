@{
    ViewData["Title"] = "Delete Account";
    ViewBag.PageClass = "page-profile";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="page-header">
            <div>
                <h2>Delete Account</h2>
                <p>This action cannot be undone</p>
            </div>
            <a asp-action="Profile" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <div class="tp-card delete-warning-card">
            <div class="warning-content">
                <div class="warning-icon">
                    ⚠️
                </div>
                <div class="warning-title">
                    Are you sure you want to delete your account?
                </div>
                <div class="warning-message">
                    This will permanently delete your account,
                    all your wallets, transactions, and data.
                    <strong>This cannot be undone.</strong>
                </div>

                <form asp-action="ConfirmDeleteAccount"
                      method="post"
                      class="delete-form">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn-tp-danger delete-btn"
                            onclick="return confirm('Last chance — permanently delete your account?')">
                        <i class="bi bi-trash-fill"></i>
                        Yes, Delete My Account
                    </button>
                    <a asp-action="Profile"
                       class="btn-tp-secondary cancel-btn">
                        Cancel, Keep My Account
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>