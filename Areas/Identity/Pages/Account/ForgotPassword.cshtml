@page
@model MoneyTransfer.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewBag.PageClass = "page-dashboard";
}

<div class="forgot-password-container">
    <div class="forgot-password-card">

        <div class="forgot-password-header">
            <img src="/images/cedarpay-logo.png" alt="CedarPay" class="forgot-password-logo" />
            <h1 class="forgot-password-title">
                Cedar<span>Pay</span>
            </h1>
            <p class="forgot-password-subtitle">
                Reset your password
            </p>
        </div>

        <div class="forgot-password-form-container">

            <div class="text-center mb-3">
                <div class="forgot-password-icon-wrapper">
                    <i class="bi bi-key-fill forgot-password-icon"></i>
                </div>
                <div class="forgot-password-form-title">Forgot your password?</div>
                <div class="forgot-password-form-desc">
                    Enter your email and we'll send you a reset link.
                </div>
            </div>

            <form method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="forgot-password-validation-summary"
                     style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")">
                </div>

                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <input asp-for="Input.Email" class="form-control" type="email"
                           placeholder="name@example.com" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-danger validation-error"></span>
                </div>

                <button type="submit" class="btn-tp-primary forgot-password-submit-btn">
                    <i class="bi bi-envelope-fill"></i> Send Reset Link
                </button>
            </form>

            <div class="forgot-password-footer">
                Remember your password?
                <a asp-page="./Login" class="forgot-password-footer-link">Sign in</a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}