@page
@{
    ViewData["Title"] = "Check your email";
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewBag.PageClass = "page-dashboard";
}

<div class="forgot-confirm-container">
    <div class="forgot-confirm-card">

        <div class="forgot-confirm-header">
            <img src="/images/cedarpay-logo.png" alt="CedarPay" class="forgot-confirm-logo" />
            <h1 class="forgot-confirm-title">
                Cedar<span>Pay</span>
            </h1>
        </div>

        <div class="forgot-confirm-form-container">
            <div class="forgot-confirm-icon-wrapper">
                <i class="bi bi-envelope-check-fill forgot-confirm-icon"></i>
            </div>
            <div class="forgot-confirm-main-title">Check your inbox!</div>
            <div class="forgot-confirm-message">
                We sent a <strong>password reset link</strong> to your email address.<br />
                Click the link in the email to set a new password.<br />
                <span class="forgot-confirm-expiry">The link expires in 24 hours. Check your spam folder if you don't see it.</span>
            </div>

            <div class="forgot-confirm-steps">
                <div class="forgot-confirm-steps-title">📋 What to do:</div>
                <ol class="forgot-confirm-steps-list">
                    <li>Open your email inbox</li>
                    <li>Find the email from <strong>CedarPay</strong></li>
                    <li>Click <strong>"Reset Password"</strong></li>
                    <li>Enter your new password</li>
                </ol>
            </div>

            <a asp-page="./ForgotPassword" class="forgot-confirm-resend-btn">
                <i class="bi bi-arrow-counterclockwise"></i> Resend email
            </a>
            <div>
                <a asp-page="./Login" class="forgot-confirm-login-link">
                    <i class="bi bi-arrow-left"></i> Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .forgot-confirm-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg);
        padding: 20px;
    }

    .forgot-confirm-card {
        width: 100%;
        max-width: 420px;
    }

    .forgot-confirm-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .forgot-confirm-logo {
        width: 64px;
        height: 64px;
        object-fit: contain;
        margin: 0 auto 14px;
        display: block;
    }

    .forgot-confirm-title {
        font-size: 24px;
        font-weight: 800;
        color: var(--text-1);
        letter-spacing: -0.5px;
        margin: 0;
    }

        .forgot-confirm-title span {
            color: var(--teal);
        }

    .forgot-confirm-form-container {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        padding: 32px;
        box-shadow: var(--shadow-md);
        text-align: center;
    }

    .forgot-confirm-icon-wrapper {
        width: 64px;
        height: 64px;
        background: var(--teal-light);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

    .forgot-confirm-icon {
        font-size: 28px;
        color: var(--teal);
    }

    .forgot-confirm-main-title {
        font-size: 17px;
        font-weight: 800;
        color: var(--text-1);
        margin-bottom: 10px;
    }

    .forgot-confirm-message {
        font-size: 14px;
        color: var(--text-2);
        line-height: 1.7;
        margin-bottom: 20px;
    }

    .forgot-confirm-expiry {
        font-size: 12px;
        color: var(--text-3);
    }

    .forgot-confirm-steps {
        background: var(--surface-2);
        border-radius: var(--r-md);
        padding: 14px;
        font-size: 13px;
        color: var(--text-2);
        margin-bottom: 20px;
        text-align: left;
    }

    .forgot-confirm-steps-title {
        font-weight: 700;
        margin-bottom: 6px;
        color: var(--text-1);
    }

    .forgot-confirm-steps-list {
        margin: 0;
        padding-left: 18px;
        line-height: 2;
    }

    .forgot-confirm-resend-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 20px;
        background: var(--surface-2);
        border: 1px solid var(--border-md);
        border-radius: var(--r-sm);
        font-size: 13px;
        color: var(--text-1);
        text-decoration: none;
        margin-bottom: 10px;
    }

        .forgot-confirm-resend-btn:hover {
            background: var(--teal-light);
            border-color: var(--teal);
            color: var(--teal);
        }

    .forgot-confirm-login-link {
        font-size: 13px;
        color: var(--teal);
        font-weight: 600;
        text-decoration: none;
    }

        .forgot-confirm-login-link:hover {
            text-decoration: underline;
        }
    @@media (max-width: 768px) {
        .forgot-confirm-form-container

    {
        padding: 24px 20px;
    }

    .forgot-confirm-title {
        font-size: 20px;
    }

    }
</style>