@page
@{
    ViewData["Title"] = "Check your email";
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewBag.PageClass = "page-dashboard";
}

<div class="forgot-confirm-container">
    <div class="forgot-confirm-card">

        <div class="forgot-confirm-header">
            <img src="/images/cedarpay-logo.png" alt="CedarPay" class="forgot-confirm-logo" />
            <h1 class="forgot-confirm-title">
                Cedar<span>Pay</span>
            </h1>
        </div>

        <div class="forgot-confirm-form-container">
            <div class="forgot-confirm-icon-wrapper">
                <i class="bi bi-envelope-check-fill forgot-confirm-icon"></i>
            </div>
            <div class="forgot-confirm-main-title">Check your inbox!</div>
            <div class="forgot-confirm-message">
                We sent a <strong>password reset link</strong> to your email address.<br />
                Click the link in the email to set a new password.<br />
                <span class="forgot-confirm-expiry">The link expires in 24 hours. Check your spam folder if you don't see it.</span>
            </div>

            <div class="forgot-confirm-steps">
                <div class="forgot-confirm-steps-title">📋 What to do:</div>
                <ol class="forgot-confirm-steps-list">
                    <li>Open your email inbox</li>
                    <li>Find the email from <strong>CedarPay</strong></li>
                    <li>Click <strong>"Reset Password"</strong></li>
                    <li>Enter your new password</li>
                </ol>
            </div>

            <a asp-page="./ForgotPassword" class="forgot-confirm-resend-btn">
                <i class="bi bi-arrow-counterclockwise"></i> Resend email
            </a>
            <div>
                <a asp-page="./Login" class="forgot-confirm-login-link">
                    <i class="bi bi-arrow-left"></i> Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>