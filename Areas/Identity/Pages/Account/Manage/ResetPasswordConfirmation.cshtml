@page
@{
    ViewData["Title"] = "Password Reset Confirmation";
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewBag.PageClass = "page-dashboard";
}

<div class="reset-confirm-container">
    <div class="reset-confirm-card">
        <div class="reset-confirm-icon">✅</div>
        <h1 class="reset-confirm-title">Password Reset Complete!</h1>
        <p class="reset-confirm-message">
            Your password has been successfully reset. You can now log in with your new password.
        </p>
        <div class="reset-confirm-actions">
            <a asp-page="./Login" class="btn-tp-primary">
                <i class="bi bi-box-arrow-in-right"></i> Go to Login
            </a>
        </div>
        <div class="reset-confirm-footer">
            <i class="bi bi-tree-fill"></i>
            <span>CedarPay — Secure Digital Wallet</span>
        </div>
    </div>
</div>

<style>
    .reset-confirm-container {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .reset-confirm-card {
        max-width: 500px;
        width: 100%;
        text-align: center;
        padding: 48px 32px;
        background: var(--surface);
        border-radius: var(--r-xl);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-md);
    }

    .reset-confirm-icon {
        font-size: 64px;
        margin-bottom: 16px;
    }

    .reset-confirm-title {
        font-size: 24px;
        font-weight: 800;
        color: var(--text-1);
        margin-bottom: 12px;
    }

    .reset-confirm-message {
        font-size: 14px;
        color: var(--text-2);
        margin-bottom: 24px;
        line-height: 1.6;
    }

    .reset-confirm-actions {
        margin-bottom: 24px;
    }

    .reset-confirm-footer {
        font-size: 12px;
        color: var(--text-3);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
    }

        .reset-confirm-footer i {
            color: var(--teal);
        }

    @@media (max-width: 768px) {
        .reset-confirm-card

    {
        padding: 32px 20px;
    }

    .reset-confirm-title {
        font-size: 20px;
    }

    }
</style>