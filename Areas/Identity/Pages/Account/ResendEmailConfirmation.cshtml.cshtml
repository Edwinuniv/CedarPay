@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend Email Confirmation";
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewBag.PageClass = "page-dashboard";
}

<div class="confirm-email-container">
    <div class="confirm-email-card">
        <div class="confirm-email-icon">📧</div>
        <h1 class="confirm-email-title">Resend Confirmation</h1>
        <p class="confirm-email-message">Enter your email to receive a new confirmation link.</p>

        <form method="post" style="margin-top:20px;">
            <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px;font-size:13px;"></div>

            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input asp-for="Input.Email" class="form-control" type="email" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger validation-error"></span>
            </div>

            <button type="submit" class="btn-tp-primary" style="width:100%;margin-top:12px;">
                <i class="bi bi-envelope-fill"></i> Resend
            </button>
        </form>

        <div class="confirm-email-actions" style="margin-top:20px;text-align:center;">
            <a asp-page="./Login" class="btn-tp-secondary">
                <i class="bi bi-arrow-left"></i> Back to Login
            </a>
        </div>

        <div class="confirm-email-footer" style="margin-top:20px;text-align:center;color:#aaa;">
            <i class="bi bi-tree-fill"></i>
            <span>CedarPay — Secure Digital Wallet</span>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}