@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewBag.PageClass = "page-dashboard";
}

<div class="login-container">
    <div class="login-card">

        <div class="login-header">
            <img src="/images/cedarpay-logo.png" alt="CedarPay" class="login-logo" />
            <h1 class="login-title">
                Cedar<span>Pay</span>
            </h1>
            <p class="login-subtitle">
                Sign in to your account
            </p>
        </div>

        <div class="login-form-container">

            @if (Model.ExternalLogins?.Any() == true)
            {
                <div class="login-external-section">
                    <div class="login-external-title">Sign in with</div>

                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <form id="external-account" asp-page="./ExternalLogin"
                              asp-route-returnUrl="@Model.ReturnUrl"
                              method="post">
                            <button type="submit" name="provider" value="@provider.Name" class="login-external-btn">
                                @if (provider.Name == "Google")
                                {
                                    <svg width="18" height="18" viewBox="0 0 24 24">
                                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                                    </svg>
                                }
                                Sign in with @provider.Name
                            </button>
                        </form>
                    }
                    <div class="login-divider">
                        <div class="login-divider-line"></div>
                        <span class="login-divider-text">or with email</span>
                        <div class="login-divider-line"></div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="login-error-message">
                    <i class="bi bi-exclamation-circle-fill"></i> @Model.ErrorMessage
                </div>
            }

            <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="login-validation-summary"
                     style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")">
                </div>

                <div class="login-form-fields">
                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <input asp-for="Input.Email" class="form-control" type="email"
                               placeholder="name@example.com" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger validation-error"></span>
                    </div>

                    <div class="form-group">
                        <div class="login-password-header">
                            <label class="form-label" style="margin:0">Password</label>
                            <a asp-page="./ForgotPassword" class="login-forgot-link">
                                Forgot password?
                            </a>
                        </div>
                        <div class="login-password-wrapper">
                            <input asp-for="Input.Password" class="form-control" type="password"
                                   id="loginPwd" placeholder="Your password" autocomplete="current-password" />
                            <button type="button" onclick="togglePwd()" class="login-password-toggle">
                                <i class="bi bi-eye" id="pwdEye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger validation-error"></span>
                    </div>

                    <label class="login-remember-label">
                        <input asp-for="Input.RememberMe" type="checkbox" class="login-remember-checkbox" />
                        Remember me for 30 days
                    </label>

                    <button type="submit" class="btn-tp-primary login-submit-btn">
                        Sign In →
                    </button>
                </div>
            </form>

            <div class="login-register-section">
                Don't have an account?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="login-register-link">
                    Create one
                </a>
            </div>
        </div>

        <div class="login-footer">
            🌲 CedarPay — Send Money. Support Home.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd() {
            const i = document.getElementById('loginPwd');
            const e = document.getElementById('pwdEye');
            i.type = i.type === 'password' ? 'text' : 'password';
            e.className = i.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        }
    </script>
}